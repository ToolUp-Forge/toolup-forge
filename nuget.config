<?xml version="1.0" encoding="utf-8"?>
<!--
  Dual-source steady state:

  - `nuget.org` is the upstream public package mirror.
  - `local` (`../../local-nuget-feed`) is the single workspace-root local feed used for cross-repo
    iteration. `dotnet run :: Pack` writes one nupkg per
    `<IsPackable>true</IsPackable>` project directly into the local
    feed; a consumer's nuget.config can reference the same folder, so
    a fresh pack is immediately consumable downstream with no intermediate
    "move nupkgs" step. Forward slash is portable (Windows accepts it
    natively); backslash trips NuGet's relative-path resolver on Linux
    runners because `..\` is treated as a literal filename segment
    rather than parent-traversal.
  - Steady-state public distribution lives on the `toolup-forge` GitHub
    Packages cloud feed (`https://nuget.pkg.github.com/ToolUp-Forge/`),
    published by the `publish-nuget.yml` GitHub Actions workflow on tag
    `v*.*.*`. Consumers add the cloud source to their own `nuget.config`;
    the local feed stays in their config too as a higher-priority
    iteration override.

  forge itself does NOT need the cloud feed in this file — forge consumes
  ToolUp.* only through ProjectReference, never PackageReference — but
  the cloud feed is documented here so the file serves as one orientation
  point for "where the SDK packages live".
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="../../local-nuget-feed" />
  </packageSources>
</configuration>
