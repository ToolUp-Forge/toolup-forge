# Pin canonical text-file line endings to LF.
#
# `text=auto` lets git detect text vs. binary; `eol=lf` pins the
# canonical in-repo line ending. On a Windows checkout, files stay LF
# on disk (no autocrlf round-trip churn), eliminating the recurring
# "LF will be replaced by CRLF the next time Git touches it" warnings
# and phantom "modified" churn on tool-regenerated files.

* text=auto eol=lf

# Explicit binary types — git's auto-detection is usually correct
# but spell out the common ones to be safe.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.nupkg binary
*.snupkg binary
*.zip   binary
*.tar   binary
*.gz    binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Phase 784 — the remoting wire corpus's pinned MsgPack encodings. NOT left to
# auto-detection: a short fixture can contain no NUL byte at all (`primitive-string`
# is `a5 68 65 6c 6c 6f`), so git would classify it as TEXT and the `eol=lf` rule
# above would rewrite any 0x0d 0x0a pair inside a payload. That is a silent
# one-byte corruption of a file whose whole purpose is to be byte-exact.
*.msgpack binary
