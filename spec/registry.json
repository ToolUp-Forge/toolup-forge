{
  "specification": "app-composition-wire",
  "coreVersion": 1,
  "profile": "server-app-host",
  "profileVersion": "7.0",
  "note": "The machine-readable rendering of composition-profile.md sections P2, P3 and P8. Normative; the composition-profile surface check in this repository compares the two renderings and fails when they disagree. Counts appear nowhere: this file is the enumeration.",
  "tokens": {
    "appRoot.base": {
      "closure": "closed",
      "tokens": ["serverApp", "publicRenderingServerApp"]
    },
    "appRoot.layers": {
      "closure": "closed",
      "tokens": ["ai", "rag", "forms", "peer", "extensions", "knowledgeBase", "publicRendering"]
    },
    "companionSelection.slot": {
      "closure": "closed",
      "tokens": [
        "aiProvider",
        "embeddingProvider",
        "blobStorage",
        "authProvider",
        "notificationChannel",
        "vectorStore",
        "secretStore",
        "auditSink",
        "metricsSink",
        "jobScheduler",
        "dataSource",
        "transactionalSink"
      ]
    },
    "moduleRef.view": {
      "closure": "closed",
      "tokens": ["bareFeliz", "fuaranUI", "custom"],
      "citationBearing": ["fuaranUI"]
    },
    "configKnob.key": {
      "closure": "open",
      "unregisteredMeaning": "a setting this profile does not shape composition on; legitimate, never refused, preserved exactly",
      "registered": {
        "ProcessProfile": { "grammar": "enum", "values": ["AllInOne", "WebOnly", "WorkerOnly"] },
        "ConfigDriftDetection": { "grammar": "enum", "values": ["NoConfigDriftDetection", "EnabledConfigDriftDetection"] },
        "JobScheduler": { "grammar": "enum", "values": ["NoJobScheduler", "InProcessJobScheduler"] },
        "PeerSubstrate": { "grammar": "enum", "values": ["NoPeerSubstrate", "EnabledPeerSubstrate"] },
        "FactStore": { "grammar": "enum", "values": ["NoFactStore", "EnabledFactStore"] },
        "FactStoreBackend": { "grammar": "enum", "values": ["Blob", "Postgres"] },
        "AuditLog": { "grammar": "enum", "values": ["NoAuditLog", "EnabledAuditLog"] },
        "ShareTokenStore": { "grammar": "enum", "values": ["NoShareTokenStore", "EnabledShareTokenStore"] },
        "TeamCreationPolicy": { "grammar": "enum", "values": ["PlatformAdminOnly", "AnyAuthenticatedUser"] },
        "EventStore": { "grammar": "retention" },
        "IncludePlatformDefaults": { "grammar": "boolean" },
        "PublicBaseUrl": { "grammar": "origin" },
        "DataIngestion": { "grammar": "enum", "values": ["NoDataIngestion", "EnabledDataIngestion"] },
        "DataSubjectRequests": { "grammar": "enum", "values": ["Disabled", "sync:HardDelete", "sync:Tombstone", "sync:RetainPerCompliance"] },
        "EncryptedBlobStorage": { "grammar": "enum", "values": ["NoEncryptedBlobStorage", "SingleKeyResolver"] }
      },
      "valueGrammars": {
        "enum": { "note": "exactly one of the entry's own values; the entry lists them, its default first" },
        "retention": {
          "literals": ["InMemoryOnly", "unlimited", "ninetyDays"],
          "parameterised": [
            { "prefix": "byAge:", "suffix": "d", "max": 10675199 },
            { "prefix": "byCount:", "suffix": "", "max": 2147483647 }
          ]
        },
        "boolean": { "literals": ["true", "false"] },
        "origin": { "schemes": ["http", "https"], "defaultPorts": { "http": 80, "https": 443 } }
      }
    },
    "moduleRef.factTables.grain": {
      "closure": "closed",
      "tokens": ["day", "week", "month", "quarter", "year", "snapshot"]
    },
    "moduleRef.factTables.definition.columns.shape": {
      "closure": "closed",
      "tokens": ["scalar", "interval", "distribution", "categorical", "series"]
    },
    "moduleRef.factTables.definition.historyMode": {
      "closure": "closed",
      "tokens": ["appendByRun", "replace"]
    },
    "moduleRef.factTables.definition.disclosure.class": {
      "closure": "closed",
      "tokens": ["surfaceable", "internal", "restricted"],
      "takesArgument": ["restricted"]
    },
    "moduleRef.factTables.definition.requirement": {
      "closure": "closed",
      "tokens": ["required", "optional"]
    },
    "moduleRef.metricDefinitions.direction": {
      "closure": "closed",
      "tokens": ["higherIsBetter", "lowerIsBetter", "neutral"]
    },
    "moduleRef.metricDefinitions.staleness.policy": {
      "closure": "closed",
      "tokens": ["freshFor", "untilSuperseded", "untilUpstreamChange"],
      "takesArgument": ["freshFor"]
    },
    "moduleRef.metricDefinitions.recomputePolicy": {
      "closure": "closed",
      "tokens": ["eager", "onQuery", "manual"]
    },
    "moduleRef.metricDefinitions.rollUp.kind": {
      "closure": "closed",
      "tokens": ["additive", "nonAdditive"],
      "takesArgument": ["additive"]
    },
    "pageRef.audience": {
      "closure": "closed",
      "tokens": ["public", "authenticated", "scope", "client", "publication"],
      "gated": ["authenticated", "scope", "client", "publication"]
    },
    "groundedNarrative.surface": {
      "closure": "closed",
      "tokens": [
        "retrieval",
        "toolResult",
        "narrativePublication",
        "export",
        "webhook",
        "peerEgress",
        "browse",
        "teamPublication"
      ]
    },
    "aiFunding.policy": {
      "closure": "closed",
      "tokens": ["platformOnly", "permissiveWithPlatformFallback", "strictBYOK"]
    },
    "pageRef.captures": {
      "closure": "closed",
      "tokens": ["date", "slug", "int"]
    },
    "referenceData.columns.type": {
      "closure": "closed",
      "tokens": ["date", "integer", "text"]
    },
    "moduleRef.entities.disclosure.class": {
      "closure": "closed",
      "tokens": ["surfaceable", "internal", "restricted"],
      "takesArgument": ["restricted"]
    },
    "moduleRef.entities.fields.level": {
      "closure": "closed",
      "tokens": ["public", "confidential", "financial", "regulatory", "pii", "spi"]
    },
    "moduleRef.aiExposure": {
      "closure": "closed",
      "tokens": ["notQueryable", "queryable"]
    },
    "dataDelivery.mode": {
      "closure": "closed",
      "tokens": ["upload", "scheduledPull", "watched"]
    },
    "moduleRef.disclosurePolicies.mode": {
      "closure": "closed",
      "tokens": ["plain", "taintPropagating"]
    },
    "moduleRef.disclosurePolicies.permitSurfaces": {
      "closure": "closed",
      "tokens": ["retrieval", "toolResult", "narrativePublication", "export", "webhook", "peerEgress", "browse", "teamPublication"]
    },
    "reportTemplate.format": {
      "closure": "closed",
      "tokens": ["markdown", "html", "pdf", "docx", "xlsx"]
    },
    "standingSubscription.format": {
      "closure": "closed",
      "tokens": ["markdown", "html", "pdf", "docx", "xlsx"]
    },
    "reportTemplate.placeholders.kind": {
      "closure": "closed",
      "tokens": ["text", "number", "date", "image", "table"]
    },
    "reportTemplate.placeholders.columns.kind": {
      "closure": "closed",
      "tokens": ["text", "number", "date", "image"]
    },
    "factBrowse.mount": {
      "closure": "closed",
      "tokens": ["serverOnly"]
    }
  },
  "nodeKinds": {
    "clientShell": {
      "members": [
        { "name": "home", "type": "array of home entry objects", "presence": "optional; absent when the shell declares none, never empty" }
      ],
      "leaf": true
    },
    "layoutRef": {
      "members": [
        { "name": "name", "type": "string", "presence": "required" },
        { "name": "view", "type": "token", "presence": "optional; fuaranUI when present" },
        { "name": "viewSpec", "type": "citation", "presence": "per moduleRef.view, when view is present" }
      ],
      "leaf": false
    },
    "pageRef": {
      "members": [
        { "name": "route", "type": "string", "presence": "required" },
        { "name": "audience", "type": "token", "presence": "required" },
        { "name": "roles", "type": "array of string", "presence": "required when audience is scope; absent otherwise" },
        { "name": "relationship", "type": "string", "presence": "required when audience is client; absent otherwise" },
        { "name": "readers", "type": "array of string", "presence": "required when audience is publication; absent otherwise" },
        { "name": "publishingScope", "type": "string", "presence": "required when audience is publication; absent otherwise" },
        { "name": "view", "type": "token", "presence": "required" },
        { "name": "viewSpec", "type": "citation", "presence": "per moduleRef.view" },
        { "name": "title", "type": "string", "presence": "optional" },
        { "name": "layout", "type": "string", "presence": "optional" },
        { "name": "captures", "type": "object of token", "presence": "optional; non-empty when present" }
      ],
      "leaf": false
    },
    "groundedNarrative": {
      "members": [
        { "name": "displayName", "type": "string", "presence": "required" },
        { "name": "moduleId", "type": "string", "presence": "required" },
        { "name": "pageRoute", "type": "string", "presence": "optional" },
        { "name": "principal", "type": "string", "presence": "required" },
        { "name": "title", "type": "string", "presence": "required" },
        { "name": "prompt", "type": "string", "presence": "required" },
        { "name": "dependsOnMetrics", "type": "array of string", "presence": "required; may be empty" },
        { "name": "sections", "type": "array of section objects", "presence": "required" },
        { "name": "allowsConjecture", "type": "boolean string", "presence": "optional; omitted when false" },
        { "name": "tags", "type": "array of string", "presence": "required; may be empty" },
        { "name": "surface", "type": "token", "presence": "required" },
        { "name": "onCommit", "type": "array of string", "presence": "required; may be empty" },
        { "name": "page", "type": "string", "presence": "optional" },
        { "name": "cadence", "type": "string", "presence": "optional" },
        { "name": "runsAs", "type": "string", "presence": "optional" }
