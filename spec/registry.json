    "aiFunding": {
      "members": [
        { "name": "policy", "type": "token", "presence": "required" },
        { "name": "keyEnv", "type": "string", "presence": "optional" }
      ],
      "parentSlot": "aiProvider",
      "leaf": true
    },
    "referenceData": {
      "members": [
        { "name": "source", "type": "string", "presence": "required" },
        { "name": "contentHash", "type": "string", "presence": "required" },
        { "name": "columns", "type": "array of column objects", "presence": "required; non-empty" }
      ],
      "leaf": true
    },
    "dataDelivery": {
      "members": [
        { "name": "source", "type": "string", "presence": "required" },
        { "name": "mode", "type": "profile token", "presence": "required" },
        { "name": "module", "type": "string", "presence": "optional" },
        { "name": "principal", "type": "string", "presence": "optional" },
        { "name": "cadence", "type": "string", "presence": "optional" },
        { "name": "location", "type": "string", "presence": "optional" },
        { "name": "tables", "type": "array of string", "presence": "optional; non-empty when present" }
      ],
      "leaf": true
    },
    "entityReads": {
      "members": [
        { "name": "reads", "type": "array of edge objects", "presence": "required; may be empty" }
      ],
      "parentSlots": ["vectorStore", "embeddingProvider"],
      "leaf": true
    },
    "reportTemplate": {
      "members": [
        { "name": "displayName", "type": "string", "presence": "required" },
        { "name": "format", "type": "profile token", "presence": "required" },
        { "name": "body", "type": "string", "presence": "required for a text body; absent for a binary one" },
        { "name": "source", "type": "string", "presence": "required for a binary body; absent for a text one" },
        { "name": "contentHash", "type": "string", "presence": "required for a binary body; absent for a text one" },
        { "name": "placeholders", "type": "array of placeholder objects", "presence": "required; may be empty" }
      ],
      "leaf": true
    },
    "reportProducer": {
      "members": [
        { "name": "displayName", "type": "string", "presence": "required" },
        { "name": "narrative", "type": "string", "presence": "required" },
        { "name": "template", "type": "string", "presence": "required" },
        { "name": "placeholder", "type": "string", "presence": "required" }
      ],
      "leaf": true
    },
    "subscriptionPrincipal": {
      "members": [
        { "name": "userId", "type": "string", "presence": "required" },
        { "name": "displayName", "type": "string", "presence": "required" }
      ],
      "leaf": true
    },
    "standingSubscription": {
      "members": [
        { "name": "displayName", "type": "string", "presence": "required" },
        { "name": "producer", "type": "string", "presence": "required" },
        { "name": "template", "type": "string", "presence": "required" },
        { "name": "parameters", "type": "array of parameter objects", "presence": "optional; non-empty when present" },
        { "name": "schedule", "type": "string", "presence": "required" },
        { "name": "principal", "type": "string", "presence": "required" },
        { "name": "recipients", "type": "array of string", "presence": "required; may be empty" },
        { "name": "format", "type": "profile token", "presence": "required" }
      ],
      "leaf": true
    },
    "factBrowse": {
      "members": [
        { "name": "mount", "type": "profile token", "presence": "optional" },
        { "name": "label", "type": "string", "presence": "optional; absent under serverOnly" },
        { "name": "group", "type": "string", "presence": "optional; absent under serverOnly" }
      ],
      "leaf": true
    },
    "theme": {
      "members": [
        { "name": "source", "type": "string", "presence": "required" },
        { "name": "contentHash", "type": "string", "presence": "required" }
      ],
      "leaf": true
    },
    "uiControl": {
      "members": [
        { "name": "fastPath", "type": "boolean string", "presence": "required" },
        { "name": "triage", "type": "boolean string", "presence": "optional; omitted when false" },
        { "name": "triageProvider", "type": "string", "presence": "optional; only beside triage" },
        { "name": "caseBase", "type": "boolean string", "presence": "optional; omitted when false" },
        { "name": "voice", "type": "boolean string", "presence": "optional; omitted when false" },
        { "name": "allow", "type": "array of allow entry objects", "presence": "required; never empty" }
      ],
      "leaf": true
    }
