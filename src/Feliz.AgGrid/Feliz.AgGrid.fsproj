<?xml version="1.0" encoding="utf-8"?>
<!--
    Feliz.AgGrid — standalone Feliz bindings for AG Grid Community.

    Phase 344 lifted `AgGrid.fs` out of ToolUp.Platform.Client, where it
    had lived as `module ToolUp.Platform.AgGrid`. The audit behind that
    phase found the binding opens only Fable.Core / Fable.Core.JsInterop /
    Feliz — zero platform-internal references — so it is a domain-agnostic
    Feliz wrapper that no SDK consumer should have to drag in order to
    render something that is not a grid.

    The package is Apache-2.0 and carries no AG Grid licence of any kind:
    it binds the Community distribution, and a deployment that wants the
    Enterprise feature set adds `Feliz.AgGrid.Enterprise` plus its own
    AG Grid Enterprise licence key.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Feliz.AgGrid</PackageId>
    <AssemblyName>Feliz.AgGrid</AssemblyName>
    <RootNamespace>Feliz.AgGrid</RootNamespace>
    <Description>Feliz bindings for AG Grid Community — typed column definitions, grid props, the grid API surface, the Theming API, and the AgGridProvider module-registration shape. Fable-first: the source packs under fable/ so a Fable consumer compiles it directly.</Description>
    <PackageTags>fsharp;fable;feliz;react;ag-grid;datagrid;bindings</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AgGrid.fs" />
    <Content Include="package.json" />
  </ItemGroup>
  <!-- Client-tier closure: pack source for Fable consumers under fable/.
       The library's own .fsproj + .fs files ship inside the nupkg; Fable's
       package loader extracts and compiles source directly. Mirrors the
       Feliz / Fable.Elmish convention. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Feliz" />
  </ItemGroup>
</Project>
