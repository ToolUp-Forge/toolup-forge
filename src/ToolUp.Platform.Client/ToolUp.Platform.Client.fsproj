<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Platform Client — Fable + Elmish + Feliz client surface: shell MVU, sidebar navigation, UIToolkit, AgChart / AgGrid bindings, AuthUIProvider, Clerk auth components. Depends on ToolUp.Platform.Core.</Description>
        <PackageTags>fsharp;fable;feliz;elmish;sdk;client</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    </ItemGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
         under fable/. The library's own .fsproj + .fs files ship inside
         the nupkg; Fable's package loader extracts and compiles source
         directly. Mirrors the Feliz / Fable.Elmish convention. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs;**\*.svg;**\*.png" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.Platform\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <!-- 0.4.3 — Elmish runtime folded in from the formerly-separate
             ToolUp.Elmish / ToolUp.Elmish.React / ToolUp.Elmish.HMR
             packages. The runtime is a forge implementation detail
             rather than a separately consumable concern; one package
             instead of three, one version line instead of three. The
             `namespace Elmish` is preserved so every `open Elmish` site
             across forge and downstream consumers continues to compile
             unchanged. Compile order matches the prior cross-package
             dependency order (core → React → HMR). -->
        <!-- 0.4.4 — ToolUp.Remoting.Client folded in. The Fable-side
             RPC proxy + transport. Compiled BEFORE Elmish so
             Cmd.OfRemoting in the folded Elmish source can reference
             the Remoting types. -->
        <Compile Include="Client\Remoting\Types.fs" />
        <Compile Include="Client\Remoting\Extensions.fs" />
        <Compile Include="Client\Remoting\Http.fs" />
        <Compile Include="Client\Remoting\Proxy.fs" />
        <Compile Include="Client\Remoting\Remoting.fs" />
        <Compile Include="Client\Elmish\Prelude.fs" />
        <Compile Include="Client\Elmish\Cmd.fs" />
        <Compile Include="Client\Elmish\Sub.fs" />
        <Compile Include="Client\Elmish\Dispatcher.fs" />
        <Compile Include="Client\Elmish\Prefetch.fs" />
        <Compile Include="Client\Elmish\ErrorContext.fs" />
        <Compile Include="Client\Elmish\EffectHandle.fs" />
        <Compile Include="Client\Elmish\Ring.fs" />
        <Compile Include="Client\Elmish\Program.fs" />
        <Compile Include="Client\Elmish\React.fs" />
        <Compile Include="Client\Elmish\HMR.fs" />
        <Compile Include="Client\Api.fs" />
        <Compile Include="Client\Icon.fs" />
        <!-- Phase 65 — client-tier default ILogger (ConsoleLogger) +
             Logger module helpers. Foundational utility consumed by
             downstream client files; placed early so every later
             compile unit can declare `let log = Logger.forCategory`. -->
        <Compile Include="Client\Logger.fs" />
        <Compile Include="Client\UI\AgChart.fs" />
        <Compile Include="Client\UI\AgGrid.fs" />
        <Compile Include="Client\UI\AgGrid.Enterprise.fs" />
        <Compile Include="Client\SidebarPreferences.fs" />
        <Compile Include="Client\UI\Sidebar.fs" />
        <Compile Include="Client\UI\SvgProp.fs" />
        <!-- v0.5.0 — DataProp + AriaProp typed helpers. Same shape /
             rationale as SvgProp.fs: wrap `prop.custom` with a typed
             entry per attribute so the call-site advertises intent
             and a future audit can ratchet against raw
             `prop.custom ("data-*"|"aria-*"|"role", _)` shapes
             (see `DomAttrCustomAuditTests.fs`). React preserves
             `data-*` / `aria-*` / `role` verbatim today via a
             hardcoded exception; these helpers insulate against any
             future React tightening + give a single seam to audit. -->
        <Compile Include="Client\UI\DataProp.fs" />
        <Compile Include="Client\UI\AriaProp.fs" />
        <Compile Include="Client\IAuthBridge.fs" />
        <!-- Pure no-active-team landing config + gate-target precedence.
             Ahead of SDK.ClientTypes so the precedence helper carries no
             AgGrid / Icons / ClientConfig.defaults startup deps and stays
             .NET-testable; the Feliz factory is NoActiveTeamLandingUI.fs. -->
        <Compile Include="Client\NoActiveTeamLanding.fs" />
        <Compile Include="Client\SDK.ClientTypes.fs" />
        <!-- Phase 55 — `withGroup` requirement preflight. Pure decision +
             failwithf wrapper used by Client.boot to refuse deployments
             whose consumer modules are entirely ungrouped (the empty-
             sidebar shape `_other` collapses to). Sits adjacent to
             SDK.ClientTypes.fs since it only depends on ErasedModule. -->
        <Compile Include="Client\ModuleGroupingValidator.fs" />
        <!-- Phase 11.G — Vite-injected constants surfaced as a single SDK
             helper; ClientConfig builder consumes them via overrides record. -->
        <Compile Include="Client\BundleConstants.fs" />
        <Compile Include="Client\ClientConfigFromBundleConstants.fs" />
        <Compile Include="Client\Icons.fs" />
        <Compile Include="Client\UI\Toolkit\OutputFormatting.fs" />
        <Compile Include="Client\UI\Toolkit\Tokens.fs" />
        <Compile Include="Client\UI\Toolkit\Typography.fs" />
        <Compile Include="Client\UI\Toolkit\Layout.fs" />
        <Compile Include="Client\UI\Toolkit\Forms.fs" />
        <Compile Include="Client\UI\Toolkit\Data.fs" />
        <Compile Include="Client\UI\Toolkit\StateViews.fs" />
        <Compile Include="Client\UI\Toolkit\Kpi.fs" />
        <Compile Include="Client\NarrativeCommit.fs" />
        <Compile Include="Client\NarrativeRenderer.fs" />
        <Compile Include="Client\Markdown.fs" />
        <!-- Auth-observability A4 — generic client-side auth tracer (lifted
             from the OIDC provider's AuthTracer so every auth-relevant
             code path can emit through the same seam). Module-scoped
             mutable tracer slot; default nullTracer; build-time gated
             via __TOOLUP_AUTH_TRACE__ Vite define. -->
        <Compile Include="Client\AuthDiagnostics.fs" />
        <Compile Include="Client\CsrfClient.fs" />
        <!-- 0.4.1 — Cmd.OfRemoting.IRemotingInterceptor bridge. Parses
             ToolUp.Remoting's Phase 69b.E CategorisedErrorResult envelope
             into a typed RemotingCategorisedException + ErrorCategory DU
             so downstream ofError handlers can pattern-match without
             reading message strings. Registered at boot from
             SDK.Client.installRequestSeam. -->
        <Compile Include="Client\RemotingInterceptors.fs" />
        <Compile Include="Client\UserSession.fs" />
        <!-- Phase 241 — presence client hook (heartbeat + roster). -->
        <Compile Include="Client\PresenceClient.fs" />
        <!-- Phase 442 — presence + soft-lock React context: declarative
             "who's here" / "is this locked" reads + the acquire-on-edit /
             release-on-blur auto-renew helper hook. Mirrors
             ProcessedDataContext / LoadingIndicatorContext. -->
        <Compile Include="Client\PresenceContext.fs" />
        <Compile Include="Client\NotificationClient.fs" />
        <Compile Include="Client\ModuleQueryClient.fs" />
        <Compile Include="Client\ModuleStateObserver.fs" />
        <Compile Include="Client\NavigationRequest.fs" />
        <!-- Phase 102–107 tail — brokers the "view original" affordance
             from the AI Sources panel to the KnowledgeBase companion's
             GetOriginalDocument surface without a compile-time edge
             between the two (mirrors NarrativeCommit's reverse direction). -->
        <Compile Include="Client\OriginalDocumentBridge.fs" />
        <!-- Phase 110 — host-neutral client tree-hosting seam: the
             ClientHostCapabilities bag (Navigate / Call / Notify /
             Dispatch) an external typed-tree UI runtime binds against,
             plus the ClientHostView.withElementView builder step. After
             NavigationRequest / NotificationClient / UserSession (the
             shipped concretes it re-exposes) and SDK.ClientTypes (the
             ClientModule builder it extends). -->
        <Compile Include="Client\ClientHostBridge.fs" />
        <!-- Phase 268 — client-tier host-render telemetry: the forwarding
             default over the console ILogger, the Phase 270 onMismatch
             bridge onto the sink, and the CountingHostRenderTelemetrySink
             for the boot-degradation / health surface. After ClientHostBridge
             (references HostCapabilityMismatch) + Logger; the contract itself
             lives in Core (HostRenderFault.fs). -->
        <Compile Include="Client\HostRenderTelemetry.fs" />
        <!-- Phase 264 — host-state projection read-side (CSR):
             IHostStateProjection + ClientBoundHostView.withBoundElementView,
             the data-binding complement to Phase 110's action seam. After
             ClientHostBridge (it extends withElementView's shape) and the
             Core HostBindingSources type. -->
        <Compile Include="Client\HostStateProjection.fs" />
        <!-- Phase 275 — hosted-tree i18n resolution seam: IHostI18nResolver
             resolves key + placeholder + locale against the Phase 179 i18n
             substrate (Translations / PseudoLocale / ApiError.applyPlaceholders,
             all Core), with an observable missing-key sink feeding the coverage
             signal. Neutral (no tree-language type), Core-only deps so it packs
             under fable/ and resolves identically on both tiers. -->
        <Compile Include="Client\HostI18nResolver.fs" />
        <!-- Phase 278 — hosted-tree render-cost budget gate: HostRenderBudget
             (max nodes / depth / render-time) + a generic measureTree + an
             evaluate that names each breach; reports over-budget through the
             Phase 268 IHostRenderTelemetrySink (non-fatal) with an opt-in
             enforce. Core-only deps; Fable-safe. -->
        <Compile Include="Client\HostRenderBudget.fs" />
        <!-- Phase 276 — hosted-tree navigation/route contract (client half):
             IHostRouteContract maps a hosted module's neutral HostRoute
             declarations to a NavigationRequest deep-link + restores param
             state via the Phase 264 projection. After NavigationRequest.fs
             (the deep-link hook) and the Core HostRoute type. The SSR half
             lives in ToolUp.PublicRendering (HostRouteRegistration.fs). -->
        <Compile Include="Client\HostRouteContract.fs" />
        <!-- Phase 298 — live preview of an unreduced composition's view
             subtrees: renders a partial (not-yet-compiled) composition's
             typed-tree view subtrees live (CSR) against a Phase 264
             HostBindingSources projection, degrading an unresolved subtree
             to a labelled placeholder (never throws). After HostStateProjection
             (the binding-source seam it resolves against). -->
        <Compile Include="Client\UnreducedViewPreview.fs" />
        <!-- Cross-module client event bus. Publish/subscribe seam letting
             one module broadcast a named event that sibling modules react
             to without importing each other. Same sanctioned-mutable-global
             shape as NavigationRequest / ModuleStateObserver; consumed by
             the shell's boot subscription + ModuleEventPublished fan-out. -->
        <Compile Include="Client\ModuleEvents.fs" />
        <Compile Include="Client\RegisteredModules.fs" />
        <Compile Include="Client\AuthUIProvider.fs" />
        <Compile Include="Client\FeatureFlags.fs" />
        <Compile Include="Client\I18n.fs" />
        <Compile Include="Client\ProcessedDataContext.fs" />
        <Compile Include="Client\LoadingIndicatorContext.fs" />
        <!-- Phase 5e — per-tenant branding. Context + hook surfacing the
             active team's resolved Branding; BrandedHeader applies the
             favicon + brand-primary CSS var as document side effects. -->
        <Compile Include="Client\BrandingProvider.fs" />
        <Compile Include="Components\BrandedHeader.fs" />
        <Compile Include="Client\GeneralUITypes.fs" />
        <Compile Include="Client\Consent\IConsentProvider.fs" />
        <Compile Include="Client\Consent\NoOpConsentProvider.fs" />
        <Compile Include="Client\Consent\FundingChoicesProvider.fs" />
        <!-- Phase 159 — third-party CMP bridge seam + named-bridge
             registry. Before ConsentProvider.fs (resolve reads the
             registry for CustomConsentProvider). -->
        <Compile Include="Client\Consent\IConsentManagementBridge.fs" />
        <Compile Include="Client\Consent\ConsentProvider.fs" />
        <!-- Phase 159 — SDK category-toggle consent banner (pure MVU core
             + Feliz view). After ConsentProvider.fs (reads current()). -->
        <Compile Include="Client\Consent\ConsentBanner.fs" />
        <Compile Include="Components\ConsentGate.fs" />
        <Compile Include="Client\AdPanel\AdScriptLoader.fs" />
        <Compile Include="Client\AdPanel\IAdAnalyticsSink.fs" />
        <Compile Include="Client\AdPanel\ServerSinkAdAnalytics.fs" />
        <Compile Include="Components\AdSlot.fs" />
        <Compile Include="Client\Premium\PremiumHook.fs" />
        <!-- Phase 56 — typed inbound rate-limit banner. Consumers handle
             ApiError.RateLimited and render this with the typed
             RateLimitedError payload. -->
        <Compile Include="Components\RateLimitedBanner.fs" />
        <Compile Include="Components\Modal.fs" />
        <Compile Include="Components\SvgTree.fs" />
        <Compile Include="Components\ToastCentre.fs" />
        <!-- Phase 121 — typed boot-degradation accumulator + dismissible
             banner. Pure data + one Feliz component; the shell (SDK.Client)
             owns accumulation, retry dispatch, and the banner mount. -->
        <Compile Include="Client\BootDegradation.fs" />
        <Compile Include="Client\FileManagerUI.fs" />
        <Compile Include="Client\MappingDataManagerUI.fs" />
        <!-- 0.5.7 — Debounced typeahead component over IUserDirectoryApi.
             Consumed by TeamManagerUI's "Invite a member" form; degrades
             to a plain text input when no IUserDirectory companion is
             registered server-side. -->
        <Compile Include="Client\UserDirectoryTypeahead.fs" />
        <Compile Include="Client\TeamManagerUI.fs" />
        <Compile Include="Client\InviteAccept.fs" />
        <Compile Include="Client\TeamConfigUI.fs" />
        <Compile Include="Client\WebhookAdminUI.fs" />
        <Compile Include="Client\HealthMonitorUI.fs" />
        <Compile Include="Client\ServiceStatusBoardUI.fs" />
        <Compile Include="Client\PlatformAdmin\PublicUtilityWidgets.fs" />
        <Compile Include="Client\PlatformAdminUI.fs" />
        <Compile Include="Client\PermissionsAdminUI.fs" />
        <Compile Include="Client\UsageDashboard.fs" />
        <!-- Phase 217 — module-contributed Home-widget registry (read by
             Home.fs; populated at boot by SDK.Client.program). -->
        <Compile Include="Client\HomeWidget.fs" />
        <!-- Phase 171 — Home / Overview landing module. -->
        <Compile Include="Client\Home.fs" />
        <!-- Parameterized SDK built-in no-active-team landing module. -->
        <Compile Include="Client\NoActiveTeamLandingUI.fs" />
        <Compile Include="Client\DataSourceCredentialUI.fs" />
        <Compile Include="Client\DataIngestionUI.fs" />
        <Compile Include="Client\DataSubjectRequestAdminUI.fs" />
        <!-- Phase 54e — tenant-lifecycle diagnostics admin. Surfaces the
             durable last LifecycleSummary (IPlatformTenantApi.GetLifecycleSummary)
             per scope; Platform-Admin gated like the other _sdk.* admin
             modules. Before SDK.Client.fs (prepareModules calls create). -->
        <Compile Include="Client\TenantLifecycleAdminUI.fs" />
        <!-- Phase 544 — platform user-management admin. Lists every
             principal (IPlatformTenantApi.ListPrincipals) + drives the
             Phase 54-family offboard flow per row; opt-in (ClientConfig
             .PlatformUsers) + Platform-Admin gated. Before SDK.Client.fs
             (prepareModules calls create). -->
        <Compile Include="Client\PlatformUsersUI.fs" />
        <Compile Include="Components\ModuleBoundary.fs" />
        <Compile Include="Client\SDK.Client.fs" />
        <!-- Phase 57 — hydration-aware bootstrap + per-route metadata
             hook for SPA prerender. Both opt-in; consumers compose
             them on top of Client.run / ClientConfig.PrerenderRoutes. -->
        <Compile Include="Client\Bootstrap\Hydration.fs" />
        <Compile Include="Client\Bootstrap\MetadataHook.fs" />
        <!-- Phase 57 follow-up — SDK-side prerender entry-point. Exposes
             a `globalThis.__toolup_prerender_render` the FAKE Prerender
             target's Node script calls per declared route. No-op in
             the browser; only the Node-side prerender path consumes
             the registration. -->
        <Compile Include="Client\Bootstrap\PrerenderExport.fs" />
    </ItemGroup>
  <ItemGroup>
    <!-- Explicit FSharp.Core reference: the SDK-bundled implicit
         FSharp.Core resolves to a too-old version when this fsproj
         is built transitively via Release-config pack of a downstream
         consumer (string interpolation in Client/SDK.Client.fs etc.
         needs FSharp.Core 5.0+). Pinning here forces the 10.x version
         declared in Directory.Packages.props. -->
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
    <!-- 0.4.3 — Fable.React.Types and Fable.Browser.Dom were pulled
         in transitively via ToolUp.Elmish.React. Declared directly
         now that the elmish runtime is folded in, so the dep is
         explicit and survives any future Elmish source restructure. -->
    <PackageReference Include="Fable.React.Types" />
    <PackageReference Include="Fable.Browser.Dom" />
    <!-- 0.4.4 — ToolUp.Remoting.Client folded in; PackageReference dropped.
         The Fable client transport (Browser.XMLHttpRequest, Fable.SimpleJson
         deserialisation) is now compiled directly under Client/Remoting/. -->
    <PackageReference Include="Fable.Browser.XMLHttpRequest" />
    <PackageReference Include="Fable.SimpleJson" />
    <PackageReference Include="Fable.SimpleHttp" />
    <PackageReference Include="Feliz" />
  </ItemGroup>
</Project>
