<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WebhookSignerTests.fs" />
    <Compile Include="StripeEventTests.fs" />
    <Compile Include="TokenTests.fs" />
    <Compile Include="SmokeTests.fs" />
    <Compile Include="StripeWebhookHandlerTests.fs" />
    <Compile Include="IdempotencyStoreContractTests.fs" />
    <Compile Include="TierTokenSinkTests.fs" />
    <Compile Include="StripeHttpWrapperTests.fs" />
    <Compile Include="StripeBillingProviderTests.fs" />
    <!-- Phase 332 — empty/weak HMAC secret fail-closed gates (billing + peer). -->
    <Compile Include="SecretStrengthGateTests.fs" />
    <!-- Phase 340 — per-subject epoch revocation + tier-cookie edge hardening. -->
    <Compile Include="TierTokenRevocationTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Stripe.Webhook\ToolUp.Stripe.Webhook.fsproj" />
    <ProjectReference Include="..\ToolUp.Stripe.TierToken\ToolUp.Stripe.TierToken.fsproj" />
    <ProjectReference Include="..\ToolUp.Stripe.Server\ToolUp.Stripe.Server.fsproj" />
    <!-- TestBlobStorage for the durable idempotency-store conformance pack. -->
    <ProjectReference Include="..\ToolUp.Platform.Testing\ToolUp.Platform.Testing.fsproj" />
    <!-- Phase 332 — exercises JwtPeerAuthProvider's per-call signing-key strength guard. -->
    <ProjectReference Include="..\InterPlatform\InterPlatform.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <!-- TestHost only in the test pack — never the shipped package. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>
</Project>
