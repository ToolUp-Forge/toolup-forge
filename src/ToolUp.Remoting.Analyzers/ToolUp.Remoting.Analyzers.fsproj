<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ToolUp.Remoting.Analyzers</PackageId>
    <Description>The ToolUp SDK's static analyser rule set (FSharp.Analyzers.SDK): Remoting API methods missing an authorisation classification (TUR0001) or, opt-in, an audit annotation (TUR0002); container resolution outside service registration (TUA001); an HttpClient built without the platform egress handler (TUA002); Async.RunSynchronously outside a program entry point (TUA003). Each rule is the compile-time half of a runtime check. Pure tooling; references nothing at runtime.</Description>
    <PackageTags>fsharp;analyzer;fsharp-analyzers;remoting;authorization;audit;security;egress</PackageTags>
    <!--
      Analyzer-package shape (FSharp.Analyzers.SDK convention): the analyzer
      DLL ships under `analyzers/dotnet/fs`, NOT `lib/`, so the analyzer host
      (the `fsharp-analyzers` CLI / Ionide) discovers it by the `*Analyzer*.dll`
      glob. A consumer adds the PackageReference and opts in via their
      `.fsproj` / editorconfig; the package contributes no compile/runtime
      surface (GP 13 — uninstalled = byte-for-byte unchanged).
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- No lib/ build output ⇒ no symbols to package; the inherited
         IncludeSymbols=true would otherwise fail NU5017 on the empty .snupkg. -->
    <IncludeSymbols>false</IncludeSymbols>
    <!-- NU5128: no lib/ + no package dependencies is intentional for an
         analyzer-only package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure recognition core (FSharp.Core only). SOURCE-LINKED into
         ToolUp.Platform.Tests so the parity test runs this exact decision
         code against the runtime AuthClassifier — see Recognition.fs header. -->
    <Compile Include="Recognition.fs" />
    <Compile Include="Extraction.fs" />
    <!-- Phase 776 — the rule metadata the rule document is rendered from,
         the TUA containment rules, and the whole-tree run the VerifyAll
         `Analyzers` leg invokes. -->
    <Compile Include="Rules.fs" />
    <Compile Include="ContainmentRules.fs" />
    <Compile Include="TreeScan.fs" />
    <Compile Include="Analyzer.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- An analyzer DLL must be ABI-compatible with the `fsharp-analyzers`
         CLI / Ionide HOST that loads it, NOT with the workspace baseline.
         The host bundles its own FSharp.Core and refuses to forward-load a
         higher assembly version: the only host matching FSharp.Analyzers.SDK
         0.36.0 (fsharp-analyzers 0.36.0) ships FSharp.Core 10.0.0.0, so an
         analyzer built against the workspace's 10.1.300 (assembly 10.1.0.0)
         fails to load with "Could not load FSharp.Core 10.1.0.0. The expected
         assembly version of FSharp.Core is 10.0.0.0." (and the host exits 0
         having registered 0 analyzers — a silent false-green).
         VersionOverride pins THIS project (only) to 10.0.101 — the exact
         FSharp.Core the SDK 0.36.0 depends on and the host bundles (assembly
         10.0.0.0). The workspace 10.1.300 baseline is unchanged everywhere
         else; Recognition.fs is still source-linked into ToolUp.Platform.Tests
         and compiled there against 10.1.300. Re-pin in lockstep if the SDK /
         host version ever moves. -->
    <PackageReference Include="FSharp.Core" VersionOverride="10.0.101" />
    <!-- Host-provided at analysis time; PrivateAssets keeps it out of the
         package dependency set. -->
    <PackageReference Include="FSharp.Analyzers.SDK" PrivateAssets="all" />
  </ItemGroup>
  <!-- Ship the built analyzer assembly under analyzers/dotnet/fs. -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/fs" Visible="false" />
  </ItemGroup>
</Project>
