<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ToolUp.RAG.Benchmarks</RootNamespace>
    <DynamicFileNestingEnabled>false</DynamicFileNestingEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EvalCore.fs" />
    <Compile Include="Beir\BeirTypes.fs" />
    <Compile Include="Beir\BeirLoader.fs" />
    <Compile Include="Metrics\LatencyMetrics.fs" />
    <Compile Include="Runner\PipelineFactory.fs" />
    <Compile Include="Runner\BenchmarkRunner.fs" />
    <!-- Phase 14k WS5 Item 3 — fixture-driven mixed-dim latency
         benchmark. Bypasses IRetrievalPipeline (which expects text
         content + embedder) and drives HnswVectorStore directly with
         the pre-computed mixed-dim vectors. -->
    <Compile Include="Runner\MixedDimBenchmark.fs" />
    <!-- Phase 886 — the concurrent load harness: N simultaneous callers
         against one composed retrieval pipeline and against the fact
         store, with blob read counts beside every clock. Its gate
         configuration feeds the `load` block of perf-budgets.json. -->
    <Compile Include="Runner\ConcurrentLoadBenchmark.fs" />
    <Compile Include="Runner\FactStoreLoadBenchmark.fs" />
    <Compile Include="Runner\ReportWriter.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- SDK server infrastructure (interfaces + storage + logger + secret store)
       — wired via <ProjectReference> below. AI / LocalEmbedding / OpenAIEmbedding /
       Hnsw companion sources similarly DLL-referenced (Phase 11.B follow-up cutover). -->
  <Import Project="..\ToolUp.Platform\ToolUp.Platform.Server.props" />
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\ToolUp.AI.Core\ToolUp.AI.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
    <ProjectReference Include="..\ToolUp.RAG.Core\ToolUp.RAG.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.RAG.Server\ToolUp.RAG.Server.fsproj" />
    <ProjectReference Include="..\EmbeddingProviders\Local\LocalEmbeddingProvider.fsproj" />
    <ProjectReference Include="..\EmbeddingProviders\OpenAI\OpenAIEmbeddingProvider.fsproj" />
    <ProjectReference Include="..\VectorStores\Hnsw\HnswVectorStore.fsproj" />
    <!-- Phase 886 — the load harness's other arms: the pgvector store, the
         object-storage arm (Azure Blob against the local emulator) and the
         fact store. -->
    <ProjectReference Include="..\VectorStores\Pgvector\PgvectorVectorStore.fsproj" />
    <ProjectReference Include="..\Storage\AzureBlobStorage\AzureBlobStorage.fsproj" />
    <ProjectReference Include="..\ToolUp.Facts.Core\ToolUp.Facts.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.Facts.Server\ToolUp.Facts.Server.fsproj" />
  </ItemGroup>
  <!-- Phase 14k WS5 Item 3 — mixed-dim fixture JSON, linked from the
       co-located RAG.Evaluation/fixtures/ directory into the benchmark
       runner's output so the loader finds it at runtime. -->
  <ItemGroup>
    <None Include="..\ToolUp.RAG.Evaluation\fixtures\eval-mixed-dim.json"
          Link="fixtures\eval-mixed-dim.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- 0.4.4 — ToolUp.Remoting.{Giraffe,Json} flow transitively from
         ToolUp.Platform.Server after the fold. -->
    <PackageReference Include="Giraffe" />
  </ItemGroup>
</Project>
