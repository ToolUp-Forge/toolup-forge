<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.TelemetrySinks.Ga4</PackageId>
    <AssemblyName>ToolUp.TelemetrySinks.Ga4</AssemblyName>
    <Description>GA4 Measurement Protocol-backed ITelemetrySink for ToolUp.Platform — ships end-user product-analytics events to Google Analytics 4 over BCL HttpClient (no vendor SDK). Server-only companion.</Description>
    <PackageTags>fsharp;sdk;telemetry;analytics;ga4;google-analytics;measurement-protocol</PackageTags>
  </PropertyGroup>
  <!-- Phase 163 — ITelemetrySink reference companion. GP 1 — no vendor SDK
       (BCL HttpClient only), so nothing reaches ToolUp.Platform.*. GP 2 —
       no paid dependency. Server-only. -->
  <ItemGroup>
    <Compile Include="Ga4TelemetrySink.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
