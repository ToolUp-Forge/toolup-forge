<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <!-- The Infra pack: the lists whose test files reach the Infra part and no later one.
         The test sources stay under src/ToolUp.Platform.Tests/ and this project
         compiles them from there, because other packs source-link them and
         their citations and __SOURCE_DIRECTORY__ paths must not move. Which
         file is in which pack, and why: docs/migrations/1194-platform-pack-partition.md. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IBlobStorageContract.fs" Link="Contracts\IBlobStorageContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IProviderProfileContract.fs" Link="Contracts\IProviderProfileContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IEventStoreContract.fs" Link="Contracts\IEventStoreContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IDataObjectStoreContract.fs" Link="Contracts\IDataObjectStoreContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IDataCatalogContract.fs" Link="Contracts\IDataCatalogContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\ILineageStoreContract.fs" Link="Contracts\ILineageStoreContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IDataSourceContract.fs" Link="Contracts\IDataSourceContract.fs" />
