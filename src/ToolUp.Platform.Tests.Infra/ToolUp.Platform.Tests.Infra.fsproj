        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IOAuth1aFlowContract.fs" Link="Contracts\IOAuth1aFlowContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\ISecretStoreContract.fs" Link="Contracts\ISecretStoreContract.fs" />
