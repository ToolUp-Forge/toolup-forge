        <ProjectReference Include="..\ToolUp.Platform.Server.Infra\ToolUp.Platform.Server.Infra.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server.Remoting\ToolUp.Platform.Server.Remoting.fsproj" />
        <ProjectReference Include="..\TelemetrySinks\Ga4\Ga4TelemetrySink.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
        <PackageReference Include="JsonSchema.Net" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\ToolUp.Platform.Tests\fixtures\sbom-schemas\*.json"
              Link="fixtures\sbom-schemas\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
