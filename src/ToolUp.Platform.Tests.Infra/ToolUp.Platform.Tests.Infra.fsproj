        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IModelRegistryContract.fs" Link="Contracts\IModelRegistryContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IExternalHandleStoreContract.fs" Link="Contracts\IExternalHandleStoreContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\ITelemetrySinkContract.fs" Link="Contracts\ITelemetrySinkContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\LocalFileStorageTests.fs" Link="InProcess\LocalFileStorageTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\InMemoryEventStoreTests.fs" Link="InProcess\InMemoryEventStoreTests.fs" />
