<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Facts Client — the fact browse companion: a multi-page Feliz module over IFactBrowseApi showing declared fact tables, their run history and change summaries, and server-paged drill-down rows with one fact's provenance. Separate from the knowledge base client; depends on ToolUp.Platform.Client + ToolUp.Facts.Shared. Phase 895.</Description>
        <PackageTags>fsharp;fable;feliz;elmish;sdk;client;facts;grounding</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Client\ToolUp.Platform.Client.fsproj" />
        <ProjectReference Include="..\ToolUp.Facts.Shared\ToolUp.Facts.Shared.fsproj" />
    </ItemGroup>
    <!-- Client-tier closure: pack source for Fable consumers under fable/. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\ToolUp.Facts\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Client\FactBrowseModel.fs" />
        <Compile Include="Client\FactBrowseView.fs" />
    </ItemGroup>
    <!-- Fable.* / Feliz / FSharp.Core resolved transitively via
         ToolUp.Platform.Client + the .NET SDK. -->
</Project>
