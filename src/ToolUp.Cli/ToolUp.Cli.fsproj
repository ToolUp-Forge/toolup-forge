<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Tool-manifest-installable `dotnet tool`. `dotnet tool install
         ToolUp.Cli` then exposes the `toolup` command. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>toolup</ToolCommandName>
    <PackageId>ToolUp.Cli</PackageId>
    <Description>The `dotnet toolup` admin CLI for the ToolUp Platform SDK — a thin, dependency-free command host. Ships `version` and `docker emit`; further subcommands plug in additively.</Description>
    <PackageTags>fsharp;cli;dotnet-tool;toolup;dockerfile</PackageTags>
    <!-- A globally-installed tool may run on any patch of the pinned
         major; roll forward so a 10.0.x host need not match exactly. -->
    <RollForward>latestMinor</RollForward>
  </PropertyGroup>

  <!-- The four platformsdk-docker template files, embedded so the
       `docker emit` command re-emits them with no on-disk template
       dependency. Single source of truth stays templates/; LogicalName
       pins the resource id readEmbedded looks up (otherwise MSBuild
       derives an id from the `..\..` path). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\templates\platformsdk-docker\Dockerfile.template">
      <LogicalName>docker/Dockerfile.template</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-docker\dockerignore.template">
      <LogicalName>docker/dockerignore.template</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-docker\compose.yml.template">
      <LogicalName>docker/compose.yml.template</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-docker\healthcheck.sh">
      <LogicalName>docker/healthcheck.sh</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Phase 168 — the six platformsdk-module template files, embedded so
       `module add` scaffolds with no on-disk template dependency. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\templates\platformsdk-module\MyModule\SharedTypes.fs">
      <LogicalName>module/SharedTypes.fs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-module\MyModule\Server.fs">
      <LogicalName>module/Server.fs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-module\MyModule\ClientModel.fs">
      <LogicalName>module/ClientModel.fs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-module\MyModule\ClientView.fs">
      <LogicalName>module/ClientView.fs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-module\MyModule\MyModule.fsproj">
      <LogicalName>module/MyModule.fsproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\platformsdk-module\MyModule\MyModule.Client.props">
      <LogicalName>module/MyModule.Client.props</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Cli\Dispatch.fs" />
    <Compile Include="Cli\Templating.fs" />
    <Compile Include="Cli\VersionCommand.fs" />
    <Compile Include="Cli\DockerEmitCommand.fs" />
    <Compile Include="Cli\StampCommand.fs" />
    <Compile Include="Cli\ModuleCommand.fs" />
    <Compile Include="Cli\MembershipsDoctorCommand.fs" />
    <!-- Phase 550 — the tenant / user lifecycle verbs. `Users.fs` reuses
         `Tenants.fs`'s admin transport and offboard runner (a user
         offboard IS a scope offboard), so it compiles after it. -->
    <Compile Include="Commands\Tenants.fs" />
    <Compile Include="Commands\Users.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
