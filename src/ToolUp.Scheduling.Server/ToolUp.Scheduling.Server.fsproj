<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Scheduling Server — booking scheduler with per-resource concurrency lock, conflict detector, scheduling API handler, SchedulingCompose. Depends on ToolUp.Platform.Server + ToolUp.Scheduling.Core.</Description>
        <PackageTags>fsharp;sdk;server;scheduling</PackageTags>
        <!-- Phase 11.B follow-up cross-tier cutover (2026-05-08): Scheduling
             Server carries the booking scheduler interface, conflict
             detector, default impl, API handler, SchedulingCompose. -->
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.Scheduling.Core\ToolUp.Scheduling.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.Scheduling\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Server\IBookingScheduler.fs" />
        <Compile Include="Server\BookingConflictDetector.fs" />
        <Compile Include="Server\BookingScheduler.fs" />
        <Compile Include="Server\SchedulingApiHandler.fs" />
        <Compile Include="Server\SchedulingCompose.fs" />
    </ItemGroup>
    <!-- PackageReferences flow transitively from ToolUp.Platform.Server.
         FSharp.Core is implicit via the .NET SDK. -->
</Project>
