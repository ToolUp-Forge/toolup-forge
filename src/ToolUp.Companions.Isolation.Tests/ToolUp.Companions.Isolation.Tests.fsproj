<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Entries.fs" />
        <!-- The two Phase 687 contract packs, link-compiled from the shared
             Contracts/ directory (the IReportRendererContract precedent):
             the seam pack cannot compile in ToolUp.Platform.Tests, which
             does not reference the isolation assembly; the renderer pack
             is compiled there too and bound by the in-process renderer. -->
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\ICompanionIsolationContract.fs" Link="Contracts\ICompanionIsolationContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IDerivativeRendererContract.fs" Link="Contracts\IDerivativeRendererContract.fs" />
        <Compile Include="ContractBindings.fs" />
        <Compile Include="IsolationTests.fs" />
        <Compile Include="WiringTests.fs" />
        <!-- Phase 722 — the unregistered-[<Tests>]-list guard, source-linked from
             ToolUp.Platform.Tests so there is one implementation. -->
        <Compile Include="..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- An Exe referencing an Exe: the isolation assembly carries the
             worker's entry point, and this runner is the host that starts
             it. The SDK allows the reference; nothing here is
             self-contained. -->
        <ProjectReference Include="..\ToolUp.Companions.Isolation\ToolUp.Companions.Isolation.fsproj" />
        <!-- The two forge paths wired onto the seam. -->
        <ProjectReference Include="..\ToolUp.AssetStore\ToolUp.AssetStore.fsproj" />
        <ProjectReference Include="..\OcrProviders\Tesseract\ToolUp.OcrProviders.Tesseract.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
        <!-- Phase 617's precedent: the Skia cases decode REAL pixels through
             SkiaSharp on both sides of the boundary, so a Linux runner needs a
             native for its RID. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    </ItemGroup>
</Project>
