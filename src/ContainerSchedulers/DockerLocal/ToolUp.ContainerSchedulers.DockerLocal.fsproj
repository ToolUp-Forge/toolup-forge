<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.ContainerSchedulers.DockerLocal</PackageId>
    <AssemblyName>ToolUp.ContainerSchedulers.DockerLocal</AssemblyName>
    <Description>Dev-grade IContainerScheduler companion for ToolUp.Platform that drives Docker over the local socket. Phase 26 reference implementation; production deployments use a cloud-specific companion.</Description>
    <PackageTags>fsharp;sdk;deploy-plane;container-scheduler;docker;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DockerLocalContainerScheduler.fs" />
    <Compile Include="DockerLocalContainerSchedulerHealthCheck.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
