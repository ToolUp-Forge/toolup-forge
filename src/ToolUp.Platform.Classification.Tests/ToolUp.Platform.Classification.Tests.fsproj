<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <!-- Phase 41 — the data-classification substrate's three server-tier
         files depend only on Core types (IAuditLog / AccessContext /
         ClassificationLevel), so this pack source-includes them and
         references Core directly rather than the whole Server DLL. Keeps
         the pack buildable independently of the rest of the server tier. -->
    <ItemGroup>
        <Compile Include="..\ToolUp.Platform.Server\Server\Classification\IFieldClassifier.fs" />
        <Compile Include="..\ToolUp.Platform.Server\Server\Classification\DefaultFieldClassifier.fs" />
        <Compile Include="..\ToolUp.Platform.Server\Server\Classification\ClassificationGate.fs" />
        <Compile Include="Support\Doubles.fs" />
        <Compile Include="Contracts\IFieldClassifierContract.fs" />
        <Compile Include="InProcess\ClassificationGateTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
</Project>
