<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.PublicRendering — server-side-rendered public-facing pages (marketing sites, content portals, landing pages) for ToolUp.Platform. Giraffe.ViewEngine rendering DSL + markdown content loader with YAML frontmatter + sitemap + redirect map + JSON-LD structured-data helpers. Depends on ToolUp.Platform.Server.</Description>
        <PackageTags>fsharp;sdk;server;ssr;cms;giraffe;marketing</PackageTags>
        <!-- Phase 38 — single-tier companion (no Fable client surface in
             v1; SSR-only). README + TECHNICAL_GUIDE live alongside the
             fsproj since there's no cross-tier sibling needing a shared
             parent docs directory. -->
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Giraffe.ViewEngine" />
        <!-- Phase 92 — opt-in Feliz-DSL server layouts (FelizLayout
             adapter + withFelizLayout). MIT, FSharp.Core-only dep; see
             docs/design/feliz-viewengine-evaluation.md. -->
        <PackageReference Include="Feliz.ViewEngine" />
        <PackageReference Include="Markdig" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Shared\PublicContentTypes.fs" />
        <Compile Include="Server\IPublicContentApi.fs" />
        <!-- Phase 85 — analytics → Narrative projection helpers. Depend
             only on Core (Narrative element set + ProcessedData / file-
             snapshot types), so they sit early in the compile order. -->
        <Compile Include="Server\NarrativeFromData.fs" />
        <Compile Include="Server\NarrativeFromDataProjectors.fs" />
        <Compile Include="Server\FrontmatterParser.fs" />
        <Compile Include="Server\MarkdownContentLoader.fs" />
        <Compile Include="Server\EntityRegistrations.fs" />
        <Compile Include="Server\PublicPageRevisions.fs" />
        <Compile Include="Server\IContentSource.fs" />
        <Compile Include="Server\PublicContentApiImpl.fs" />
        <!-- Phase 84 — SSR render cache (ISR tier) + HTTP cache headers.
             Interface + policy + impls precede the page handler (cache
             integration) and compose (registration). -->
        <Compile Include="Server\IRenderCache.fs" />
        <Compile Include="Server\RenderCacheImpl.fs" />
        <!-- Phase 86 — page-audience authorization decision (gated SSR). -->
        <Compile Include="Server\AudienceGate.fs" />
        <!-- Phase 91 — RAG-backed cited answer pages (content source over
             IRetrievalPipeline; extractive + grounded, StrictlyGrounded
             refusal, optional synthesis hook). -->
        <Compile Include="Server\RagAnswerSource.fs" />
        <!-- Phase 91 — KB-as-docs SSR surface (content source over a
             deployment-supplied read-port; collection index + per-doc
             landing, enumerable for sitemap / static export). -->
        <Compile Include="Server\KnowledgeDocsSource.fs" />
        <Compile Include="Server\RedirectMap.fs" />
        <Compile Include="Server\StructuredDataHelpers.fs" />
        <!-- Phase 111 — per-request head-metadata injection for
             resolved-content pages (reads the `head:*` frontmatter
             envelope; emits canonical / og / meta / JSON-LD before
             `</head>`). Precedes the page handler + static export that
             call it. -->
        <Compile Include="Server\PageHeadInjection.fs" />
        <Compile Include="Server\NarrativePrerender.fs" />
        <Compile Include="Server\NarrativeLayout.fs" />
        <!-- Phase 92 — Feliz.ViewEngine layout adapter (Feliz-DSL
             layouts into the XmlNode layout registry). Precedes
             PublicRenderingCompose (withFelizLayout). -->
        <Compile Include="Server\FelizLayoutAdapter.fs" />
        <!-- Phase 94 — deterministic inline-SVG chart renderer for the
             NarrativeFromData chart projector (Component seam). -->
        <Compile Include="Server\NarrativeCharts.fs" />
        <!-- Phase 98 — pure listing-pagination helper (used by NavTree
             ofCollectionPaged + NavLayout pager). -->
        <Compile Include="Server\Pagination.fs" />
        <!-- Phase 90 — site structure: nav tree model + menu/breadcrumb
             render helpers + taxonomy (tag-index content source). NavTree
             → NavLayout (renders it) → TaxonomyHandler (tag pages). -->
        <Compile Include="Server\NavTree.fs" />
        <Compile Include="Server\NavLayout.fs" />
        <Compile Include="Server\TaxonomyHandler.fs" />
        <Compile Include="Server\Attribution.fs" />
        <!-- Phase 109 — IndexNow push-indexing: ownership-key endpoint +
             resumable batched submission (per-batch success persistence) +
             state-store seam (file/blob) + per-slug publish ping + startup
             hosted service. Precedes NarrativePagePublisher (publish ping)
             and PublicRenderingCompose (registration). -->
        <Compile Include="Server\IndexNow.fs" />
        <Compile Include="Server\NarrativePagePublisher.fs" />
        <!-- Phase 101 — tabular data extraction + CSV / JSON serialisers
             (consumed by the export handler's ?format=csv/json). -->
        <Compile Include="Server\NarrativeData.fs" />
        <Compile Include="Server\NarrativeExportHandler.fs" />
        <Compile Include="Server\NarrativeFeedHandler.fs" />
        <!-- Phase 93 — SSR render observability (IMetricsSink): per-request
             render duration / outcome counters + per-source resolve
             latency decorator. Precedes the page handler it instruments. -->
        <Compile Include="Server\RenderMetrics.fs" />
        <!-- Phase 155 — handler-agnostic conditional-GET combinator
             (ETag / Last-Modified / Cache-Control + 304), lifted out of
             PublicPageHandler so any Giraffe route can reuse it. Precedes
             the page handler (its first caller). -->
        <Compile Include="Server\ConditionalGet.fs" />
        <Compile Include="Server\PublicPageHandler.fs" />
        <!-- Phase 91 — semantic-search SSR endpoint (/search?q= → retrieval
             → ranked Narrative result list; query-size cap, rides the
             general rate-limit partition). -->
        <Compile Include="Server\SemanticSearchHandler.fs" />
        <Compile Include="Server\ContentPreview.fs" />
        <!-- Phase 149/150 — sitemap generation moved below ConditionalGet +
             IndexNow: the conditional-GET sitemap handler derives its weak
             ETag from `IndexNow.computeSignature` and serves through the
             Phase 155 `ConditionalGet.cacheable` combinator, so it must
             compile after both. -->
        <Compile Include="Server\SitemapGenerator.fs" />
        <!-- Phase 157 — static client-search index emitter (RAG-free
             search index over the same universe SitemapGenerator walks;
             content-version ETag via IndexNow.computeSignature; serves
             through the Phase 155 ConditionalGet combinator). After
             SitemapGenerator + IndexNow + ConditionalGet. -->
        <Compile Include="Server\SearchIndexEmitter.fs" />
        <Compile Include="Server\StaticExport.fs" />
        <!-- Phase 114/115 — multi-host site registry: PublicSiteDef (incl.
             per-site feeds) + per-site loader/API runtimes + host→site
             dispatch + SiteGate combinator + startup validator. Needs the
             loader, content-api impl, and NarrativeFeedConfig; precedes
             only the compose that consumes it. -->
        <Compile Include="Server\MultiSite.fs" />
        <!-- Phase 264 — SSR host-state projection: ServerHostStateProjection
             projects Phase 112 authoritative live-session state into the
             neutral HostBindingSources namespace, scope-bound by
             construction (GP 4). Standalone (depends only on Core +
             Server types); placed before the compose root by convention. -->
        <Compile Include="Server\HostStateProjection.fs" />
        <!-- Phase 273 — SSR hosted-tree error-boundary + degraded fallback:
             HostRenderBoundary.guard wraps an opaque subtree render so a
             thrown node yields a structured fallback fragment + a Phase 268
             IHostRenderTelemetrySink fault instead of 500-ing the page.
             Neutral utility (depends only on Core HostRenderFault); applied
             at call sites, not compose-registered (GP 11/13). Standalone;
             placed before the compose root by convention. -->
        <Compile Include="Server\HostRenderBoundary.fs" />
        <Compile Include="Server\PublicRenderingCompose.fs" />
        <!-- Phase 276 — hosted-tree route registration (SSR half): registers
             a hosted multi-page module's neutral Core HostRoute declarations
             into the Phase 111 route table as enumerable IContentSource
             entries (crawlable). After PublicRenderingCompose.fs — HostRouteRegistration.register
             folds the Phase 83 withContentSource. The client half lives in
             ToolUp.Platform.Client (HostRouteContract.fs). -->
        <Compile Include="Server\HostRouteRegistration.fs" />
    </ItemGroup>
</Project>
