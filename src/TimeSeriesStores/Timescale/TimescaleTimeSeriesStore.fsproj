<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.TimeSeriesStores.Timescale</PackageId>
    <AssemblyName>ToolUp.TimeSeriesStores.Timescale</AssemblyName>
    <Description>TimescaleDB / PostgreSQL-backed ITimeSeriesStore for ToolUp.Platform — high-frequency numeric series with server-side time_bucket downsampling over Npgsql. Server-only companion.</Description>
    <PackageTags>fsharp;sdk;time-series;timescaledb;postgresql;npgsql;metrics;iot</PackageTags>
  </PropertyGroup>
  <!-- Phase 161 — ITimeSeriesStore companion. GP 1 — the Npgsql dependency
       is isolated to this companion; it never reaches ToolUp.Platform.*.
       GP 2 — Npgsql is MIT-licensed (no paid default). Server-only. -->
  <ItemGroup>
    <Compile Include="TimescaleTimeSeriesStore.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
