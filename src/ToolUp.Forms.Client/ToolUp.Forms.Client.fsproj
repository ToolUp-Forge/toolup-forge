<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Forms Client — schema-driven Feliz components (FormRenderer, WorkflowBadge, FormSubmissionsList, public-form embed, survey dashboard + list views). Depends on ToolUp.Platform.Client + ToolUp.Forms.Core.</Description>
        <PackageTags>fsharp;fable;feliz;elmish;sdk;client;forms</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Client\ToolUp.Platform.Client.fsproj" />
        <ProjectReference Include="..\ToolUp.Forms.Core\ToolUp.Forms.Core.fsproj" />
    </ItemGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
         under fable/. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs;**\*.svg" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.Forms\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Client\FormsClient.fs" />
        <Compile Include="Client\WorkflowBadge.fs" />
        <Compile Include="Client\FormRenderer.fs" />
        <Compile Include="Client\FormSubmissionsList.fs" />
        <Compile Include="Client\PublicFormsClient.fs" />
        <Compile Include="Client\PublicEmbed.fs" />
        <Compile Include="Client\SurveyDashboardView.fs" />
        <Compile Include="Client\SurveyListView.fs" />
    </ItemGroup>
    <!-- Fable.* / Feliz / FSharp.Core resolved transitively via
         ToolUp.Platform.Client + the .NET SDK. -->
</Project>
