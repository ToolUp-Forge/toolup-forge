<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- See ToolUp.Remoting.Analyzers.fsproj — NU1608 is the benign
         within-F#-10 FSharp.Core patch forward-resolve. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AnalyzerAstTests.fs" />
    <!-- Phase 722 — the unregistered-[<Tests>]-list guard, source-linked from
         ToolUp.Platform.Tests so there is one implementation. -->
    <Compile Include="..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Remoting.Analyzers\ToolUp.Remoting.Analyzers.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <!-- Brings FSharp.Compiler.Service (the analyzer references it with
         PrivateAssets="all", so it does not flow transitively) for offline
         parse-only fixtures + the SDK Message type used in assertions. -->
    <PackageReference Include="FSharp.Analyzers.SDK" />
  </ItemGroup>
</Project>
