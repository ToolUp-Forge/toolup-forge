<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Platform Server — Giraffe-over-ASP.NET Core implementation surface: scope resolution, DI, default in-process implementations, ServerApp composition root, middleware. Depends on ToolUp.Platform.Core.</Description>
        <PackageTags>fsharp;sdk;server;giraffe;asp-net-core</PackageTags>
        <!-- Phase 11.C.4 (2026-05-10): Server-tier source-layout symmetry
             pass — Server/, Auth/ source moved into this project's own
             directory tree (was ../ToolUp.Platform/{Server,Auth}/ during
             Phase 11.B + 11.C.2). Source paths below are now relative to
             the fsproj, matching the per-tier convention established by
             the Client-tier closure. -->
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.Platform\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <!-- Phase 68 — the in-memory IGraphStore default (transitively pulls
             ToolUp.Graph.Core, which carries the IGraphStore contract). The
             GP-2 zero-dependency graph substrate; registered lazily by
             ComposeStores.registerGraphStore. -->
        <ProjectReference Include="..\ToolUp.Graph.InMemory\ToolUp.Graph.InMemory.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.B follow-up Tests fsproj migration (2026-05-08): the
             Tests project moved from <Compile Link> source-injection of SDK
             files to <ProjectReference> + DLL consumption. Two SDK helpers
             are still tested directly via internal access (the duplicate-
             notification-sink-Kind-detection in TransactionalDispatcher;
             the rate-limit partition-key in RateLimiting); InternalsVisibleTo
             preserves that surface for tests without exposing it on the
             public API. -->
        <InternalsVisibleTo Include="ToolUp.Platform.Tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- 0.4.4 — ToolUp.Remoting.{Json,Server,Giraffe,AspNetCore}
             folded in from a formerly-separate repository. The
             transport is a forge implementation detail; one package
             instead of four. Namespace `ToolUp.Remoting.*` is preserved
             across every moved file so every existing
             `open ToolUp.Remoting.Server` / `.Giraffe` / `.AspNetCore`
             site keeps compiling unchanged.

             Compile order matches the original cross-package dependency
             order: Json (server-side JSON converters) -> Server core
             dispatcher + auth + rate-limit + audit + etc. -> Giraffe
             adapter -> AspNetCore middleware. MsgPack types (used by
             Server/Proxy.fs) come in via ProjectReference to
             ToolUp.Platform.Core which carries the folded MsgPack
             source. -->
        <Compile Include="Server\Remoting\Json\SystemTextJsonConverter.fs" />
        <Compile Include="Server\Remoting\Types.fs" />
        <Compile Include="Server\Remoting\CallContext.fs" />
        <Compile Include="Server\Remoting\Auth.fs" />
        <Compile Include="Server\Remoting\RateLimit.fs" />
        <Compile Include="Server\Remoting\Audit.fs" />
        <Compile Include="Server\Remoting\Idempotency.fs" />
        <Compile Include="Server\Remoting\Validation.fs" />
        <Compile Include="Server\Remoting\Jobs.fs" />
        <Compile Include="Server\Remoting\Streaming.fs" />
        <Compile Include="Server\Remoting\SourceGenDispatch.fs" />
        <Compile Include="Server\Remoting\Errors.fs" />
        <Compile Include="Server\Remoting\Diagnostics.fs" />
        <Compile Include="Server\Remoting\Patterns.fs" />
        <Compile Include="Server\Remoting\Documentation.fs" />
        <Compile Include="Server\Remoting\Proxy.fs" />
        <Compile Include="Server\Remoting\DocsApp.fs" />
        <Compile Include="Server\Remoting\Remoting.fs" />
        <Compile Include="Server\Remoting\Reader.fs" />
        <Compile Include="Server\Remoting\ThreadSafeCell.fs" />
        <Compile Include="Server\Remoting\Giraffe\SharedReader.fs" />
        <Compile Include="Server\Remoting\Giraffe\GiraffeAdapter.fs" />
        <Compile Include="Server\Remoting\AspNetCore\Middleware.fs" />
        <Compile Include="Server\Rag\IEmbeddingProvider.fs" />
        <Compile Include="Server\IEmbeddingCache.fs" />
        <Compile Include="Server\Rag\IVectorStore.fs" />
        <Compile Include="Server\ISparseIndex.fs" />
        <!-- Phase 115 — unified index-lifecycle seam: delete/erase fan-out
             across IVectorStore + ISparseIndex + IEmbeddingCache with
             per-target failure isolation, so producers (KB) cannot reach
             one index and miss another. -->
        <Compile Include="Server\IIndexLifecycle.fs" />
        <Compile Include="Server\IReranker.fs" />
        <!-- Phase 506 - conversation-aware query-rewrite seam. Beside the
             other retrieval-stage seams; no dependency on them, so its
             position here is by family, not by ordering constraint. -->
        <Compile Include="Server\IQueryRewriter.fs" />
        <Compile Include="Server\ITextSummariser.fs" />
        <Compile Include="Server\IOcrProvider.fs" />
        <Compile Include="Server\ITableExtractor.fs" />
        <Compile Include="Server\IImageEmbedder.fs" />
        <Compile Include="Server\Rag\IRetrievalPipeline.fs" />
        <Compile Include="Server\IRetrievalTracer.fs" />
        <Compile Include="Server\IRagTelemetry.fs" />
        <Compile Include="Server\IMetricsSink.fs" />
        <Compile Include="Server\PrometheusMetricsSink.fs" />
        <Compile Include="Server\IActivitySink.fs" />
        <!-- Phase 472 — the CDN / edge-cache invalidation seam
             (purge-only; the CDN caches, the SDK invalidates) + the
             declared no-op + the `Cache-Control` declaration helper.
             Depends only on Core (`ILogger`), so it sits with the other
             interface-only seams ahead of any implementation. -->
        <Compile Include="Server\IEdgeCache.fs" />
        <Compile Include="Server\Logger.fs" />
        <Compile Include="Server\LoggerScope.fs" />
        <!-- Phase 696 — the deployment configuration manifest loader:
             discovery, strict JSON parse, unknown/secret-key refusals,
             SHA-256 over the raw bytes, and installation into Core's
             `ConfigResolution` seam. Server-side because Core ships its
             source for Fable consumers and cannot carry System.IO. Before
             ConsoleLogger.fs, which installs the manifest before building
             the logger — the log level is itself a bindable key. -->
        <!-- Phase 700 — the configuration-profile registry + selector.
             Before ConfigResolver.fs, which selects the profile in the
             same pass that installs the manifest. Depends only on Core
             (the built-in bundles are registry data, the rung is the
             resolution seam's), so it sits as early as the loader does. -->
        <Compile Include="Server\ConfigProfiles.fs" />
        <Compile Include="Server\ConfigResolver.fs" />
        <Compile Include="Server\Infra\ConsoleLogger.fs" />
        <Compile Include="Server\Infra\JsonConsoleLogger.fs" />
        <Compile Include="Server\Api.fs" />
        <Compile Include="Server\Infra\InMemoryEventStore.fs" />
        <Compile Include="Server\Notifications\SSEConnectionManager.fs" />
        <Compile Include="Server\SseTraceContributor.fs" />
        <Compile Include="Server\Notifications\NotificationChannel.fs" />
        <!-- Phase 241 — in-memory presence channel (single-instance default). -->
        <Compile Include="Server\Notifications\PresenceChannel.fs" />
        <!-- Phase 442 — presence tracker + advisory soft-lock store
             (interfaces + single-instance in-memory defaults). Publish
             join/move/leave + lock taken/released/expired events on the
             reserved `_platform.*` keys via INotificationChannel (Phase 6a);
             no new transport. -->
        <Compile Include="Server\IPresenceTracker.fs" />
        <Compile Include="Server\IEntityLockStore.fs" />
        <Compile Include="Server\INotificationSink.fs" />
        <Compile Include="Server\INotificationAddressBook.fs" />
        <Compile Include="Server\NotificationAddressBook.fs" />
        <!-- Phase 117 — shared SSE scope resolution. One resolution path
             (principal-wins + SseAuthMode-gated fallback + mismatch audit)
             consumed by both NotificationHandler below and
             ToolUp.AI.Server's SSEHandler so the two cannot drift. -->
        <Compile Include="Server\Notifications\SseScopeResolution.fs" />
        <Compile Include="Server\Notifications\NotificationHandler.fs" />
        <!-- Phase 112 — scope-isolated server-driven live-session host:
             ILiveChannel / ILiveSessionHost (six-rule, GP 4 structural
             scope partition) + the in-process default. After the SSE
             substrate it rides; the compose hook + endpoint live in
             Server\Compose\LiveSessionsCompose.fs (after ServerApp). -->
        <Compile Include="Server\Notifications\LiveSessionHost.fs" />
        <!-- Phase 271 — neutral tree-patch transport envelope: TreePatchEnvelope
             (monotonic seq / diff-base) + ITreePatchChannel (push / ack /
             resync-on-gap) layered over the Phase 112 ILiveChannel. Opaque
             payload (GP 1), scope isolation inherited from the wrapped channel
             (GP 4), six-rule (GP 12). After LiveSessionHost.fs it wraps. -->
        <Compile Include="Server\Notifications\TreePatchChannel.fs" />
        <!-- Phase 11.C.5 Tier 3 — server-tier `RequestContext.ofHttpContext`
             constructor for the Core-tier `RequestContext` newtype. Must
             precede every `IAuthProvider` impl so they can compile against
             the shared boxing path. -->
        <Compile Include="Server\Auth\RequestContext.fs" />
        <Compile Include="Auth\IdentitySanitiser.fs" />
        <Compile Include="Auth\HeaderAuthProvider.fs" />
        <Compile Include="Auth\StaticJwtAuthProvider.fs" />
        <!-- Phase 11.G — `AuthProvider.fromEnv` (env-var-driven dispatch). -->
        <Compile Include="Auth\AuthProviderFromEnv.fs" />
        <Compile Include="Server\Infra\LocalFileStorage.fs" />
        <!-- Phase 161 — dev/test in-memory ITimeSeriesStore default. -->
        <Compile Include="Server\Infra\InMemoryTimeSeriesStore.fs" />
        <!-- Phase 11.G — `BlobStorage.fromEnv` (env-var-driven dispatch).
             Module name is `BlobStorageEnv` because `BlobStorage` is
             reserved in Core for the interface module. -->
        <Compile Include="Server\Infra\BlobStorageFromEnv.fs" />
        <!-- Phase 671 — `EmbeddingProviderEnv.fromEnv` (env-var-driven
             embedding-provider selection). Module name is
             `EmbeddingProviderEnv` because `IEmbeddingProvider` is
             reserved for the interface module compiled above. -->
        <Compile Include="Server\Infra\EmbeddingProviderFromEnv.fs" />
        <Compile Include="Server\SecondaryIndex.fs" />
        <Compile Include="Server\Infra\PersistentEventStore.fs" />
        <Compile Include="Server\IDataObjectStore.fs" />
        <Compile Include="Server\DataObjectStore.fs" />
        <!-- Phase 482 — privacy-provenance label persistence (JSON sidecar +
             metadata carriage). Compiled before BlobDatasetStore, which reads
             and preserves the label sidecar. -->
        <Compile Include="Server\DataProvenanceLabels.fs" />
        <Compile Include="Server\IDatasetStore.fs" />
        <Compile Include="Server\BlobDatasetStore.fs" />
        <Compile Include="Server\IColumnMappingStore.fs" />
        <Compile Include="Server\ColumnMappingStore.fs" />
        <!-- Phase 173 — per-file RAG ingestion-status store (seam +
             IDataObjectStore-backed + in-memory default). Platform-tier so
             FileManagement can join status onto the file-list read; RAG owns
             the writes. -->
        <Compile Include="Server\IngestionStatusStore.fs" />
        <!-- Phase 218 — mapping dry-run validation seam + default BCL-only
             validator (compiled before ColumnMappingApiHandler + ComposeStores). -->
        <Compile Include="Server\IMappingDryRunValidator.fs" />
        <Compile Include="Server\MappingDryRunValidator.fs" />
        <Compile Include="Server\IEntityStore.fs" />
        <!-- Phase 599 — write-ahead-intent outbox coupling entity saves to
             event publication; after the store surface it wraps, before the
             relay service that drains it. -->
        <Compile Include="Server\EntityOutbox.fs" />
        <Compile Include="Server\EntityOutboxRelayService.fs" />

        <Compile Include="Server\EntityQueryExecutor.fs" />
        <Compile Include="Server\EntityStore.fs" />
        <!-- Phase 7b — user-authored schema store (substrate slice): the
             IUserSchemaStore seam + blob-backed default over IDataObjectStore
             (versioned schema definitions + typed migration execution).
             After EntityStore.fs (rides the same Phase 7 versioned object
             store); before ComposeStores.fs registers it. -->
        <Compile Include="Server\IUserSchemaStore.fs" />
        <Compile Include="Server\BlobUserSchemaStore.fs" />
        <!-- Phase 26 — Tenant entity registration. Sits behind IEntityStore;
             consumed by EntityStoreTenantFleet (the ITenantFleet single-node
             default) and by the Compose pipeline (registers via
             ServerApp.withEntity<Tenant>). -->
        <Compile Include="Server\TenantEntity.fs" />
        <!-- Phase 26 — four deploy-plane substrate interfaces. Server-only
             (IContainerScheduler.StreamLogs returns IAsyncEnumerable which
             Fable cannot transpile). Supporting types are in Core's
             Shared/Types/DeployPlaneTypes.fs so a Fable admin UI can
             render tenant/deploy state without a DTO round-trip. -->
        <Compile Include="Server\IBuildOrchestrator.fs" />
        <Compile Include="Server\ITenantFleet.fs" />
        <Compile Include="Server\IDeployPipeline.fs" />
        <Compile Include="Server\IContainerScheduler.fs" />
        <!-- Phase 185 — the deploy-plane dry-run: the default read-only
             plan/diff helper plus the `PlanDeploy` extension member every
             IDeployPipeline gets for free. Must follow IContainerScheduler
             (it reads observed state through it) and IDeployPipeline (it
             extends it). -->
        <Compile Include="Server\DeployPlanner.fs" />
        <!-- Phase 318 — external-compute broker seam + its no-op default.
             Distinct from IContainerScheduler (which launches and owns a
             container's lifecycle): this hands work to a backend that owns
             its own execution and returns an opaque handle to poll. Value
             types live in Core's Shared/ExternalCompute.fs. -->
        <Compile Include="Server\IExternalComputeDispatcher.fs" />
        <!-- Phase 484 — multi-backend compute fleet. The registry declares
             what each backend serves (profiles DERIVED from the Phase 478
             posture, never separately claimed) and the routing decision is
             a pure function over it; the dispatcher applies it and feeds
             per-backend health / metrics / a /dev/inspect row. Entirely
             opt-in via ComputeFleetCompose.register — registerExternalCompute
             is untouched, so a single-dispatcher deployment is unchanged
             (GP 13). -->
        <Compile Include="Server\IComputeBackendRegistry.fs" />
        <Compile Include="Server\RoutingComputeDispatcher.fs" />
        <!-- Phase 485 — compute-result memoization decorator. Wraps ANY
             dispatcher (including the router above and Phase 451's budget
             decorator) and returns the cached terminal outcome of an
             identical idempotent spec instead of re-dispatching it;
             concurrent duplicates coalesce onto one submit. Opt-in by
             construction — only a spec carrying an Idempotency key is
             memoizable, and a deployment that never constructs the
             decorator is unchanged (GP 13). -->
        <Compile Include="Server\MemoizedComputeDispatcher.fs" />
        <!-- Phase 451 — compute-budget governance. The store seam + its
             blob-backed default, then the shared admit/settle guard and the
             IExternalComputeDispatcher decorator built on it. Before
             ModelFitJobHandler.fs, because the fit-enqueue path is the
             SECOND enforcement point and calls the same guard — a federated
             peer's fit submission reaches only that one, never Submit. -->
        <Compile Include="Server\IComputeBudgetStore.fs" />
        <Compile Include="Server\ComputeBudgetStore.fs" />
        <Compile Include="Server\BudgetedComputeDispatcher.fs" />
        <!-- Phase 320 — external-handle store: routing (handle to job
             run), authentication (the callback secret's hash) and the
             atomic MarkTerminal gate that makes callback-vs-poll
             exactly-once. Also the IExternalCompletionSink seam the
             callback ingress drives a run through, so it compiles before
             JobScheduler.fs (which implements it). -->
        <Compile Include="Server\IExternalHandleStore.fs" />
        <!-- Phase 486 — per-worker signing keys behind the completion
             callback: worker identity to public key, with an approval flow
             and sticky revocation. Before SignedOutcomeVerifier.fs (which
             resolves keys through it) and before ExternalComputeCallback.fs
             (which verifies with it). -->
        <Compile Include="Server\WorkerKeyRegistry.fs" />
        <!-- Phase 486 — the signed-outcome gates: policy, envelope
             verification (BCL es256; ed25519 behind the
             WorkerSignatureVerifier seam), and the typed rejection the
             callback ingress audits. -->
        <Compile Include="Server\SignedOutcomeVerifier.fs" />
        <!-- Phase 26 — single-node default impl of ITenantFleet over
             IEntityStore + IContainerScheduler + IDeployPipeline.
             Per-tenant SemaphoreSlim for serialised state mutations;
             (Region, Slug) compound index for O(1) slug uniqueness. -->
        <Compile Include="Server\EntityStoreTenantFleet.fs" />
        <Compile Include="Server\IDataCatalog.fs" />
        <!-- Phase 30d — deterministic seeded generator for synthetic
             samples; powers IDataCatalog.GetSyntheticSample under the
             ModulePermission.SchemaOnly partner-sandbox role. -->
        <Compile Include="Server\SyntheticSampleGenerator.fs" />
        <Compile Include="Server\DataCatalog.fs" />
        <!-- Phase 30d — canonical real-data-read guard for handlers.
             Refuses SchemaOnly-only callers + emits
             SchemaOnlyAccessAttempted audit. Compiled after AuditLog
             so it can reference IAuditLog as the audit sink. -->
        <Compile Include="Server\SchemaOnlyGuard.fs" />
        <Compile Include="Server\IResultStore.fs" />
        <!-- Phase 447 — declarative seed / fixture-data pack contract
             (ISeedPack + SeedContext + SeedReport). Sits after the store
             interfaces it hands to a pack (IEntityStore / IDataObjectStore /
             IBlobStorage) and before ServerApp.fs (which accumulates packs). -->
        <Compile Include="Server\ISeedPack.fs" />
        <Compile Include="Server\ILineageStore.fs" />
        <Compile Include="Server\ResultStore.fs" />
        <Compile Include="Server\LineageStore.fs" />
        <!-- Phase 524 — read-only provenance chain traversal (grounding ledger v0). -->
        <Compile Include="Server\IProvenanceGraph.fs" />
        <Compile Include="Server\ProvenanceGraph.fs" />
        <!-- Phase 648 — the walk's read-only remoting handler: projects a
             chain onto the Core-tier wire mirrors, routes fact nodes through
             the shipped IFactDisclosureGate at the FactExport surface, and
             refuses an over-cap request rather than truncating it. Directly
             after ProvenanceGraph.fs (its only server-tier dependency);
             consumer-wired, so nothing below composes it. -->
        <Compile Include="Server\ProvenanceApiHandler.fs" />
        <!-- Phase 9i — SDK-wide cross-instance lease primitive
             (IDistributedLock + Lease + the in-process default). Sits
             before every consumer: the job scheduler's per-JobId dispatch
             mutex, the blob-backed Platform-Admin store's read-modify-write
             serialisation, and SDK.Server's DI registration. Depends only
             on ILogger, so it can sit this early. -->
        <Compile Include="Server\IDistributedLock.fs" />
        <Compile Include="Server\InProcessDistributedLock.fs" />
        <Compile Include="Server\IJobStore.fs" />
        <Compile Include="Server\IJobHandler.fs" />
        <Compile Include="Server\IJobScheduler.fs" />
        <!-- Phase 321 — the job-progress-checkpoint seam + its fan-out
             default, plus the ctx.Progress JobContext extension. Before
             JobScheduler.fs (which constructs the sink and pushes the
             ambient reporter around each handler dispatch) and after
             IJobHandler.fs, so a handler file can see ctx.Progress. Needs
             only INotificationChannel / IEventStore / ILogger from Core. -->
        <Compile Include="Server\IJobProgressSink.fs" />
        <!-- Phase 437 — resource-envelope seam adapters: the concurrency
             gate that decorates a budgeted component's IJobHandler, the
             RouteLimit projection that folds a component's declared
             requests-per-minute into the Phase 56 middleware's own policy
             list, and the typed queue-depth admission. Reads the Core
             EnvelopeSignature; adds no hosted service and no dependency.
             After IJobHandler/IJobScheduler (decorates the handler) and
             IMetricsSink (emits the refusal counter); before ServerApp,
             which applies the gate where a module's ComponentId is in
             scope. -->
        <Compile Include="Server\ResourceEnvelopeEnforcement.fs" />
        <!-- Phase 7b — schema-migration IJobHandler binding: long-running
             MigrationPlan executions run through IJobScheduler and survive
             restarts. After IJobHandler/IJobScheduler + IUserSchemaStore. -->
        <Compile Include="Server\SchemaMigrationJobHandler.fs" />
        <!-- Phase 449 — model-fit envelope: core types, provider seam +
             registry, then the fit-run job handler (needs IJobHandler above +
             IAuditLog from Core). Composed by ComposeJobs.registerModelFitting. -->
        <Compile Include="Server\ModelFitTypes.fs" />
        <!-- Phase 482 — dataset declassification (needs DatasetVersionRef from
             ModelFitTypes + IDatasetStore + IAuditLog). The only label-removal
             path: an explicit, audited admin act producing a new unlabelled
             version. -->
        <Compile Include="Server\DatasetProvenanceOps.fs" />
        <Compile Include="Server\IModelFitProvider.fs" />
        <Compile Include="Server\ModelFitJobHandler.fs" />
        <!-- Phase 450 — the EXTERNAL execution binding of the Phase 449 fit
             envelope: the versioned `modelfit/v1` work-spec convention, the
             completion rendezvous a Phase 320 callback resolves, and the
             IModelFitProvider that submits through IExternalComputeDispatcher.
             Compiles after IModelFitProvider.fs (the seam it implements) and
             needs IDatasetStore + IExternalComputeDispatcher +
             IExternalHandleStore + IJobProgressSink, all above. Nothing
             composes it — a deployment wires the worker itself (GP 13). -->
        <Compile Include="Server\ExternalModelFitProvider.fs" />
        <!-- Phase 453 — model registry: governed-artifact types, the seam,
             then the blob-backed default (rides IDataObjectStore + ILineageStore
             above; carries the Phase 449 fit envelope's composite key). -->
        <Compile Include="Server\ModelRegistryTypes.fs" />
        <Compile Include="Server\IModelRegistry.fs" />
        <Compile Include="Server\BlobModelRegistry.fs" />
        <!-- Phase 651 — the registration observer seam: an IModelRegistry
             decorator that invokes declared observers on each successful,
             NON-REPLAY registration, so "a new artifact exists" is a seam
             rather than a moment each consumer has to remember. Compiles
             after BlobModelRegistry.fs because it type-tests the novelty
             capability the default registry declares (a registry that does
             not falls back to a documented pre-read probe). Nothing
             composes it: `decorate` with no observers returns the registry
             it was given, so an un-composed deployment is unchanged
             (GP 11) and allocates nothing (GP 13). -->
        <Compile Include="Server\ModelRegistrationObservers.fs" />
        <!-- Phase 644 — the author-agnostic model-transition seam: one
             entry point serving local UI actions, peer invocations and
             (Phase 645) policy verdicts, so the lifecycle graph, the
             declared-authority check and the attributed record are written
             once. Compiles AFTER IModelRegistry.fs (it wraps that seam) and
             is deliberately independent of the blob default beneath it — it
             judges over the interface, so any registry implementation gets
             the same judgment. Nothing composes it: a deployment that never
             calls `ModelTransition.invoke` keeps the pre-644 path exactly
             (GP 11) and constructs none of this (GP 13). -->
        <Compile Include="Server\ModelTransitionSeam.fs" />
        <!-- Phase 646 — promotion-time provenance transfer. The transfer
             seam lands a final artifact, its opaque spec payload and its
             provenance attachments as ONE recorded act, signs it on
             acceptance through the neutral IPromotedArtifactSigner seam
             (ToolUp.ArtefactSigning fills it — the dependency cannot run
             the other way, GP 1), and reaches the lifecycle graph through
             ModelTransitionSeam.fs rather than restating it. The adapter
             beside it fills Phase 524's IArtifactProvenanceSource over the
             registry, so the provenance walk enumerates attachments as
             chain nodes without ProvenanceGraph.fs (which compiles far
             above) depending on the registry. Nothing composes either: a
             deployment that never accepts a transfer keeps the pre-646
             path exactly (GP 11) and constructs none of it (GP 13). -->
        <Compile Include="Server\ModelArtifactProvenance.fs" />
        <Compile Include="Server\ModelPromotionTransfer.fs" />
        <!-- Phase 599 — batch item execution: the `_platform.modelfit.batchitem`
             IJobHandler (fit envelope + batch-annotated registry registration).
             Consumer-wired like the Phase 454 scoring handler. -->
        <Compile Include="Server\ModelFitBatchItemJobHandler.fs" />
        <!-- Phase 454 — model scoring: the IModelScorer seam + default
             envelope (rides IDatasetStore for the output vintage, the Phase 449
             ArtifactRef / DatasetVersionRef, and the Phase 453 ModelArtifact),
             then the batch IJobHandler over IModelRegistry + IJobScheduler. -->
        <Compile Include="Server\IModelScorer.fs" />
        <Compile Include="Server\ModelScoringJobHandler.fs" />
        <!-- Phase 728 — the opt-in model-execution compose leg (registers
             IModelRegistry, and optionally the scorer / executor policy /
             Phase 651 observers) plus the startup validator that names a
             mounted ModelExecutionApi with no registry composed. Placed
             here: it needs only the model seams above (BlobModelRegistry,
             ModelRegistrationObservers, IModelScorer) and must compile
             before Compose/ComposeConfigValidators.fs, which registers the
             validator, and before ServerApp.fs, whose withModelExecution
             builder folds `register` into the DI graph. -->
        <Compile Include="Server\ComposeModelExecution.fs" />
        <Compile Include="Server\ModelExecutionDepsValidator.fs" />
        <!-- Phase 452 — dataset assembly (transforms-as-data): the spec +
             closed transform DU, then the executor (rides IDatasetStore for
             output + ITimeSeriesStore for range sources; propagates Phase 482
             labels). Algorithm-free plumbing; forge never computes a derived
             value outside the closed aggregate list. -->
        <Compile Include="Server\DatasetAssemblyTypes.fs" />
        <Compile Include="Server\DatasetAssemblyExecutor.fs" />
        <!-- Phase 456 — model evaluation & champion-challenger harness: the
             evaluation types + provider-seam Evaluate extension member, then
             the runner (rides Phase 449/453/454 + IDataObjectStore), the
             opt-in promotion gate, and the evaluation / re-vintage job
             handlers. Nothing composed by default (GP 13). -->
        <Compile Include="Server\ModelEvaluationTypes.fs" />
        <Compile Include="Server\ModelEvaluationRunner.fs" />
        <!-- Phase 645 — declared promotion policies: tolerance predicates
             over score / comparison output decide auto-promote vs queue for
             curation vs reject, and every verdict that moves an artifact is
             executed through the Phase 644 transition seam as
             `PolicyVerdict` (no second state machine). Compiles AFTER
             ModelEvaluationRunner.fs (it reads the Phase 456 track record as
             one of its two metric sources) and after ModelTransitionSeam.fs
             (it drives that seam). Nothing composes it: a deployment that
             never constructs the evaluator keeps the pre-645 path exactly
             (GP 11) and pays nothing (GP 13). -->
        <Compile Include="Server\ModelPromotionPolicy.fs" />
        <Compile Include="Server\JobStore.fs" />
        <Compile Include="Server\CronExpression.fs" />
        <!-- Phase 598 — persisted per-scope OnEvent trigger cursor; before the
             scheduler (startup scan / sweep / flush) and the notify decorator
             (live advance), both of which consume it. -->
        <Compile Include="Server\JobTriggerWatermark.fs" />
        <Compile Include="Server\JobScheduler.fs" />
        <!-- Phase 164 — opt-in TTL sweep for BlobIdempotencyStore. After the
             job substrate (IJobHandler / ScheduledJobDeclaration) it builds on;
             the shared layout stays in Remoting/Idempotency.fs. -->
        <Compile Include="Server\IdempotencySweepJob.fs" />
        <Compile Include="Server\JobSchedulerDiagnosticsContributor.fs" />
