        <!-- Phase 133 — BFF-style server-set auth-cookie reflection
             endpoint (POST / DELETE /api/auth/session). Validates the
             presented bearer via IAuthProvider, then reflects it into an
             HttpOnly; Secure; SameSite=Strict cookie so the JWT leaves
             JS-readable storage. Mounted by BuildRouteHandlers when
             ServerConfig.AuthCookieIssuance = EnabledAuthCookieIssuance. -->
        <Compile Include="Server\AuthSessionHandler.fs" />
        <!-- Phase 57 — prerendered-routes middleware. Maps GET /route to
             PublicPath/route.html when the FAKE Prerender target wrote
             one; no-op when the file is absent. Composed ahead of
             UseStaticFiles so the rewrite short-circuits before the
             SPA index.html fallback. -->
        <Compile Include="Server\Static\PrerenderedRoutesHandler.fs" />
        <!-- Phase 3b.D — SPA shell fallback. Runs after UseStaticFiles
             and serves PublicPath/index.html for any GET that didn't
             match a static file or prerendered route, so OIDC callback
             URLs and SPA deep links don't 404 server-side before the
             SPA's client-side router can take over. -->
        <Compile Include="Server\Static\SpaFallbackMiddleware.fs" />
