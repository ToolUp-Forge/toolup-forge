        <Compile Include="Server\Classification\IFieldClassifier.fs" />
        <Compile Include="Server\Classification\DefaultFieldClassifier.fs" />
        <Compile Include="Server\Classification\ClassificationGate.fs" />
        <Compile Include="Server\NoOpRateLimiter.fs" />
        <Compile Include="Server\InProcessRateLimiter.fs" />
        <Compile Include="Server\IDataExporter.fs" />
        <Compile Include="Server\ErasurePipeline.fs" />
        <!-- Phase 9h.A — IBackgroundExportStore interface ahead of the
