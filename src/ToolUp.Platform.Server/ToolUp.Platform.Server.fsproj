             infra files so all transitive dependencies have already loaded). -->
        <Compile Include="Server\InProcessOAuthTokenRefresher.fs" />
        <Compile Include="Server\OAuthRefreshJobHandler.fs" />
        <Compile Include="Server\Infra\FileSecretStore.fs" />
        <Compile Include="Server\Infra\EncryptedSecretStore.fs" />
        <!-- Phase 11.G — `SecretStore.fromEnv` (env-var-driven dispatch
             with cloud-companion resolver list). -->
        <Compile Include="Server\Infra\SecretStoreFromEnv.fs" />
        <!-- Phase 176 — transient-fault decorator substrate: the
             TransientFaultPolicy record + shared runner (retry / breaker /
             per-call timeout), then the IBlobStorage / ISecretStore
             decorators that route every method through it. Before
             SDK.Server (compose applies them) + ServerApp (the builder
             carries the ResilienceMode opt-in). Identity policy = byte-for-
             byte pass-through (GP 11/13). -->
        <Compile Include="Server\Infra\TransientFaultPolicy.fs" />
        <Compile Include="Server\Infra\ResilientBlobStorage.fs" />
        <Compile Include="Server\Infra\ResilientSecretStore.fs" />
        <Compile Include="Server\IBlobEncryptionKeyResolver.fs" />
        <Compile Include="Server\EncryptedBlobStorage.fs" />
        <Compile Include="Server\SingleKeyResolver.fs" />
        <Compile Include="Server\AuditLog.fs" />
        <!-- Phase 120 — default IAuthAuditHook (writes AuthorizationDenied
             via IAuditLog + per-(route,subject) flood guard). After
             AuditLog.fs (uses the audit registry); before the emission
             middlewares + the /dev/auth-denials read handler. -->
        <Compile Include="Server\AuthAuditHook.fs" />
        <!-- Phase 30a — signed module artefact substrate (canonical-bytes
             encoder, signer/verifier interfaces + Ed25519 defaults,
             blob-backed trusted-publisher key store). Crypto via
             BouncyCastle.Cryptography (MIT) — .NET 10 BCL surfaces only
             post-quantum primitives, not Ed25519. -->
        <Compile Include="Server\ArtifactCanonical.fs" />
        <Compile Include="Server\IArtifactSigner.fs" />
        <Compile Include="Server\IArtifactVerifier.fs" />
        <Compile Include="Server\IPublisherKeyStore.fs" />
        <Compile Include="Server\Ed25519ArtifactSigner.fs" />
        <Compile Include="Server\Ed25519ArtifactVerifier.fs" />
        <Compile Include="Server\BlobBackedPublisherKeyStore.fs" />
        <!-- Phase 41 — data-classification substrate (server tier). After
