<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Generic CalDAV ICalendarBridge for ToolUp.Scheduling — RFC 4791 PROPFIND / REPORT / PUT / DELETE over BCL HttpClient, credentials from ISecretStore. No vendor SDK, no OAuth registration.</Description>
    <PackageTags>fsharp;sdk;calendar;caldav;scheduling;bridge</PackageTags>
  </PropertyGroup>
  <!-- Phase 20a CalDAV calendar-bridge companion. ProjectReferences
       only: the wire format is iCalendar (ToolUp.Scheduling.Core) and
       the transport is BCL HttpClient behind the platform's egress
       policy handler (ToolUp.Platform.Server). Zero paid dependencies,
       zero external gate. -->
  <ItemGroup>
    <Compile Include="CalDAVCalendarBridge.fs" />
    <Compile Include="CalDAVCalendarBridgeHealth.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Scheduling.Core\ToolUp.Scheduling.Core.fsproj" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK; System.Xml.Linq ships in
       the BCL. -->
</Project>
