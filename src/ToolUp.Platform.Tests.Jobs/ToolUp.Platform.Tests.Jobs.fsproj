<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <!-- The Jobs pack: the lists whose test files reach the Jobs part and no later one.
         The test sources stay under src/ToolUp.Platform.Tests/ and this project
         compiles them from there, because other packs source-link them and
         their citations and __SOURCE_DIRECTORY__ paths must not move. Which
         file is in which pack, and why: docs/migrations/1194-platform-pack-partition.md. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IJobStoreContract.fs" Link="Contracts\IJobStoreContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IOAuthStateStoreContract.fs" Link="Contracts\IOAuthStateStoreContract.fs" />
