<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Algorithms Client — ToolUp.Remoting proxy for the read-only algorithm catalog. Sparse by design: the client enumerates what a deployment can compute; execution stays server-side. Depends on ToolUp.Platform.Client + ToolUp.Algorithms.Core.</Description>
        <PackageTags>fsharp;fable;feliz;elmish;sdk;client;algorithms</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Client\ToolUp.Platform.Client.fsproj" />
        <ProjectReference Include="..\ToolUp.Algorithms.Core\ToolUp.Algorithms.Core.fsproj" />
    </ItemGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
         under fable/. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.Algorithms\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Client\AlgorithmsClient.fs" />
    </ItemGroup>
    <!-- Fable.* / Feliz / FSharp.Core resolved transitively via
         ToolUp.Platform.Client + the .NET SDK. -->
</Project>
