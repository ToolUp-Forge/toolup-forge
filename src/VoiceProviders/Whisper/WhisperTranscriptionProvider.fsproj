<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.VoiceProviders.Whisper</PackageId>
    <AssemblyName>ToolUp.VoiceProviders.Whisper</AssemblyName>
    <Description>OpenAI Whisper ITranscriptionProvider for ToolUp.Voice. Batch speech-to-text over the audio/transcriptions endpoint; BYOK — reads openai-api-key from ISecretStore. HttpClient only, no vendor SDK.</Description>
    <PackageTags>fsharp;sdk;voice;speech;transcription;whisper;openai;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WhisperTranscriptionProvider.fs" />
    <Compile Include="WhisperTranscriptionProviderHealth.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Voice.Core\ToolUp.Voice.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. System.Net.Http +
       System.Text.Json ship in the BCL — no vendor SDK (GP 1). -->
</Project>
