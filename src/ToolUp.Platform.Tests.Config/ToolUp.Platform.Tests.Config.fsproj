        <Compile Include="..\ToolUp.Platform.Tests\InProcess\RateLimitConfigValidatorTests.fs" Link="InProcess\RateLimitConfigValidatorTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\ConfigBoundsValidatorTests.fs" Link="InProcess\ConfigBoundsValidatorTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\LocalSecretFilePermissionsValidatorTests.fs" Link="InProcess\LocalSecretFilePermissionsValidatorTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\IdentitySanitiserTests.fs" Link="InProcess\IdentitySanitiserTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\I18nInfrastructureTests.fs" Link="InProcess\I18nInfrastructureTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\UserClaimsTests.fs" Link="InProcess\UserClaimsTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\ServerConfigFromEnvTests.fs" Link="InProcess\ServerConfigFromEnvTests.fs" />
