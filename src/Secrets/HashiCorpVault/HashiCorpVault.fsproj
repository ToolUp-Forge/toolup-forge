<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Secrets.HashiCorpVault</PackageId>
    <AssemblyName>ToolUp.Secrets.HashiCorpVault</AssemblyName>
    <Description>HashiCorp Vault ISecretStore companion for ToolUp.Platform — BCL HttpClient only, no vendor SDK.</Description>
    <PackageTags>fsharp;sdk;secrets;vault;hashicorp;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="VaultSecretStore.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
