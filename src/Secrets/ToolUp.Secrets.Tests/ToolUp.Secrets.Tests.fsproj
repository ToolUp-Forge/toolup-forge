<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <!-- Phase 1197 - the ISecretStore companions (AWS Secrets Manager, Azure Key Vault, GCP Secret Manager, HashiCorp Vault). Hosts ISecretStoreContract against each; the live arms are env-gated and report Pending without their backend.

         A companion family's tests live beside the family and build against
         its closure, not the Platform pack's. The contract packs the family
         conforms to are SOURCE-LINKED from ToolUp.Platform.Tests (Link=…), so
         there is one copy of each law and nothing to drift; the linked
         support files are the closure the moved cases compile against. -->
    <ItemGroup>
        <Compile Include="..\..\ToolUp.Platform.Testing\Testing\Recording.fs" Link="Testing\Recording.fs" />
        <Compile Include="..\..\ToolUp.Platform.Testing\Testing\TempDir.fs" Link="Testing\TempDir.fs" />
        <Compile Include="..\..\ToolUp.Platform.Testing\Testing\Loggers.fs" Link="Testing\Loggers.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Contracts\ISecretStoreContract.fs" Link="Contracts\ISecretStoreContract.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Contracts\InMemoryBlobStorage.fs" Link="Contracts\InMemoryBlobStorage.fs" />
        <Compile Include="AwsSecretsManagerSecretStoreTests.fs" />
        <Compile Include="AzureKeyVaultSecretStoreTests.fs" />
        <Compile Include="GcpSecretManagerSecretStoreTests.fs" />
        <Compile Include="HashiCorpVaultSecretStoreTests.fs" />
        <Compile Include="ServerAppSecretStoreTests.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\AwsSecretsManager\AwsSecretsManager.fsproj" />
        <ProjectReference Include="..\AzureKeyVault\AzureKeyVault.fsproj" />
        <ProjectReference Include="..\GcpSecretManager\ToolUp.Secrets.GcpSecretManager.fsproj" />
        <ProjectReference Include="..\HashiCorpVault\HashiCorpVault.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
</Project>
