<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Secrets.AwsSecretsManager</PackageId>
    <AssemblyName>ToolUp.Secrets.AwsSecretsManager</AssemblyName>
    <Description>AWS Secrets Manager ISecretStore companion for ToolUp.Platform.</Description>
    <PackageTags>fsharp;sdk;secrets;aws;secrets-manager;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AwsSecretsManagerSecretStore.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="AWSSDK.SecretsManager" />
  </ItemGroup>
</Project>
