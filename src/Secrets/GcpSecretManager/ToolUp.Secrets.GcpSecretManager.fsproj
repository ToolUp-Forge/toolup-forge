<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Secrets.GcpSecretManager</PackageId>
    <AssemblyName>ToolUp.Secrets.GcpSecretManager</AssemblyName>
    <Description>GCP Secret Manager ISecretStore companion for ToolUp.Platform.</Description>
    <PackageTags>fsharp;sdk;secrets;gcp;google-cloud;secret-manager;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GcpSecretManagerSecretStore.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" />
  </ItemGroup>
</Project>
