<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Cloud.Aws</PackageId>
    <Description>AWS cloud umbrella for ToolUp.Platform — transitively pulls ToolUp.Storage.AwsS3, ToolUp.Secrets.AwsSecretsManager, ToolUp.AuditSinks.S3Archive, ToolUp.Metrics.OpenTelemetry, plus the OTLP exporter for sending metrics to an ADOT collector. One PackageReference replaces five per-cloud entries.</Description>
    <PackageTags>fsharp;sdk;cloud;aws;umbrella;meta-package</PackageTags>
    <!-- Phase 16c (2026-06-01) — empty meta-package. Same shape as
         ToolUp.Sdk: no F# source, skip empty-assembly artefact, skip
         symbols, suppress NU5128. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Storage\AwsS3Storage\AwsS3Storage.fsproj" />
    <ProjectReference Include="..\..\Secrets\AwsSecretsManager\AwsSecretsManager.fsproj" />
    <ProjectReference Include="..\..\AuditSinks\S3Archive\ToolUp.AuditSinks.S3Archive.fsproj" />
    <ProjectReference Include="..\..\Metrics\OpenTelemetry\ToolUp.Metrics.OpenTelemetry.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADOT (AWS Distro for OpenTelemetry) is the AWS-recommended
         metrics path — run an ADOT collector and ship OTLP to it; the
         collector exports to CloudWatch. The umbrella ships the OTLP
         exporter; the consumer's Program.fs calls .AddOtlpExporter(),
         optionally gated on TOOLUP_OTEL_EXPORTER=cloudwatch. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
</Project>
