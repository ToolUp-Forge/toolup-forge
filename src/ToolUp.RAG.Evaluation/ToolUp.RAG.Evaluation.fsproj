<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ToolUp.RAG.Evaluation</RootNamespace>
    <DynamicFileNestingEnabled>false</DynamicFileNestingEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EvalTypes.fs" />
    <Compile Include="Metrics.fs" />
    <Compile Include="FixtureLoader.fs" />
    <Compile Include="RetrievalEval.fs" />
    <!-- Phase 122 — ablation gate: BEIR-subset derivation + the
         per-configuration recall/nDCG + determinism gate. -->
    <Compile Include="BeirSubset.fs" />
    <Compile Include="Ablation.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
<None Include="fixtures\platform-readme.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 501 — the morphology fixture for the analyzer comparison. -->
    <None Include="fixtures\eval-morphology.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- SDK server infrastructure (interfaces + storage + logger) — wired via
       <ProjectReference> below. AI + LocalEmbeddingProvider companion sources
       similarly DLL-referenced (Phase 11.B follow-up cutover). -->
  <Import Project="..\ToolUp.Platform\ToolUp.Platform.Server.props" />
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\ToolUp.AI.Core\ToolUp.AI.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
    <ProjectReference Include="..\ToolUp.RAG.Core\ToolUp.RAG.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.RAG.Server\ToolUp.RAG.Server.fsproj" />
    <ProjectReference Include="..\EmbeddingProviders\Local\LocalEmbeddingProvider.fsproj" />
    <!-- Phase 122 — the ablation gate's HNSW-vs-flat configuration. -->
    <ProjectReference Include="..\VectorStores\Hnsw\HnswVectorStore.fsproj" />
    <!-- Phase 501 — the analyzer-selection arms, so the harness can MEASURE a
         language analyzer's retrieval-quality claim rather than assert it. -->
    <ProjectReference Include="..\SparseIndices\Snowball\ToolUp.SparseIndices.Snowball.fsproj" />
    <ProjectReference Include="..\SparseIndices\Cjk\ToolUp.SparseIndices.Cjk.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- 0.4.4 — ToolUp.Remoting.{Giraffe,Json} flow transitively from
         ToolUp.Platform.Server after the fold. -->
    <PackageReference Include="Giraffe" />
  </ItemGroup>
</Project>
