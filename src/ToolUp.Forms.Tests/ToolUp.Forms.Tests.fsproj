<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <!-- Phase 11.B follow-up Forms cross-tier cutover (2026-05-08): replaced
         <Compile Link> entries that source-injected Forms + Platform server
         files with <ProjectReference> entries to the matching DLLs. The
         tests now exercise the production companion DLLs directly. -->
    <ItemGroup>
        <Compile Include="InProcess\InMemoryEntityStore.fs" />
        <Compile Include="InProcess\InMemoryAuditLog.fs" />
        <Compile Include="Contracts\IFormStoreContract.fs" />
        <Compile Include="Contracts\IWorkflowEngineContract.fs" />
        <Compile Include="Contracts\IActionLedgerContract.fs" />
        <Compile Include="Contracts\IShareTokenRateLimiterContract.fs" />
        <Compile Include="InProcess\FormStoreTests.fs" />
        <Compile Include="InProcess\WorkflowEngineTests.fs" />
        <Compile Include="InProcess\WorkedExampleTests.fs" />
        <Compile Include="InProcess\AnalyserCacheTests.fs" />
        <Compile Include="InProcess\WorkflowEngineDurabilityTests.fs" />
        <Compile Include="InProcess\FormsServerHygieneTests.fs" />
        <Compile Include="InProcess\PublishableHardeningTests.fs" />
        <Compile Include="InProcess\PublicSubmitSurfaceTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.Forms.Core\ToolUp.Forms.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Forms.Server\ToolUp.Forms.Server.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
</Project>
