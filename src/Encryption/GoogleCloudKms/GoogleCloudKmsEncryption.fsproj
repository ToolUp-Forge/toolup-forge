<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Encryption.GoogleCloudKms</PackageId>
    <AssemblyName>ToolUp.Encryption.GoogleCloudKms</AssemblyName>
    <Description>GCP Cloud KMS-backed IBlobEncryptionKeyResolver for ToolUp.Platform — envelope encryption (per-blob AES-256 data keys Encrypt/Decrypt'd by a KMS CryptoKey that never leaves GCP). Server-only companion.</Description>
    <PackageTags>fsharp;sdk;encryption;kms;gcp;google-cloud;envelope-encryption;key-management</PackageTags>
  </PropertyGroup>
  <!-- Phase 22a — KMS-backed encryption resolver. Mirrors src/Encryption/AwsKms/
       packaging. Server-only: IBlobEncryptionKeyResolver is a server-tier
       interface. -->
  <ItemGroup>
    <Compile Include="GoogleCloudKmsKeyResolver.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Google.Cloud.Kms.V1" />
  </ItemGroup>
</Project>
