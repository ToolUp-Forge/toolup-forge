<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Encryption.AwsKms</PackageId>
    <AssemblyName>ToolUp.Encryption.AwsKms</AssemblyName>
    <Description>AWS KMS-backed IBlobEncryptionKeyResolver for ToolUp.Platform — envelope encryption (per-blob AES-256 data keys minted + unwrapped by a KMS CMK that never leaves AWS). Server-only companion.</Description>
    <PackageTags>fsharp;sdk;encryption;kms;aws;envelope-encryption;key-management</PackageTags>
  </PropertyGroup>
  <!-- Phase 22a — KMS-backed encryption resolver. Mirrors src/Storage/<Provider>/
       packaging. Server-only: IBlobEncryptionKeyResolver is a server-tier
       interface. -->
  <ItemGroup>
    <Compile Include="AwsKmsKeyResolver.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="AWSSDK.KeyManagementService" />
  </ItemGroup>
</Project>
