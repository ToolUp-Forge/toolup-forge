<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Encryption.AzureKeyVault</PackageId>
    <AssemblyName>ToolUp.Encryption.AzureKeyVault</AssemblyName>
    <Description>Azure Key Vault-backed IBlobEncryptionKeyResolver for ToolUp.Platform — envelope encryption (per-blob AES-256 data keys wrapped/unwrapped by a Key Vault KEK that never leaves the vault). Server-only companion.</Description>
    <PackageTags>fsharp;sdk;encryption;kms;azure;key-vault;envelope-encryption;key-management</PackageTags>
  </PropertyGroup>
  <!-- Phase 22a — KMS-backed encryption resolver. Mirrors src/Encryption/AwsKms/
       packaging. Server-only: IBlobEncryptionKeyResolver is a server-tier
       interface. -->
  <ItemGroup>
    <Compile Include="AzureKeyVaultKeyResolver.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
  </ItemGroup>
</Project>
