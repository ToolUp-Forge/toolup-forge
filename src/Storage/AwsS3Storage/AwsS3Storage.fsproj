<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Storage.AwsS3</PackageId>
    <AssemblyName>ToolUp.Storage.AwsS3</AssemblyName>
    <Description>AWS S3 IBlobStorage companion for ToolUp.Platform.</Description>
    <PackageTags>fsharp;sdk;storage;aws;s3;blob-storage;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Phase 2c: the credential-rejection classifier (authFailureStatus) is
         internal, being a per-SDK detail rather than public surface, and
         BlobStorageAuthAuditTests proves it against real SDK exception
         instances. Same mechanism ToolUp.Platform.Server uses for its own
         internal codec registry. -->
    <InternalsVisibleTo Include="ToolUp.Platform.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AwsS3Storage.fs" />
    <Compile Include="AwsS3StorageHealth.fs" />
    <Compile Include="AwsS3EncryptionAtRestValidator.fs" />
</ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>
</Project>
