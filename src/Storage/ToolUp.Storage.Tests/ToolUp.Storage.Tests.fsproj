<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <!-- Phase 1197 - the IBlobStorage companions (AWS S3, Azure Blob, Google Cloud Storage). Hosts IBlobStorageContract and IConditionalBlobStorageContract against each backend; the live arms are env-gated and report Pending without their backend.

         A companion family's tests live beside the family and build against
         its closure, not the Platform pack's. The contract packs the family
         conforms to are SOURCE-LINKED from ToolUp.Platform.Tests (Link=…), so
         there is one copy of each law and nothing to drift; the linked
         support files are the closure the moved cases compile against. -->
    <ItemGroup>
        <Compile Include="..\..\ToolUp.Platform.Tests\Support\TestScope.fs" Link="Support\TestScope.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Contracts\IBlobStorageContract.fs" Link="Contracts\IBlobStorageContract.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Contracts\InMemoryBlobStorage.fs" Link="Contracts\InMemoryBlobStorage.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Contracts\IConditionalBlobStorageContract.fs" Link="Contracts\IConditionalBlobStorageContract.fs" />
        <Compile Include="AwsS3StorageTests.fs" />
        <Compile Include="AzureBlobStorageTests.fs" />
        <Compile Include="GoogleCloudStorageTests.fs" />
        <Compile Include="BlobStorageAuthAuditTests.fs" />
        <Compile Include="ConditionalBlobStorageTests.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\ToolUp.Facts.Server\ToolUp.Facts.Server.fsproj" />
        <ProjectReference Include="..\..\ToolUp.RAG.Server\ToolUp.RAG.Server.fsproj" />
        <ProjectReference Include="..\..\ToolUp.KnowledgeBase.Server\ToolUp.KnowledgeBase.Server.fsproj" />
        <ProjectReference Include="..\..\ToolUp.Platform.Testing\ToolUp.Platform.Testing.fsproj" />
        <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\AwsS3Storage\AwsS3Storage.fsproj" />
        <ProjectReference Include="..\AzureBlobStorage\AzureBlobStorage.fsproj" />
        <ProjectReference Include="..\GoogleCloudStorage\GoogleCloudStorage.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
</Project>
