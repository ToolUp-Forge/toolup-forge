<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.ArtefactSigning.GoogleCloudKms</PackageId>
    <AssemblyName>ToolUp.ArtefactSigning.GoogleCloudKms</AssemblyName>
    <Description>GCP Cloud KMS-backed IArtefactSigner for ToolUp.ArtefactSigning — EC-P256 (ES256, EC_SIGN_P256_SHA256) detached-JWS artefact signing where the private key never leaves GCP KMS (the signer hashes locally and calls AsymmetricSign over the digest). Server-only companion.</Description>
    <PackageTags>fsharp;sdk;signing;jws;ecdsa;kms;gcp;google-cloud;compliance;non-repudiation</PackageTags>
  </PropertyGroup>
  <!-- Phase 160 / 40 / 22a — KMS-signing flavour. Mirrors
       src/ArtefactSigning/AwsKms/ packaging. Server-only: IArtefactSigner
       is a server-tier interface. GP 1 — the Google SDK dependency is
       isolated to this companion; it never reaches ToolUp.ArtefactSigning. -->
  <ItemGroup>
    <Compile Include="GoogleCloudKmsArtefactSigner.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.ArtefactSigning\ArtefactSigning.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Google.Cloud.Kms.V1" />
  </ItemGroup>
</Project>
