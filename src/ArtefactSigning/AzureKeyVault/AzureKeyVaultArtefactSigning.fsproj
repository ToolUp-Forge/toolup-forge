<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.ArtefactSigning.AzureKeyVault</PackageId>
    <AssemblyName>ToolUp.ArtefactSigning.AzureKeyVault</AssemblyName>
    <Description>Azure Key Vault-backed IArtefactSigner for ToolUp.ArtefactSigning — EC-P256 (ES256) detached-JWS artefact signing where the private key never leaves Azure Key Vault (the signer hashes locally and calls Key Vault Sign over the digest). Server-only companion.</Description>
    <PackageTags>fsharp;sdk;signing;jws;ecdsa;kms;azure;key-vault;compliance;non-repudiation</PackageTags>
  </PropertyGroup>
  <!-- Phase 160 / 40 / 22a — Key-Vault-signing flavour. Mirrors
       src/ArtefactSigning/AwsKms/ packaging. Server-only: IArtefactSigner
       is a server-tier interface. GP 1 — the Azure SDK dependency is
       isolated to this companion; it never reaches ToolUp.ArtefactSigning. -->
  <ItemGroup>
    <Compile Include="AzureKeyVaultArtefactSigner.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.ArtefactSigning\ArtefactSigning.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
  </ItemGroup>
</Project>
