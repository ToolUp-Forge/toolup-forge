<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <!-- The Remoting pack: the lists whose test files reach the Remoting part and no later one, with the lists that reach no server part at all (the earliest pack, whose closure is the smallest).
         The test sources stay under src/ToolUp.Platform.Tests/ and this project
         compiles them from there, because other packs source-link them and
         their citations and __SOURCE_DIRECTORY__ paths must not move. Which
         file is in which pack, and why: docs/migrations/1194-platform-pack-partition.md. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- Remoting\WireCorpus.fs compiles its server-tier half only where this is defined. -->
        <DefineConstants>$(DefineConstants);TOOLUP_WIRE_CORPUS_DOTNET</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
