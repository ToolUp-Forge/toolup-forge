<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Platform Testing — unit-test infrastructure for ToolUp modules. In-memory fakes for every SDK interface, ModuleHarness for Elmish testing, ServerHarness for HTTP-free API tests, DataTypeTestKit for Detect/Process assertions, plus a DEBUG-only ModuleHotReload watcher. Built on Expecto.</Description>
        <PackageTags>fsharp;sdk;testing;expecto;fakes</PackageTags>
    </PropertyGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers under fable/. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs;**\*.svg" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\ToolUp.Platform\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Testing\Fakes.fs" />
        <!-- Phase 180 — axe-style accessibility assertions over a rendered
             node tree (BCL-only, renderer-agnostic). Compiled BEFORE
             ModuleHarness so its `AssertAccessible` member can reference
             the `Accessibility` types. -->
        <Compile Include="Testing\AccessibilityAssertions.fs" />
        <Compile Include="Testing\ModuleHarness.fs" />
        <!-- Testing\ViewMount.fs is DELIBERATELY absent from this list.
             It is the jsdom + react-dom implementation of the
             `ModuleHarness.AssertAccessibleView` mount seam, and it ships
             the only way it can without dragging npm packages into a
             compiled SDK surface: `Content`-packed under `fable/` by the
             glob above, never compiled here. A Fable consumer opts in
             with its own `<Compile Include="…\Testing\ViewMount.fs" />`
             (as it already does for AccessibilityAssertions.fs) plus a
             `jsdom` devDependency; a consumer that does not emits nothing
             from it and needs neither (GP 13). Compiling it here would
             also be impossible on its own terms — the file is Fable-only
             (`[<Import>]` / `[<Emit>]`) and has no .NET meaning. See its
             header for the full rationale. -->

        <Compile Include="Testing\ServerHarness.fs" />
        <Compile Include="Testing\DataTypeTestKit.fs" />
        <Compile Include="Testing\ModuleHotReload.fs" />
        <!-- Phase 203 — hydration-parity conformance harness (BCL-only). -->
        <Compile Include="Testing\HydrationParity.fs" />
        <!-- Phase 277 — hosted-tree a11y conformance harness (BCL-only): checks
             a rendered hosted fragment for unlabelled controls, missing roles
             on interaction sites, heading-order skips, and focus-order breaks.
             Modelled on HydrationParity; consumes the fragment string so any
             tree language (the ToyNode witness included) is checkable. -->
        <Compile Include="Testing\HostedTreeA11y.fs" />
        <!-- Phase 205 — fault-injecting IBlobStorage decorator (chaos/
             fault-injection test kit): truncated / corrupt / garbage reads,
             torn / dropped / failing writes, a widen-able read→write gap and
             a before-upload race hook. Inert with no faults registered. -->
        <Compile Include="Testing\FaultInjectingBlobStorage.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Client\ToolUp.Platform.Client.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
        <!-- 0.4.3 — ToolUp.Elmish was folded into ToolUp.Platform.Client;
             the runtime arrives transitively through the
             ToolUp.Platform.Client ProjectReference above. -->
    </ItemGroup>
</Project>
