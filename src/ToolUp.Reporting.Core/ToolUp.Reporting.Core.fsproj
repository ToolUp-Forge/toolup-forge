<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>ToolUp.Reporting.Core</PackageId>
        <Description>ToolUp.Reporting Core — shared types (ReportTemplate / PlaceholderSchema / RenderError / TemplateFormat DU) + IReportRenderer interface + the zero-dep MarkdownRenderer + HtmlRenderer. The minimum surface a Reporting consumer needs.</Description>
        <PackageTags>fsharp;sdk;types;reporting;document-generation</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\ToolUp.Reporting\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="ReportingTypes.fs" />
        <!-- Phase 647 — the deck-export routing posture + the chart-artifact
             handoff. Both sit above ReportingTypes (they name TemplateFormat /
             RenderError) and below the renderers, which do not depend on
             them. -->
        <Compile Include="DeckExport.fs" />
        <Compile Include="ChartArtifact.fs" />
        <!-- Phase 650 — the export bundle pairs a narrative document with
             the artifacts its chart blocks render to, so it sits directly
             above the handoff it renders through. -->
        <Compile Include="ChartExportBundle.fs" />
        <Compile Include="IReportRenderer.fs" />
        <Compile Include="PlaceholderSubstitution.fs" />
        <Compile Include="MarkdownRenderer.fs" />
        <Compile Include="HtmlRenderer.fs" />
    </ItemGroup>
</Project>
