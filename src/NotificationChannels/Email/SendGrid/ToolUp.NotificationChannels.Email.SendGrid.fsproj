<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>SendGrid transactional-email INotificationSink for ToolUp.Platform — pure HTTP REST against api.sendgrid.com; API key from ISecretStore.</Description>
    <PackageTags>fsharp;sdk;notifications;email;sendgrid;sink</PackageTags>
  </PropertyGroup>
  <!-- Phase 6f SendGrid INotificationSink companion. -->
  <ItemGroup>
    <Compile Include="SendGridNotificationSink.fs" />
    <Compile Include="SendGridNotificationSinkHealth.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
