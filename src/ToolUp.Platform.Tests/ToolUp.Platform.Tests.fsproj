             decorator companion, exercised by the D.8 integration tests. -->
        <ProjectReference Include="..\ShareTokenStoreDecorators\RevokeOnIssuerRemoved\ToolUp.ShareTokenStoreDecorators.RevokeOnIssuerRemoved.fsproj" />
