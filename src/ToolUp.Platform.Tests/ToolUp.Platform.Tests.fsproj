<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- Remoting\WireCorpus.fs is source-linked into
             ToolUp.AI.Client.Tests so the Fable parity leg compares against
             the same declaration this pack does. Its encoders, its generator
             and its filesystem half need the server tier and this pack's own
             Support\CorpusAnchor.fs, neither of which that project has, and
             `#if !FABLE_COMPILER` does NOT express that: the Fable project is
             also an ordinary net10.0 project in the solution, so a plain
             `dotnet build` compiles the file there with FABLE_COMPILER
             undefined. This define is the honest condition — "the consuming
             project has the server tier" — and only this project declares it. -->
        <DefineConstants>$(DefineConstants);TOOLUP_WIRE_CORPUS_DOTNET</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <!-- The residue pack: the lists whose test files reach the umbrella (Compose,
         Lifecycle, Files) or a companion built on it. The lists that reach only a
         server part are in that part's pack, and the approval gate in its own
         (docs/migrations/1194-platform-pack-partition.md). Sources those packs
         compile stay here; this project compiles only its own and the helpers
         they use. -->
