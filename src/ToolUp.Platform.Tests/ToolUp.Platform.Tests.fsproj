    </ItemGroup>
    <!-- The mixed-dimension fixture JSON, co-located with the
         existing eval-baseline.json in the RAG.Evaluation project. Linked
         into Tests' output so the loader finds it at runtime. -->
    <ItemGroup>
        <None Include="..\ToolUp.RAG.Evaluation\fixtures\eval-mixed-dim.json"
              Link="fixtures\eval-mixed-dim.json"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <!-- The published SPDX 2.3 / CycloneDX 1.6 JSON schemas,
         vendored verbatim so the SBOM conformance pack validates offline
         against the formats' own definitions rather than a local
         paraphrase. Provenance, upstream tags, licences and hashes are in
         the fixture directory's README. Test-tier only — nothing here
         reaches a packable assembly. -->
    <ItemGroup>
        <None Include="fixtures\sbom-schemas\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <!-- The evidence-chain break-injection corpus. ONE home,
         at the repo-root tests/fixtures/ tree, linked into the runner's
         output so the pack reads the same files a reader browses rather
         than a second copy that could drift from them. Test-tier only —
         nothing here reaches a packable assembly. -->
    <ItemGroup>
        <None Include="..\..\tests\fixtures\evidence-chain\*.json"
              Link="fixtures\evidence-chain\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
        <PackageReference Include="StackExchange.Redis" />
        <PackageReference Include="MailKit" />
        <PackageReference Include="WebPush" />
        <PackageReference Include="HNSW" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="System.Reflection.MetadataLoadContext" />
        <!-- JSON Schema evaluator for the SBOM conformance
             pack. Test-tier only; never reaches a shipped package (GP 1 /
             GP 13). Rationale + version pin in Directory.Packages.props. -->
        <PackageReference Include="JsonSchema.Net" />
        <!-- The linux-x64 SkiaSharp native, so the
             `IAssetStore` contract pack (which mints real PNGs through
             SkiaSharp) runs on a Linux CI runner instead of erroring
             out ten cases with `DllNotFoundException: libSkiaSharp`.
             Deliberately UNCONDITIONAL rather than
             `Condition="$([MSBuild]::IsOSPlatform('Linux'))"`: a
             conditional reference makes restore resolve a different
             graph per OS, so a green Windows build would stop proving
             the Linux one even restores, and the CI NuGet cache key
             (hashed over the fsprojs) would no longer describe what was
             restored. The cost on a non-Linux dev box is a few MB of
             unused natives in a test project's output. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    </ItemGroup>
</Project>
