        <!-- Phase 39 — asset-store contract pack + InProcess binding. -->
        <ProjectReference Include="..\ToolUp.AssetStore\ToolUp.AssetStore.fsproj" />
        <!-- Phase 59 — IConsentProvider lives in ToolUp.Platform.Client
             (consent decisions are browser-local). The contract pack
             tests the portable .NET-reachable surface against the
