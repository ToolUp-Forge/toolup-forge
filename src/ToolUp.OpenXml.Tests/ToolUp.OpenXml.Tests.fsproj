<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Fixtures.fs" />
        <!-- Phase 206 — the round-trip fidelity corpus: the fixture
             builders and the golden gate, ahead of every pack that
             consumes them. The committed goldens beside them are read
             from the SOURCE tree at run time (resolved from the test
             assembly path), so they are deliberately not copied to the
             output directory — a regeneration must rewrite the files
             under review, not a build artefact. -->
        <Compile Include="Corpus\CorpusFixtures.fs" />
        <Compile Include="Corpus\Goldens.fs" />
        <Compile Include="InProcess\ImportTests.fs" />
        <Compile Include="InProcess\RoundTripTests.fs" />
        <Compile Include="InProcess\CustomPartTests.fs" />
        <Compile Include="InProcess\RevisionTests.fs" />
        <!-- Phase 576 — figure emission (raster + native SVG), the
             ISvgRasterizer seam, the byte-determinism property, and the
             proof that this package carries no rendering engine. That
             last one is why the pack deliberately does NOT reference the
             rasteriser companion: the strip-imports evidence is the
             whole suite passing without it in the process. -->
        <Compile Include="InProcess\FigureTests.fs" />
        <Compile Include="InProcess\KnowledgeBaseTests.fs" />
        <Compile Include="RoundTripFidelityTests.fs" />
        <!-- Phase 722 — the unregistered-[<Tests>]-list guard, source-linked from
             ToolUp.Platform.Tests so there is one implementation. -->
        <Compile Include="..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.OpenXml\ToolUp.OpenXml.fsproj" />
        <!-- Phase 124 — the KB default-path regression fixtures drive
             `ServerExtractors.extractChunks` directly (via the
             InternalsVisibleTo grant in the KB Server fsproj) to pin
             the flat DOCX output and prove the structured mode is
             opt-in only. -->
        <ProjectReference Include="..\ToolUp.KnowledgeBase.Server\ToolUp.KnowledgeBase.Server.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
        <!-- Fixture builder constructs in-memory documents directly. -->
        <PackageReference Include="DocumentFormat.OpenXml" />
    </ItemGroup>
</Project>
