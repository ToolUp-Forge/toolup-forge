<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>GcsArchive IAuditSink for ToolUp.Platform — gzipped JSONL archive over the abstract IBlobStorage. Production wires GoogleCloudStorage with a bucket-level Retention Policy for compliance-grade WORM.</Description>
    <PackageTags>fsharp;sdk;audit;gcp;google-cloud;gcs;worm;sink</PackageTags>
  </PropertyGroup>
  <!-- Phase 16c GcsArchive IAuditSink companion. No paid deps — the sink
       writes through the abstract IBlobStorage, so deployments wire
       GoogleCloudStorage (Phase 2) for production WORM archives or
       LocalFileStorage for dev. Symmetric with S3Archive and
       AzureBlobArchive — the only differences are naming, defaults, and
       the WORM-mechanism documentation in the README. -->
  <ItemGroup>
    <Compile Include="GcsArchiveAuditSink.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <!-- Newtonsoft.Json + ToolUp.Remoting.Json flow transitively from
       ToolUp.Platform.Server. FSharp.Core is implicit via the .NET SDK. -->
</Project>
