<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>S3Archive IAuditSink for ToolUp.Platform — gzipped JSONL archive over the abstract IBlobStorage. Production wires AwsS3Storage with bucket-level Object Lock for compliance-grade WORM.</Description>
    <PackageTags>fsharp;sdk;audit;s3;worm;sink</PackageTags>
  </PropertyGroup>
  <!-- Phase 9g S3Archive IAuditSink companion. No paid deps — the sink
       writes through the abstract IBlobStorage, so deployments wire
       AwsS3Storage (Phase 2) for production WORM archives or
       LocalFileStorage for dev. -->
  <ItemGroup>
    <Compile Include="S3ArchiveAuditSink.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <!-- ToolUp.Remoting.Json (System.Text.Json-based) flows transitively from
       ToolUp.Platform.Server. FSharp.Core is implicit via the .NET SDK. -->
</Project>
