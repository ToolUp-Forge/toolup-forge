<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Datadog Logs IAuditSink for ToolUp.Platform — POST to /api/v2/logs with API key from ISecretStore.</Description>
    <PackageTags>fsharp;sdk;audit;datadog;sink</PackageTags>
  </PropertyGroup>
  <!-- Phase 9g Datadog Logs IAuditSink companion. No Datadog SDK
       dependency — uses BCL HttpClient directly. -->
  <ItemGroup>
    <Compile Include="DatadogLogsAuditSink.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <!-- Newtonsoft.Json + Fable.Remoting.Json flow transitively from
       ToolUp.Platform.Server. FSharp.Core is implicit via the .NET SDK. -->
</Project>
