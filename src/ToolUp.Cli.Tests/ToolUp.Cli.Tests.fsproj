<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DispatchTests.fs" />
    <Compile Include="DockerEmitTests.fs" />
    <!-- Phase 194 — `k8s emit`: the emitted YAML parsed back and asserted
         structurally for every ProcessProfile × both formats, plus the
         parity cases that pin the CLI's pure-BCL DeployManifest mirror to
         the substrate type it mirrors. -->
    <Compile Include="K8sEmitTests.fs" />
    <Compile Include="StampRoundTripTests.fs" />
    <Compile Include="ModuleAddRemoveTests.fs" />
    <!-- Phase 546 — memberships-doctor ↔ MembershipDoctor parity: the CLI's
         pure-BCL classification + sanitiser mirror pinned to the server
         substrate over one fixture tree (the stamp-round-trip mechanism). -->
    <Compile Include="MembershipsDoctorTests.fs" />
    <!-- Phase 550 — the tenant / user lifecycle verbs: parsing, the
         Result-envelope read, a mocked-transport round-trip per verb, and
         the no-confirmation-bypass assertions. -->
    <Compile Include="TenantUserVerbsTests.fs" />
    <!-- Phase 782 — `describe`. The module fixture is the
         platformsdk-module-packaged template's own server registration,
         compiled from the template's source so the scaffold a consumer
         instantiates is the shape the module form is tested over. -->
    <Compile Include="..\..\templates\platformsdk-module-packaged\src\MyModule\SharedTypes.fs" Link="Fixtures\PackagedModule\SharedTypes.fs" />
    <Compile Include="..\..\templates\platformsdk-module-packaged\src\MyModule\Server.fs" Link="Fixtures\PackagedModule\Server.fs" />
    <Compile Include="DescribeCommandTests.fs" />
    <!-- Phase 722 — the unregistered-[<Tests>]-list guard, source-linked from
         ToolUp.Platform.Tests so there is one implementation. -->
    <Compile Include="..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Cli\ToolUp.Cli.fsproj" />
    <!-- Phase 166 — the stamp round-trip test reads a CLI-written manifest
         through the server-side reader and verifies it with the shipped
         DefaultModuleBindingVerifier (the anti-drift guarantee). Test-only
         references — the `toolup` CLI itself stays pure-BCL. -->
    <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\ToolUp.ArtefactSigning\ArtefactSigning.fsproj" />
    <!-- Phase 782 — the sample module the module form of `describe` must report as
         declaring no ServerModule of its own. -->
    <ProjectReference Include="..\..\samples\HelloWorld\HelloWorld.Module\HelloWorld.Module.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <!-- Phase 194 — the k8s-emit structural assertions parse the emitted
         YAML back into a document tree. Test-only, like the two project
         references above: the `toolup` CLI itself stays pure-BCL. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
</Project>
