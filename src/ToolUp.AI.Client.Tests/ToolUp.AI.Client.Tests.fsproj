<?xml version="1.0" encoding="utf-8"?>
<!--
    ToolUp.AI.Client.Tests — Fable-tier test harness for the AI.Client
    surface.

    The .NET Expecto runners in `ToolUp.Platform.Tests` cannot reach
    AI.Client's MVU code at runtime: module-level Remoting proxy
    constructors (e.g. `let private api = Api.makeProxy<…>` in
    `PlatformAIKeysAdminUI.fs:67`) are reflection-shaped for Fable
    and fail under .NET reflection (`buildProxy` cannot reconstruct
    the record of FSharpFunc values). The static constructor fires
    the first time any member of the module is touched, so even a
    "pure update-function" test cannot execute on .NET.

    Tests here transpile via Fable + run under Node's built-in test
    runner (`node:test`, stable in Node 20+). The `NodeTest.fs` shim
    provides an Expecto-style facade so test bodies look like
    Platform.Tests; zero npm test-runner dependencies (the SDK-bundle
    deps in `package.json` are present only to satisfy ESM resolution
    of `react` / `ag-grid` / `@clerk/react` imports the Fable-emitted
    JS carries from the Platform.Client tier). See the "Testing
    client-tier MVU update functions" section in
    `docs/platform/testing-conventions.md` for the run procedure.

    Future view-level tests (Feliz components, useState interaction)
    compose on top of this harness; adding JSDOM as a devDep when
    such a test concretely needs it.

    `IsPackable=false`; the project ships nothing.
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <DefaultItemExcludes>$(DefaultItemExcludes);output\**;node_modules\**</DefaultItemExcludes>
        <!-- Fable ecosystem (Feliz, Fable.Mocha, Fable.Elmish, ToolUp.Remoting)
             pre-dates F# 10's nullable reference types; enabling nullness
             here would cascade "null / not null inconsistent" errors
             through transitive references. Per forge `CLAUDE.md` guidance:
             nullness stays disabled on Fable-touching projects. -->
        <Nullable>disable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="NodeTest.fs" />
        <Compile Include="StepDriver.fs" />
        <Compile Include="PlatformAIKeysAdminUITests.fs" />
        <Compile Include="AIScreenEffectsTests.fs" />
        <!-- ClientHostCapabilities routing tests (the bridge
             lives in Platform.Client, reached transitively; this is the
             established Fable-tier client harness). -->
        <Compile Include="ClientHostBridgeTests.fs" />
        <!-- NotificationClient identity-aware lifecycle
             (Platform.Client tier, reached transitively; same
             precedent as ClientHostBridgeTests). -->
        <Compile Include="NotificationClientTests.fs" />
        <!-- Boot-degradation accumulator + shell update arms +
             UserSession bridge-failure counter (Platform.Client tier). -->
        <Compile Include="BootDegradationTests.fs" />
        <!-- ConsentBanner MVU core (Platform.Client tier,
             reached transitively; pure init/update/toConsentState). -->
        <Compile Include="ConsentBannerTests.fs" />
        <!-- Home/Overview landing-selection (prepareModules
             head-injection in Platform.Client; needs ClientConfig.defaults,
             which only resolves under Fable — see HomeLandingTests.fs). -->
        <Compile Include="HomeLandingTests.fs" />
        <!-- Module-contributed Home-widget registry contract
             (HomeWidgetRegistry in Platform.Client; needs ClientConfig.defaults,
             which only resolves under Fable — see HomeWidgetContributorTests.fs). -->
        <Compile Include="HomeWidgetContributorTests.fs" />
        <!-- Tenant-lifecycle diagnostics admin MVU
             (TenantLifecycleAdminUI lives in Platform.Client, reached
             transitively; same precedent as the others). -->
        <Compile Include="TenantLifecycleAdminUITests.fs" />
        <!-- Module-visibility profile editor MVU (ModuleVisibilityAdminUI
             lives in Platform.Client, reached transitively; same precedent
             as TenantLifecycleAdminUITests). -->
        <Compile Include="ModuleVisibilityAdminUITests.fs" />
        <!-- Background-jobs admin MVU (JobsAdminUI lives in
             Platform.Client, reached transitively). -->
        <Compile Include="JobsAdminUITests.fs" />
        <Compile Include="AdminScreenEffectsTests.fs" />
        <!-- The admin sub-models (Platform.Client), each driven without its parent. -->
        <Compile Include="AdminSubModelTests.fs" />
        <!-- Sidebar admin-group role gate — the 4f.2 platform-scoped
             vs team-scoped group split (Platform.Client tier). -->
        <Compile Include="SidebarAdminGroupGateTests.fs" />
        <Compile Include="SidebarAreaTests.fs" />
        <!-- Nested multi-page module sidebar entries — buildSections /
             flatten nesting + SidebarPreferences module-expand + legacy
             blob (Platform.Client tier). -->
        <Compile Include="SidebarNestingTests.fs" />
        <!-- Per-user sidebar entry hiding: the buildSections
             exclusion, the "Hidden items" reveal section, and the real
             localStorage legacy-blob load path (Platform.Client tier).
             The pure preference algebra is pinned .NET-side in
             ToolUp.Platform.Tests/InProcess/SidebarHidingContractTests.fs. -->
        <Compile Include="SidebarHidingTests.fs" />
        <!-- Rail placement as declared data: the buildSections
             slot resolution (undeclared ⇒ grouped, declared ⇒ placed, no
             reserved row in `_other`) and the fresh-profile
             switcher-reachability case. Same reason as the two packs above:
             `Toolup.Sidebar` cannot be touched from the .NET harness. The
             code-shape pins are .NET-side in
             ToolUp.Platform.Tests/InProcess/SidebarVisibilityContractTests.fs. -->
        <Compile Include="SidebarPlacementTests.fs" />
        <!-- Keyboard navigation for the rail: the one traversal
             order (`railStops`), the bindings (`railKey`), the roving
             single tab stop (`railTabIndex`) and the never-zero-tab-stops
             guard (`resolveActiveStop`). Same reason as the packs above:
             `Toolup.Sidebar` cannot be touched from the .NET harness. -->
        <Compile Include="SidebarKeyboardTests.fs" />
        <!-- The shell's subscriptions: the outer-composer contract
             (Client.subscriptions / Client.resources / Subscription.map) —
             pins that a composer (AIClientConfig) lists the shell's
             background subscriptions, the admin-tile click-through
             regression class — and what the runtime does with a shell
             program: one render per drain, stop-once, the error sink. -->
        <Compile Include="ShellLifetimeEffectsTests.fs" />
        <Compile Include="ShellUpdateEffectsTests.fs" />
        <Compile Include="BootSourcesTests.fs" />
        <Compile Include="ModuleHostTests.fs" />
        <Compile Include="BrowserHistoryTests.fs" />
        <!-- The prepared module list and the built-ins' admin
             tiles over reference configurations, pinned by baselines
             recorded BEFORE the shell-slot refactor (shell-slot-baselines/). -->
        <Compile Include="ShellSlotSnapshotTests.fs" />
        <Compile Include="ShellSlotTests.fs" />
        <!-- The a11y rule set over the shell rail's
             states. The rules are COMPILED IN from ToolUp.Platform.Testing
             rather than reimplemented: that project ProjectReferences
             Platform.Server, which must not be dragged through Fable, but
             this file is BCL-only by design and already packs under
             `fable/`. Reusing it verbatim is the point of the phase — a
             second a11y vocabulary is the failure mode it exists to avoid. -->
        <Compile Include="..\ToolUp.Platform.Testing\Testing\AccessibilityAssertions.fs" />
        <!-- The a11y floor for ordinary MODULE views. Both files are compiled in from
             ToolUp.Platform.Testing rather than reimplemented, for the
             same reason as AccessibilityAssertions above: that project
             ProjectReferences Platform.Server, which must not be dragged
             through Fable, but these two are Fable-safe by construction
             and already pack under `fable/`.

             ModuleHarness carries `AssertAccessibleView`, whose `mount`
             parameter IS the seam — the harness names no DOM and no npm
             package. ViewMount is the jsdom implementation of that seam,
             and is deliberately NOT in ToolUp.Platform.Testing's own
             `<Compile>` list: this `<Compile Include>` is the opt-in a
             consumer makes, and a consumer that skips it needs no `jsdom`
             / `react-dom` devDependency at all (GP 13). -->
        <Compile Include="..\ToolUp.Platform.Testing\Testing\TreeViewParity.fs" />
        <Compile Include="..\ToolUp.Platform.Testing\Testing\ModuleHarness.fs" />
        <Compile Include="..\ToolUp.Platform.Testing\Testing\ViewMount.fs" />
        <!-- The shell rail's nine STATES plus the jsdom render
             harness, extracted out of SidebarRailA11yTests so the a11y floor
             and the structural snapshot gate share ONE enumeration (613.B).
             Two lists would be the defect both gates exist to catch: a state
             covered by one and invisible to the other looks exactly like a
             state that is fine. Must precede both consuming packs. -->
        <Compile Include="SidebarRailFixtures.fs" />
        <Compile Include="SidebarRailA11yTests.fs" />
        <!-- Structural snapshot gate over the composed rail:
             section keys, row order, row ids, accessible names and collapse
             flags per state, diffed against committed baselines in
             rail-shape-baselines/. Also carries the two halves the keyboard
             tests' pure-function pack could not reach — the railStops iff invariant
             and the single-tab-stop invariant — which need rendered markup. -->
        <Compile Include="SidebarRailShapeSnapshotTests.fs" />
        <!-- The a11y floor over an ordinary MODULE view, driven
             through ModuleHarness's real init/update and its own `view` —
             the half the rail's floor left open (it covered the shell rail only,
             and `AssertAccessible` still needed a hand-supplied render). -->
        <!-- The migration kit's three assertions over a view moving to a tree:
             accessibility through the lowering, behaviour through update,
             parity with the view it replaces; and the kit's go-red proofs.
             Before ModuleViewA11yTests, which uses its tree lowering. -->
        <Compile Include="TreeViewParityTests.fs" />
        <Compile Include="ModuleViewA11yTests.fs" />
        <!-- The data-manager template publishes processed
             data. The template's three module files are compiled in
             directly from `templates/platformsdk-datamanager/MyDataManager/`
             rather than copied — see templates/README.md's "Programmatic
             invocation" byte-identical acceptance bar, which is what makes
             this a faithful instantiation of `dotnet new
             platformsdk-datamanager`. Same reason as every pack above:
             `ClientModel.fs` holds a module-level `Api.makeProxy` and
             `ClientView.fs`'s `register()` builds a real Feliz
             `ReactElement` for its `Icon`, both of which are `jsNative`
             under plain .NET reflection/execution, so `ToolUp.Platform.Tests`
             cannot drive this module at all — only a Fable-transpiled host
             with a real `react` can. Must follow ModuleHarness.fs. -->
        <Compile Include="..\..\templates\platformsdk-datamanager\MyDataManager\SharedTypes.fs" />
        <Compile Include="..\..\templates\platformsdk-datamanager\MyDataManager\ClientModel.fs" />
        <Compile Include="..\..\templates\platformsdk-datamanager\MyDataManager\ClientView.fs" />
        <Compile Include="DataManagerTemplateProcessedDataTests.fs" />
        <!-- The KB version-history client surface: the GP 11
             gate asserted over REAL mounted markup (a single-version row
             must be byte-for-byte what it was) plus the drawer's MVU
             arms. Same reason as every pack above — `ClientModel` holds a
             module-level `Api.makeProxy`, so it cannot be touched from
             the .NET harness at all. Must follow ViewMount.fs. -->
        <Compile Include="KnowledgeVersionHistoryTests.fs" />
        <!-- The fact browse client companion (model, pages)
             and the knowledge base list's fact-table badge. Must follow
             ViewMount.fs. -->
        <Compile Include="FactBrowseClientTests.fs" />
        <!-- The team output-visibility section and the
             member-visible notice, mounted. Must follow ViewMount.fs. -->
        <Compile Include="TeamOutputVisibilityUITests.fs" />
        <Compile Include="TeamScreenEffectsTests.fs" />
        <!-- The remoting wire corpus's parity leg. WireCorpus.fs
             is COMPILED IN from ToolUp.Platform.Tests rather than
             transcribed, so the value a committed fixture must decode to is
             ONE F# declaration both hosts read; its encoders and its
             generator sit behind `#if !FABLE_COMPILER` and do not come with
             it. The pack decodes `tests/remoting-corpus/*.msgpack` through
             the MsgPack reader as Fable transpiles it — the reader the
             browser client actually runs — and compares at the declaration,
             so the .NET and JavaScript readers are held to one contract.
             Reached transitively through Platform.Client, like every pack
             above; no new ProjectReference. -->
        <Compile Include="..\ToolUp.Platform.Tests\Remoting\WireCorpus.fs" />
        <Compile Include="Remoting\MsgPackWrite.fs" />
        <Compile Include="RemotingCorpusParityTests.fs" />
        <!-- The ProcessedData summary envelope: the fixture is the same file the
             .NET pack compiles, and the test holds Fable.SimpleJson's read of the pinned
             literal to the sample value. -->
        <Compile Include="..\ToolUp.Platform.Tests\Remoting\ProcessedDataEnvelopeFixture.fs" />
        <Compile Include="ProcessedDataEnvelopeTests.fs" />
        <!-- The block part: the fixture is the wire conformance pack's
             shared file, which the .NET Platform pack also compiles (holding the
             server's writer to its pinned literal); this pack holds the transpiled
             reflection decoder to the same values. -->
        <Compile Include="..\ToolUp.AI.Wire.Conformance\Shared\BlockPartFixtures.fs" Link="Remoting\BlockPartFixtures.fs" />
        <Compile Include="ConversationBlockPartDecodeTests.fs" />
        <!-- The client's JSON response decode through the algebra: the
             fixture is the same file the .NET pack compiles (it holds the writer and
             System.Text.Json to the pinned text and model); this pack holds JsonText
             and the proxy to the same model and value. -->
        <Compile Include="..\ToolUp.Platform.Tests\Remoting\JsonClientDecodeFixture.fs" />
        <!-- The browser's writer pinned as data: this pack holds the
             transpiled Fable.SimpleJson to each pinned text, the .NET pack holds
             its mirror (BrowserJsonWriter) to the same text. -->
        <Compile Include="..\ToolUp.Platform.Tests\Remoting\BrowserWriterFixture.fs" />
        <Compile Include="Remoting\XhrStub.fs" />
        <Compile Include="Remoting\JsonClientDecodeTests.fs" />
        <!-- Declared reads through the real proxy and RemoteEffect.call:
             in-flight sharing, stale-while-revalidate, invalidation, and the
             interceptor chain counting one request once. -->
        <Compile Include="..\ToolUp.Platform.Tests\Remoting\ReadPolicyFixture.fs" />
        <Compile Include="Remoting\ReadPolicyTests.fs" />
        <!-- The fetch transport and same-tick batching through the
             real proxy, against a scripted fetch. -->
        <Compile Include="Remoting\RemoteBatchingTests.fs" />
        <!-- Generated client proxies and encoders, transpiled: the
             shared encoder fixture and the generated ReadCatalogApi proxy (both
             compiled by the .NET pack too), Api.makeProxy generated-first, and
             composition with the 854 read table and 855 batching. -->
        <Compile Include="..\ToolUp.Platform.Tests\Remoting\ReadCatalogClientProxies.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Remoting\ClientEncoderFixture.fs" />
        <Compile Include="Remoting\GeneratedProxyTests.fs" />
        <!-- The streaming proxy: cold RemoteStream for an
             IAsyncEnumerable field, SSE decoding across chunk boundaries,
             every non-happy ending as OnError. fetch is stubbed. -->
        <Compile Include="StreamingProxyTests.fs" />
        <!-- Module inspect-state contract, driven through the shell update. -->
        <Compile Include="ModuleInspectStateTests.fs" />
        <!-- The module view's dispatch prop is referentially stable
             across renders (Client.moduleDispatchFor), pinned on the transpiled code. -->
        <Compile Include="ModuleDispatchStabilityTests.fs" />
        <!-- The sliced model store: the store binding, selector reads, the
             shell render scope (RenderScope.fs is shared with ClientBench) and the
             AG Grid props compare, pinned on the transpiled code. -->
        <Compile Include="RenderScope.fs" />
        <Compile Include="SlicedStoreTests.fs" />
        <!-- Every fuaran-* class a tree surface emits has a rule in the
             restored renderer's reference stylesheet. -->
        <Compile Include="TreeStylesheetTests.fs" />
        <!-- The node toolkit's ids, Keep's identity table and the lowering's
             kept render context, on the transpiled code. -->
        <Compile Include="NodeToolkitTests.fs" />
        <!-- The UI-awareness companion's inspect_active_module executor. -->
        <Compile Include="UiAwarenessInspectTests.fs" />
        <!-- The composition routes' render scope (the AI composer
             on both render paths, the shell's context readers; ComposerScope.fs
             is shared with ClientBench, so it precedes it) and the pack that
             asserts it. -->
        <Compile Include="ComposerScope.fs" />
        <Compile Include="ComposerStoreTests.fs" />
        <!-- The browser runtime, measured. MinimalClient's entry
             module is COMPILED IN so its transpiled output sits beside the
             harness; nothing in this pack references it, so no test imports
             it and its module-level `Program.run` never executes here. Only
             ClientBench's fresh-process boot child (client-bench-boot.mjs)
             imports it, which is the boot being timed. ClientBench itself runs
             only under `output/Program.js ClientBench` — never under
             `node:test`. Must follow WireCorpus.fs (the corpus it reuses). -->
        <Compile Include="..\..\samples\MinimalClient\Client.fs" />
        <!-- The 200-row table as Feliz and as a tree, with no Node import, so
             client-bench-browser.mjs can bundle it for a page. -->
        <Compile Include="ClientBenchTables.fs" />
        <Compile Include="ClientBench.fs" />
        <!-- The UI-awareness companion's list_active_actions executor. -->
        <Compile Include="ListActiveActionsTests.fs" />
        <!-- Every identity change clears the read cache (after
             RenderScope.fs, whose jsdom each case installs). -->
        <Compile Include="Remoting\IdentityChangeReadCacheTests.fs" />
        <!-- The conversation panel draws a block part: re-read
             through a resolver, its furniture, the page's theme, and the
             no-block panel pinned byte for byte (after RenderScope.fs, whose
             jsdom each case installs). -->
        <Compile Include="ConversationBlockTests.fs" />
        <Compile Include="BlockRenderTests.fs" />
        <Compile Include="ChatWatchdogTests.fs" />
        <Compile Include="ChatStreamTests.fs" />
        <Compile Include="NarrativePromptAdminUITests.fs" />
        <!-- Remote calls as effect values: the performer, the adapter and the
             two ported modules (Platform.Client, Facts.Client and
             KnowledgeBase.Client, all referenced below). -->
        <Compile Include="RemoteEffectTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- ProjectReference to ToolUp.AI.Client transitively drives
             Platform.Client + Platform.Core + AI.Core through the Fable
             compiler — so AI.Client modules under test compile against
             the same source the SDK ships. -->
        <ProjectReference Include="..\ToolUp.AI.Client\ToolUp.AI.Client.fsproj" />
        <!-- The KB client tier, driven through Fable for the
             same reason AI.Client is: its MVU code is unreachable from
             .NET reflection. This is the estate's ONE Fable-tier test
             harness (the project name predates that), so a KB client
             pack belongs here rather than in a second harness that would
             have to re-derive the loader, the jsdom mount and the
             node:test facade. -->
        <ProjectReference Include="..\ToolUp.KnowledgeBase.Client\ToolUp.KnowledgeBase.Client.fsproj" />
        <!-- The fact browse client companion, transpiled here so
             the fable-tier gate compiles it. -->
        <ProjectReference Include="..\ToolUp.Facts.Client\ToolUp.Facts.Client.fsproj" />
        <!-- The UI-awareness companion's Fable client tier. -->
        <ProjectReference Include="..\AIExtensions\UiAwareness\ToolUp.AI.UiAwareness.Client\ToolUp.AI.UiAwareness.Client.fsproj" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Fable.Core" />
        <PackageReference Include="Fuaran.UI.Operability" />
    </ItemGroup>
</Project>
