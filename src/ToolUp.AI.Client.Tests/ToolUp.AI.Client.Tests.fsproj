<?xml version="1.0" encoding="utf-8"?>
<!--
    ToolUp.AI.Client.Tests — Fable-tier test harness for the AI.Client
    surface (Phase 70 E.4 follow-up).

    The .NET Expecto runners in `ToolUp.Platform.Tests` cannot reach
    AI.Client's MVU code at runtime: module-level Remoting proxy
    constructors (e.g. `let private api = Api.makeProxy<…>` in
    `PlatformAIKeysAdminUI.fs:67`) are reflection-shaped for Fable
    and fail under .NET reflection (`buildProxy` cannot reconstruct
    the record of FSharpFunc values). The static constructor fires
    the first time any member of the module is touched, so even a
    "pure update-function" test cannot execute on .NET.

    Tests here transpile via Fable + run under Node's built-in test
    runner (`node:test`, stable in Node 20+). The `NodeTest.fs` shim
    provides an Expecto-style facade so test bodies look like
    Platform.Tests; zero npm test-runner dependencies (the SDK-bundle
    deps in `package.json` are present only to satisfy ESM resolution
    of `react` / `ag-grid` / `@clerk/react` imports the Fable-emitted
    JS carries from the Platform.Client tier). See the "Testing
    client-tier MVU update functions" section in
    `docs/platform/testing-conventions.md` for the run procedure.

    Future view-level tests (Feliz components, useState interaction)
    compose on top of this harness; adding JSDOM as a devDep when
    such a test concretely needs it.

    `IsPackable=false`; the project ships nothing.
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <DefaultItemExcludes>$(DefaultItemExcludes);output\**;node_modules\**</DefaultItemExcludes>
        <!-- Fable ecosystem (Feliz, Fable.Mocha, Fable.Elmish, ToolUp.Remoting)
             pre-dates F# 10's nullable reference types; enabling nullness
             here would cascade "null / not null inconsistent" errors
             through transitive references. Per forge `CLAUDE.md` guidance:
             nullness stays disabled on Fable-touching projects. -->
        <Nullable>disable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="NodeTest.fs" />
        <Compile Include="PlatformAIKeysAdminUITests.fs" />
        <!-- Phase 110 — ClientHostCapabilities routing tests (the bridge
             lives in Platform.Client, reached transitively; this is the
             established Fable-tier client harness). -->
        <Compile Include="ClientHostBridgeTests.fs" />
        <!-- Phase 117 — NotificationClient identity-aware lifecycle
             (Platform.Client tier, reached transitively; same Phase 110
             precedent as ClientHostBridgeTests). -->
        <Compile Include="NotificationClientTests.fs" />
        <!-- Phase 121 — boot-degradation accumulator + shell update arms +
             UserSession bridge-failure counter (Platform.Client tier). -->
        <Compile Include="BootDegradationTests.fs" />
        <!-- Phase 159 — ConsentBanner MVU core (Platform.Client tier,
             reached transitively; pure init/update/toConsentState). -->
        <Compile Include="ConsentBannerTests.fs" />
        <!-- Phase 171 — Home/Overview landing-selection (prepareModules
             head-injection in Platform.Client; needs ClientConfig.defaults,
             which only resolves under Fable — see HomeLandingTests.fs). -->
        <Compile Include="HomeLandingTests.fs" />
        <!-- Phase 217 — module-contributed Home-widget registry contract
             (HomeWidgetRegistry in Platform.Client; needs ClientConfig.defaults,
             which only resolves under Fable — see HomeWidgetContributorTests.fs). -->
        <Compile Include="HomeWidgetContributorTests.fs" />
        <!-- Phase 54e — tenant-lifecycle diagnostics admin MVU
             (TenantLifecycleAdminUI lives in Platform.Client, reached
             transitively; same Phase 110 precedent as the others). -->
        <Compile Include="TenantLifecycleAdminUITests.fs" />
        <!-- Sidebar admin-group role gate — the 4f.2 platform-scoped
             vs team-scoped group split (Platform.Client tier). -->
        <Compile Include="SidebarAdminGroupGateTests.fs" />
        <Compile Include="SidebarAreaTests.fs" />
        <!-- Nested multi-page module sidebar entries — buildSections /
             flatten nesting + SidebarPreferences module-expand + legacy
             blob (Platform.Client tier). -->
        <Compile Include="SidebarNestingTests.fs" />
        <!-- Phase 572 — per-user sidebar entry hiding: the buildSections
             exclusion, the "Hidden items" reveal section, and the real
             localStorage legacy-blob load path (Platform.Client tier).
             The pure preference algebra is pinned .NET-side in
             ToolUp.Platform.Tests/InProcess/SidebarHidingContractTests.fs. -->
        <Compile Include="SidebarHidingTests.fs" />
        <!-- Phase 611 — rail placement as declared data: the buildSections
             slot resolution (undeclared ⇒ grouped, declared ⇒ placed, no
             reserved row in `_other`) and the Phase 608 fresh-profile
             switcher-reachability case. Same reason as the two packs above:
             `Toolup.Sidebar` cannot be touched from the .NET harness. The
             code-shape pins are .NET-side in
             ToolUp.Platform.Tests/InProcess/SidebarVisibilityContractTests.fs. -->
        <Compile Include="SidebarPlacementTests.fs" />
        <!-- Shell program-lifetime effects: the outer-composer contract
             (programLifetimeEffects / withShellLifetimeEffects /
             EffectHandle.map) — pins that an outer Program composer
             (AIClientConfig.withSidePanel) re-attaches the shell's
             background subscriptions, the admin-tile click-through
             regression class. -->
        <Compile Include="ShellLifetimeEffectsTests.fs" />
        <!-- Phase 610 — the Phase 180 a11y rule set over the shell rail's
             states. The rules are COMPILED IN from ToolUp.Platform.Testing
             rather than reimplemented: that project ProjectReferences
             Platform.Server, which must not be dragged through Fable, but
             this file is BCL-only by design and already packs under
             `fable/`. Reusing it verbatim is the point of the phase — a
             second a11y vocabulary is the failure mode it exists to avoid. -->
        <Compile Include="..\ToolUp.Platform.Testing\Testing\AccessibilityAssertions.fs" />
        <Compile Include="SidebarRailA11yTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- ProjectReference to ToolUp.AI.Client transitively drives
             Platform.Client + Platform.Core + AI.Core through the Fable
             compiler — so AI.Client modules under test compile against
             the same source the SDK ships. -->
        <ProjectReference Include="..\ToolUp.AI.Client\ToolUp.AI.Client.fsproj" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Fable.Core" />
    </ItemGroup>
</Project>
