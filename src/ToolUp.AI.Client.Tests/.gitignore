# .NET build output.
bin/
obj/

# Fable transpilation output (regenerated by `dotnet fable -o output --noCache`).
output/

# Node module install tree (regenerated by `npm install`).
node_modules/

# npm install lockfile — committed alongside package.json so the FAKE
# `Verify` target (when it grows to invoke this runner) can use
# `npm ci`. Until that lands, leaving the lockfile committed keeps
# `npm install` deterministic across dev machines.
!package-lock.json
