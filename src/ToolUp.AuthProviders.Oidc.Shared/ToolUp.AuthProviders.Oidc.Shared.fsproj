<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AuthProviders.Oidc.Shared</PackageId>
    <AssemblyName>ToolUp.AuthProviders.Oidc.Shared</AssemblyName>
    <Description>Shared OIDC types consumed by both client (sign-in UI, classifier, presets, coherence validator) and server (auth provider, audience-binding validator) sides of the ToolUp.AuthProviders.Oidc family. Owns `OidcAppConfig` — the unified one-declaration record that both sides project from. Phase C.1 / 0.4.0 introduction.</Description>
    <PackageTags>fsharp;fable;sdk;auth;oidc;shared</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Shared\OidcAppConfig.fs" />
  </ItemGroup>
  <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
       under fable/.  OidcAppConfig is consumed by Fable-compiled client
       code (OidcAuthUI, OidcShell) so source-in-nupkg delivery is
       required. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.Platform.Client\ToolUp.Platform.Client.fsproj" />
  </ItemGroup>
  <!-- 0.4.4 — Directory.Build.props pins `<PackageReadmeFile>README.md</PackageReadmeFile>`
       globally. This fsproj has no sibling README.md (the auto-include
       in Directory.Build.props doesn't fire) so the pack failed
       NU5039 on every CI publish run that reached this project.
       Pointing at the OIDC server-side companion's README keeps the
       package self-explanatory without duplicating content. -->
  <ItemGroup>
    <None Include="..\AuthProviders\Oidc\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
