<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <!-- Phase 11.B follow-up Scheduling cross-tier cutover (2026-05-08):
         replaced <Compile Link> entries that source-injected Platform +
         Scheduling server files with <ProjectReference> entries to the
         matching DLLs. The tests now exercise the production companion
         DLLs directly. -->
    <ItemGroup>
        <Compile Include="InProcess\RecurrenceExpanderTests.fs" />
        <Compile Include="InProcess\iCalendarTests.fs" />
        <Compile Include="InProcess\BookingConflictDetectorTests.fs" />
        <Compile Include="InProcess\InMemoryEntityStore.fs" />
        <Compile Include="InProcess\InMemoryEventStore.fs" />
        <!-- Phase 814 — the principal-recording IEntityStore decorator the seam
             contract pack observes through, source-linked from ToolUp.Platform.Tests. -->
        <Compile Include="..\ToolUp.Platform.Tests\Support\PrincipalRecordingEntityStore.fs" Link="Support\PrincipalRecordingEntityStore.fs" />
        <Compile Include="Contracts\IBookingSchedulerContract.fs" />
        <Compile Include="InProcess\BookingSchedulerTests.fs" />
        <Compile Include="InProcess\WorkedExampleTests.fs" />
        <!-- Phase 20a — the calendar-bridge seam. The contract pack sits
             after the in-memory stores it builds its sync fixture over,
             and before the two bindings that bind it. -->
        <Compile Include="InProcess\InMemoryCalendarBridge.fs" />
        <Compile Include="Contracts\ICalendarBridgeContract.fs" />
        <Compile Include="InProcess\InMemoryCalendarBridgeTests.fs" />
        <Compile Include="InProcess\CalDAVCalendarBridgeTests.fs" />
        <Compile Include="InProcess\CalendarSyncTests.fs" />
        <!-- Phase 830 — the Google Calendar bridge, the third binding of the
             ICalendarBridge contract pack. -->
        <Compile Include="InProcess\GoogleCalendarBridgeTests.fs" />
        <!-- Phase 722 — the unregistered-[<Tests>]-list guard, source-linked from
             ToolUp.Platform.Tests so there is one implementation. -->
        <Compile Include="..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.Scheduling.Core\ToolUp.Scheduling.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Scheduling.Server\ToolUp.Scheduling.Server.fsproj" />
        <!-- Phase 20a — the CalDAV bridge is the second binding of the
             ICalendarBridge contract pack. -->
        <ProjectReference Include="..\Calendar\CalDAV\ToolUp.Calendar.CalDAV.fsproj" />
        <!-- Phase 830 — the Google Calendar bridge is the third binding. -->
        <ProjectReference Include="..\Calendar\Google\ToolUp.Calendar.Google.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
</Project>
