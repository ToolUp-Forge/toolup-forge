<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.AI.Wire — a portable, Fable-compilable JSON value model: a JsonValue DU with ergonomic builders + total (never-throwing) accessors, and a host-bridged serialization seam (browser JSON under Fable, System.Text.Json on .NET) with byte-stable object key order. Neutral wire-mapping substrate shared by server and browser hosts. FSharp.Core + Fable.Core only — no System.Net.Http, no unguarded System.Text.Json.</Description>
        <PackageTags>fsharp;fable;sdk;json;wire;portable</PackageTags>
        <!-- Fable-touching project: nullable reference types stay disabled
             (forge CLAUDE.md "Nullable reference types — keep disabled on
             Fable-touching projects"). The Fable ecosystem this compiles
             against pre-dates F# 10 nullness annotations. -->
        <Nullable>disable</Nullable>
    </PropertyGroup>
    <!-- Source ships in the nupkg under fable/ so Fable consumers compile
         the same source the .NET host runs (mirrors ToolUp.AI.Core). -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="JsonValue.fs" />
        <Compile Include="JsonHost.fs" />
        <!-- Phase 250 — the portable connector contract value types
             (relocated from ToolUp.Platform.Core's IAIProvider.fs, namespace
             ToolUp.Platform.AI preserved so consumers see no change).
             Depends only on FSharp.Core (+ Fable-supported System.Uri); does
             not consume JsonValue, so order is independent. -->
        <Compile Include="Contract.fs" />
        <!-- Phase 251 — the portable egress seam. RetryPolicy relocated
             from ToolUp.Platform.Core (namespace ToolUp.Platform preserved);
             IHttpTransport + the pure error classifier + the pure retry
             runner factor the HTTP egress out of the per-provider mappers so
             they can stay 100% pure (the host injects how bytes travel).
             FSharp.Core + Fable-supported System.TimeSpan only — no
             System.Net.Http (that lives in the server-side HttpClientTransport
             companion). RetryRunner depends on both RetryPolicy (delayFor /
             MaxAttempts) and Contract (AIProviderError / RetriesExhausted), so
             it is compiled last. -->
        <Compile Include="Transport\RetryPolicy.fs" />
        <Compile Include="Transport\IHttpTransport.fs" />
        <Compile Include="Transport\ErrorClassifier.fs" />
        <Compile Include="Transport\RetryRunner.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Fable.Core supplies the [<Emit>] / JsInterop surface the
             #if FABLE_COMPILER parse bridge in JsonHost.fs needs. On the
             .NET host it adds no runtime behaviour. -->
        <PackageReference Include="Fable.Core" />
        <!-- Phase 250 — pin the managed FSharp.Core (10.1.300 via CPM)
             explicitly. Contract.fs uses string interpolation
             (AIProviderError.toMessage), which needs FSharp.Core 5.0+; left
             implicit, the project resolved the compiler's older bundled copy
             and FS3349 fired. Mirrors ToolUp.AI.Wire.Fable.Tests. -->
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>
