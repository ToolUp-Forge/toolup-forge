<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AICookbooks.AgGridEnterprise</PackageId>
    <AssemblyName>ToolUp.AICookbooks.AgGridEnterprise</AssemblyName>
    <Description>Enterprise AG Grid + AG Chart prompt-builder companion for ToolUp.AI. Composes the Enterprise COOKBOOK.md's constraints + shortest-possible into a deployment's system prompt (Sankey/Sunburst/Treemap/OHLC/Sparkline + Set Filter/Master-Detail/Excel/Status Bar/Sidebar). Opt-in; Enterprise-only.</Description>
    <PackageTags>fsharp;sdk;ai;prompt;ag-grid;ag-charts;enterprise;cookbook</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AgGridEnterpriseAICookbook.fs" />
    <!-- Ship the Enterprise cookbook alongside the assembly for assembly-
         relative resolution in packaged deployments. The Link/PackagePath name MUST
         match AgGridEnterpriseAICookbook.CookbookFileName and MUST differ from the
         Community companion's — see the note in AgChartAICookbook.fsproj. -->
    <Content Include="..\..\Feliz.AgGrid.Enterprise\COOKBOOK.md" Link="COOKBOOK.Enterprise.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Phase 768: two package paths. `content\` is the legacy location (kept so a
           consumer pinning its path via GeneratePathProperty keeps working until it
           drops that workaround); `contentFiles\any\any\` is what NuGet delivers to a
           PackageReference consumer, and PackageCopyToOutput lands it beside the
           assembly, which is the builder's assembly-relative candidate path. -->
      <PackagePath>content\COOKBOOK.Enterprise.md;contentFiles\any\any\COOKBOOK.Enterprise.md</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
    <ProjectReference Include="..\AgChart\AgChartAICookbook.fsproj" />
  </ItemGroup>
</Project>
