<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AICookbooks.AgChart</PackageId>
    <AssemblyName>ToolUp.AICookbooks.AgChart</AssemblyName>
    <Description>Community AG Chart + AG Grid prompt-builder companion for ToolUp.AI. Composes the Community COOKBOOK.md's constraints + shortest-possible-chart into a deployment's system prompt so the in-app AI assistant authors charts/grids in F#. Opt-in; ~600 tokens.</Description>
    <PackageTags>fsharp;sdk;ai;prompt;ag-grid;ag-charts;cookbook</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AgChartAICookbook.fs" />
    <!-- Ship the Community cookbook alongside the assembly so the builder's
         assembly-relative resolution finds it in packaged deployments.
         The Link/PackagePath name MUST match AgChartAICookbook.CookbookFileName and
         MUST differ from the Enterprise companion's: a consumer referencing both
         copies both into one output directory, and under a shared name the copies
         collide with MSBuild ordering picking the winner. -->
    <Content Include="..\..\ToolUp.Platform.Client\Client\UI\COOKBOOK.md" Link="COOKBOOK.Community.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Phase 768: two package paths. `content\` is the legacy location (kept so a
           consumer pinning its path via GeneratePathProperty keeps working until it
           drops that workaround); `contentFiles\any\any\` is what NuGet delivers to a
           PackageReference consumer, and PackageCopyToOutput lands it beside the
           assembly, which is the builder's assembly-relative candidate path. -->
      <PackagePath>content\COOKBOOK.Community.md;contentFiles\any\any\COOKBOOK.Community.md</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
  </ItemGroup>
</Project>
