<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.DataSources.Snowflake</PackageId>
    <AssemblyName>ToolUp.DataSources.Snowflake</AssemblyName>
    <Description>Snowflake IDataSource companion for ToolUp.Platform, over the official Snowflake.Data ADO.NET driver. Password or key-pair (JWT) auth resolved per call through ISecretStore; per-warehouse / per-schema / per-role routing read from ConnectionScope; INFORMATION_SCHEMA introspection with Snowflake's identifier-case folding; RFC 4180 CSV query output.</Description>
    <PackageTags>fsharp;sdk;data-source;ingestion;snowflake;warehouse;server</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SnowflakeDataSource.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\Common\ToolUp.DataSources.Common.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Snowflake.Data" />
  </ItemGroup>
</Project>
