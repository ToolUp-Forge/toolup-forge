<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.DataSources.Parquet</PackageId>
    <AssemblyName>ToolUp.DataSources.Parquet</AssemblyName>
    <Description>Parquet companion for ToolUp.Platform, in two independent legs. Storage: a Parquet IDatasetCodec that encodes typed dataset vintages as native Parquet for external compute handoff (Python/R workers read the blob directly) and decodes with schema verification against the declared DatasetSchema — compose via BlobDatasetStore.createWithCodec; the BCL JSON-frame codec remains the default. Ingestion: a ParquetDataSource IDataSource that reads third-party Parquet extracts through IBlobStorage, takes its schema from the file's own footer metadata (no inference) and streams row groups.</Description>
    <PackageTags>fsharp;sdk;parquet;dataset;codec;data-source;ingestion;file;server</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ParquetDatasetCodec.fs" />
    <!-- Phase 10d — the ingestion leg. Independent of the codec above;
         they share only the vendor dependency and the file format. -->
    <Compile Include="ParquetDataSource.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\Common\ToolUp.DataSources.Common.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Parquet.Net" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
