<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.DataSources.Csv</PackageId>
    <AssemblyName>ToolUp.DataSources.Csv</AssemblyName>
    <Description>Delimited-file IDataSource companion for ToolUp.Platform. Reads CSV / TSV / pipe-delimited exports through IBlobStorage (any provider, including LocalFileStorage for files on disk), with configurable delimiter, quote character, header presence and encoding. Schema is inferred by type-probing a configurable row sample; Query re-emits canonical RFC 4180 CSV. Zero third-party dependencies — the RFC 4180 reader is BCL-only.</Description>
    <PackageTags>fsharp;sdk;data-source;ingestion;csv;tsv;delimited;file;server</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CsvDataSource.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\Common\ToolUp.DataSources.Common.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
  <!-- No vendor PackageReference, deliberately. The RFC 4180 reader in
       CsvDataSource.fs is a BCL character state machine; CsvHelper would
       be a third-party dependency for a format this repo already parses
       in ~90 lines, and referencing ToolUp.Tabular (which carries the
       same parser) would drag DocumentFormat.OpenXml in behind it for an
       XLSX leg a CSV connector never reaches. -->
</Project>
