<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.DataSources.Common</PackageId>
    <AssemblyName>ToolUp.DataSources.Common</AssemblyName>
    <Description>Vendor-free support layer shared by the ToolUp.DataSources.* IDataSource companions: typed ConnectionScope reads, the ISecretStore credential thunk, RFC 4180 CSV emission (including DbDataReader drain), the IngestionError exception classifier, and native-type to ColumnType classification. BCL only — no cloud or database SDK dependency.</Description>
    <PackageTags>fsharp;sdk;data-source;ingestion;csv;server</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ConnectorSupport.fs" />
    <!-- Phase 10d — file acquisition + type-probe inference shared by the
         Csv / Excel / Parquet connectors. Still BCL-only. -->
    <Compile Include="LocalFileSupport.fs" />
    <!-- Phase 128 — the outbound API connector kit: typed paged fetch,
         the quota-aware transport decorator, the IExternalApiConnector
         authoring seam, and incremental sync cursors. Still BCL-only. -->
    <Compile Include="PagedFetch.fs" />
    <Compile Include="OutboundRateBudget.fs" />
    <Compile Include="IExternalApiConnector.fs" />
    <Compile Include="SyncCursor.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <!-- `IDataSource` + `DataSourceCallContext` live in Platform.Server
         (server-only interface; the Fable-safe types sit in Core). -->
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
