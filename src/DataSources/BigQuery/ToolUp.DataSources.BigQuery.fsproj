<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.DataSources.BigQuery</PackageId>
    <AssemblyName>ToolUp.DataSources.BigQuery</AssemblyName>
    <Description>Google BigQuery IDataSource companion for ToolUp.Platform. Service-account JSON (or application-default) credentials resolved per call through ISecretStore; dataset/table introspection via the BigQuery API; query results returned as RFC 4180 CSV; a maximum_bytes_billed ceiling so a runaway scan fails instead of billing.</Description>
    <PackageTags>fsharp;sdk;data-source;ingestion;bigquery;gcp;warehouse;server</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BigQueryDataSource.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\Common\ToolUp.DataSources.Common.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Google.Cloud.BigQuery.V2" />
    <PackageReference Include="Google.Apis.Auth" />
  </ItemGroup>
</Project>
