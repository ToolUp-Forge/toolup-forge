<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Media.FFmpeg</PackageId>
    <AssemblyName>ToolUp.Media.FFmpeg</AssemblyName>
    <Description>FFmpeg-backed media derivation + HLS transcode sub-companion for ToolUp.MediaLibrary (Phase 88). Shells out to the system ffmpeg/ffprobe binaries for poster-frame extraction, duration/dimension probing, and HLS rendition production. Opt-in (GP 1) — ships no bundled binary; the deployment provides FFmpeg on PATH.</Description>
    <PackageTags>fsharp;sdk;media;ffmpeg;transcode;hls;poster;provider</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaLibrary\ToolUp.MediaLibrary.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FFmpegMediaProvider.fs" />
  </ItemGroup>

</Project>
