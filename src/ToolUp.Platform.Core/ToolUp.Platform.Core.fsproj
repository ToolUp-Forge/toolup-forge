<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Platform Core — shared types and interfaces (ILogger, IBlobStorage, IAuthProvider, IAIProvider, INotificationChannel, IHealthCheck, IConfigValidator, etc.). No server or client deps; the "minimum viable module" floor for downstream packages.</Description>
        <PackageTags>fsharp;sdk;types;interfaces</PackageTags>
    </PropertyGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
         under fable/. Core types are shared between server-tier (consumes
         the DLL) and Fable client-tier (consumes the source) — both ship
         in the same nupkg. Mirrors the Feliz / Fable.Elmish convention. -->
    <ItemGroup>
        <!-- Shared\JwtCrypto.fs is BCL-crypto (System.Security.Cryptography)
             and is NOT Fable-safe, but it MUST still ship under fable/:
             the same .fsproj is packed into the nupkg, and it lists
             JwtCrypto.fs as a <Compile> item. Excluding the .fs file while
             keeping the Compile reference leaves the packed Fable fsproj
             pointing at a missing source — Fable then reads it as empty and
             fails with "must begin with a namespace or module declaration"
             (FS0222). The file guards itself instead: its `module
             ToolUp.Platform.JwtCrypto` declaration sits OUTSIDE the
             `#if !FABLE_COMPILER`, while the whole BCL-crypto body sits
             inside it, so a Fable consumer transpiles it to a valid empty
             module. Its real consumers are server-tier (StaticJwt / peer
             auth / ShareTokenStore), which get the implementation via the
             Core DLL. This is the same ship-with-guard pattern every other
             server-only Shared file in Core uses. -->
        <Content Include="**\*.fsproj;**\*.fs;**\*.svg" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <!-- Phase 11.C.2 closure: pack the parent companion's README. All
         four ToolUp.Platform tiers (Core / Server / Client / Build) ship
         the same parent README; tier-specific detail lives in <Description>. -->
    <ItemGroup>
        <None Include="..\ToolUp.Platform\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <!-- 0.4.4 — MsgPack's TypeShape module is `module internal TypeShape`
         (deliberately hidden from Platform.Core's public API to avoid
         leaking the TypeShape namespace to downstream consumers). The
         folded ToolUp.Remoting.Server source (in Platform.Server) opens
         TypeShape directly — `open TypeShape`, `shapeof<_>`, `Shape.X`
         patterns — and needs visibility into Core's internals. Mirrors
         the original ToolUp.Remoting.MsgPack -> ToolUp.Remoting.Server
         InternalsVisibleTo from the pre-fold layout. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ToolUp.Platform.Server</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Shared\LogLevel.fs" />
        <!-- Phase 279 — stable component identity (ComponentId): a
             value-typed string wrapper + deterministic per-kind
             derivation + duplicate detection. Standalone (string-only),
             placed early so module / companion / datatype / tool
             registration surfaces in every later tier can reference it. -->
        <Compile Include="Shared\ComponentId.fs" />
        <!-- Phase 289 — component-scoped configuration section addressable
             by ComponentId + the pure, deterministic env-var-name
             derivation (TOOLUP_COMPONENT__<id>__<key>). Fable-safe (string
             only); after ComponentId.fs (keys the section) so the Server-tier
             resolver + the both-tier scaffolding tooling agree on the
             override name. -->
        <Compile Include="Shared\ComponentConfig.fs" />
        <!-- Phase 282 — typed companion capability descriptors: a
             machine-queryable EffectClass / DeterminismSource / Readiness
             posture a companion declares, keyed against the same
             ComponentId the manifest + preflight correlate against. Three
             join-semilattices (Phase 296 joins them componentwise); the
             bottom of each axis is the identity an undeclared companion
             contributes, so a pre-282 deployment is byte-for-byte
             unchanged (GP 11). Fable-safe (DUs + Set only); after
             ComponentId.fs so it can key on the stable identity. -->
        <Compile Include="Shared\CompanionCapability.fs" />
        <!-- 0.4.1 — forge-native authorisation attributes (mirrors of the
             Phase 69d markers in ToolUp.Remoting.Server). Placed early so
             every later API record file can annotate its fields. The SDK's
             Api.make consumes them via the AuthAttributeBridge at
             composition time. -->
        <Compile Include="Shared\AuthAttributes.fs" />
        <!-- Wave 19 TIDY-UP — shared JWT/crypto primitives, consolidating
             the base64url codec + HS256/HMAC helpers hand-copied across
             every token site. Base64Url is Fable-safe; JwtCrypto is
             BCL-crypto but self-guards under Fable (`#if !FABLE_COMPILER`
             body, module declaration outside) so both ship under fable/.
             Placed early — every later token/auth file references them. -->
        <Compile Include="Shared\Base64Url.fs" />
        <Compile Include="Shared\JwtCrypto.fs" />
        <Compile Include="Shared\Interfaces\ILogger.fs" />
        <!-- Phase 57 — static-prerender substrate types lifted out of
             Client/SDK.ClientTypes.fs so ToolUp.Platform.Build can
             consume them in the FAKE Prerender target factory without
             a Build → Client dep that would re-introduce a Fable-tier
             pull into the .NET-only build package. -->
        <Compile Include="Shared\Types\PrerenderTypes.fs" />
        <Compile Include="Shared\Types\DataManagementTypes.fs" />
        <Compile Include="Shared\Types\ProcessedDataTypes.fs" />
        <Compile Include="Shared\Types\ColumnMappingTypes.fs" />
        <Compile Include="Shared\ColumnMapping.fs" />
        <Compile Include="Shared\Types\ColumnMappingApi.fs" />
        <Compile Include="Shared\Visualisation.fs" />
        <Compile Include="Shared\TimeManagement.fs" />
        <Compile Include="Shared\Interfaces\IFileProcessor.fs" />
        <Compile Include="Shared\Types\VectorKnowledgeTypes.fs" />
        <Compile Include="Shared\Types\VectorisationTypes.fs" />
        <Compile Include="Shared\Interfaces\IAuthProvider.fs" />
        <Compile Include="Shared\Types\AuthConfig.fs" />
        <Compile Include="Shared\Auth\AuthMetrics.fs" />
        <Compile Include="Shared\Types\DataSubjectTypes.fs" />
        <Compile Include="Shared\Types\DataSubjectApiTypes.fs" />
        <!-- Wave 8 (Epoch 2) Phase 187 — compliance evidence-pack request /
             manifest / result + the IEvidencePackGenerator seam. After
             DataSubjectTypes.fs (uses ExportSegment + ExportSignature). -->
        <Compile Include="Shared\Types\EvidencePackTypes.fs" />
        <Compile Include="Shared\Interfaces\IBlobStorage.fs" />
        <Compile Include="Shared\Interfaces\ITimeSeriesStore.fs" />
        <Compile Include="Shared\Interfaces\ITelemetrySink.fs" />
        <Compile Include="Shared\Interfaces\ISecretStore.fs" />
        <!-- Phase 11.C.5 Tier 3 — unified RetryPolicy (replaces the
             AI-side `{ MaxRetries; BackoffMs; TimeoutMs }` and
             audit-side `AuditReplicatorRetryPolicy` shapes). Phase 251
             relocated it DOWN into the Fable-safe ToolUp.AI.Wire tier
             (Transport/RetryPolicy.fs) under the unchanged
             `namespace ToolUp.Platform`, so the portable retry runner +
             error classifier can reference it without a circular dep on
             Core. Every Core file (IAIProvider.fs and below) still sees
             `ToolUp.Platform.RetryPolicy` via the ToolUp.AI.Wire project
             reference — the namespace is preserved, only the assembly
             changed (GP 11; same byte-stable relocation pattern Phase 250
             used for the connector contract value types). -->
        <Compile Include="Shared\Interfaces\IAIProvider.fs" />
        <Compile Include="Shared\Types\StorageScope.fs" />
        <!-- Phase 264 — neutral host-state binding-source namespace
             (HostBindingSources). Shared floor (not client-side-only)
             because the CSR projection (Platform.Client) and the SSR
             projection (PublicRendering) produce the same type; GP 10. -->
        <Compile Include="Shared\HostBindingSources.fs" />
        <!-- Phase 276 — neutral hosted-route declaration (HostRoute /
             HostRouteParams). Shared floor (not client-side-only) because
             the client deep-link mapping (Platform.Client) and the SSR route
             registration (PublicRendering) consume the same route type; GP 10.
             After HostBindingSources.fs (paramsToBindingSources projects into
             the State namespace for the Phase 264 param round-trip). -->
        <Compile Include="Shared\HostRoutes.fs" />
        <Compile Include="Shared\EncryptionTypes.fs" />
        <Compile Include="Shared\EntityTypes.fs" />
        <Compile Include="Shared\EntityQueryTypes.fs" />
        <Compile Include="Shared\EntityQuery.fs" />
        <Compile Include="Shared\FeatureFlagTypes.fs" />
        <Compile Include="Shared\Types\RoleTypes.fs" />
        <Compile Include="Shared\Types\PermissionTypes.fs" />
        <!-- Phase 66 Stream A.1 — Subject / SurfaceProfile / SurfaceRequirement
             types compiled before AccessContext (which now carries a Subject
             field). ShareTokenTypes hoisted alongside because Subject.ClaimBearer
             references ShareTokenClaim. -->
        <Compile Include="Shared\ShareTokenTypes.fs" />
        <Compile Include="Shared\Types\SurfaceProfile.fs" />
        <Compile Include="Shared\Types\Subject.fs" />
        <Compile Include="Shared\Types\SurfaceRequirement.fs" />
        <Compile Include="Shared\Types\AccessContext.fs" />
        <!-- Phase 113 — host-neutral default-deny action authorization:
             ActionDescriptor / AuthorizationDecision / IActionAuthorizer +
             policy-as-data (ActionRule / ActionPolicy). After AccessContext
             (the Authorize parameter) + PermissionTypes (ModulePermission
             in ActionRequirement). -->
        <Compile Include="Shared\Types\ActionAuthorization.fs" />
        <!-- Phase 266 — extensible host-capability registry: CapabilityId /
             HostCapabilityArgs / HostCapabilityOutcome / IHostCapabilityRegistry
             + the authorizer-gated default `create` + forge-public built-in
             capabilities (clipboard-write / file-read). After
             ActionAuthorization.fs (every Invoke maps to an ActionDescriptor
             and routes through IActionAuthorizer) + AccessContext (the Invoke
             parameter). Fable-safe (plain Dictionary, injected side-effects)
             so it ships under fable/ for the client host bridge. -->
        <Compile Include="Shared\Types\HostCapabilityRegistry.fs" />
        <!-- Phase 268 — neutral hosted-tree render-fault contract:
             HostRenderFault(Kind) + IHostRenderTelemetrySink +
             NoOpHostRenderTelemetrySink. In Core (not Client) so the SSR
             boundary (Phase 273, in ToolUp.PublicRendering which references
             Core not Client) reports through the SAME sink — the shape
             ITelemetrySink / NoOpTelemetrySink already use. No deps beyond
             primitives; Fable-safe so it ships under fable/ for the client
             render path. -->
        <Compile Include="Shared\Types\HostRenderFault.fs" />
        <!-- Phase 274 — hosted-tree content sanitization seam (CSP-aligned):
             HostContentKind / SanitizedContent / HostSanitizePolicy /
             IHostContentSanitizer + the default-deny default sanitizer. In
             Core (shared floor) + BCL-only (hand-rolled scanner, no regex/
             Feliz) so the client (Phase 110) + SSR (Phase 111) legs sanitize
             byte-identically. Ships under fable/ for the client render path. -->
        <Compile Include="Shared\Types\HostContentSanitizer.fs" />
        <!-- Phase 41 — data-classification shared types (ClassificationLevel
             / FieldClassification / FieldHit). Standalone; no deps. -->
        <Compile Include="Shared\Types\ClassificationTypes.fs" />
        <Compile Include="Shared\Types\TeamTypes.fs" />
        <Compile Include="Shared\Types\TeamRoles.fs" />
        <Compile Include="Shared\Types\ModuleAITypes.fs" />
        <Compile Include="Shared\Types\ConversationTypes.fs" />
        <Compile Include="Shared\FeatureFlagApi.fs" />
        <Compile Include="Shared\IModuleQueryBus.fs" />
        <Compile Include="Shared\Types\ConfigTypes.fs" />
        <Compile Include="Shared\Types\ConfigApi.fs" />
        <Compile Include="Shared\Types\BrandingTypes.fs" />
        <Compile Include="Shared\Types\NotificationTypes.fs" />
        <Compile Include="Shared\INotificationChannel.fs" />
        <!-- Phase 241 — presence substrate. -->
        <Compile Include="Shared\IPresenceChannel.fs" />
        <!-- Phase 442 — presence + soft-lock collaboration value types
             (PresenceLocation / PresencePeer / PresenceEvent / EntityLockRef /
             LockLease / LockEvent) + the PresenceMode opt-in DU. Before
             SDK.Shared.fs so ServerConfig can carry a `Presence` field. Pure /
             Fable-safe (BCL primitives + EntityId). -->
        <Compile Include="Shared\PresenceTypes.fs" />
        <Compile Include="Shared\IHealthCheck.fs" />
        <!-- Phase 178 — declarative alert-rule / threshold data (AlertSource
             / ThresholdCondition / AlertDelivery / AlertRule). After
             NotificationTypes (uses SystemMessageLevel + NotificationKind.SinkKind)
             and before SDK.Shared.fs so ServerConfig can carry an
             `AlertRules: AlertRule list` field. Pure / Fable-safe. -->
        <Compile Include="Shared\AlertRule.fs" />
        <Compile Include="Shared\ISmokeTest.fs" />
        <Compile Include="Shared\IConfigValidator.fs" />
        <!-- Phase 165 — opt-in module-binding gate contract (pure types +
             abstract interface; BCL-pure so it ships in the Fable-packed
             source). The default verifier with the crypto lives server-side
             in the ToolUp.ArtefactSigning companion. -->
        <Compile Include="Shared\IModuleBindingVerifier.fs" />
        <Compile Include="Shared\HealthMonitorApi.fs" />
        <Compile Include="Shared\IJobSchedulerTelemetry.fs" />
        <Compile Include="Shared\ServiceStatusTypes.fs" />
        <Compile Include="Shared\ServiceStatusBoardApi.fs" />
        <!-- Phase 177 — deployment-readiness scorecard: report record +
             verdict DU + pure `summarise`, plus the opt-in
             `IDeploymentReadinessApi` read surface. Pure / BCL-only so it
             ships in the Fable-packed source. -->
        <Compile Include="Shared\DeploymentReadiness.fs" />
        <Compile Include="Shared\IDevDiagnosticsContributor.fs" />
        <Compile Include="Shared\NarrativeTypes.fs" />
        <Compile Include="Shared\NarrativePlaintext.fs" />
        <Compile Include="Shared\NarrativeMarkdown.fs" />
        <Compile Include="Shared\NarrativeHtml.fs" />
        <Compile Include="Shared\NarrativeAtom.fs" />
        <Compile Include="Shared\NarrativeBuilder.fs" />
        <Compile Include="Shared\INarrativeRenderer.fs" />
        <Compile Include="Shared\NarrativeRenderers.fs" />
        <!-- Phase 66 Stream C.2 — AuditSubjectKind + AuditSamplingPolicy
             compiled before SDK.Shared.fs so ServerConfig can carry an
             AuditSamplingPolicy field. Depends only on Guid; AuditTypes.fs
             (after SDK.Shared.fs, needs ModuleEvent) references it back. -->
        <Compile Include="Shared\Types\AuditSampling.fs" />
        <!-- Phase 179 — locale + translation primitives (LocaleCode /
             TranslationKey / Translations) + the I18nCoverageMode policy DU,
             split out of I18nTypes.fs so they compile before SDK.Shared.fs and
             ServerConfig can carry `RegisteredLocales` + `I18nCoverageMode`
             fields. Dependency-free / Fable-safe. The ErrorCode / ApiError
             envelope stays in I18nTypes.fs (needs RateLimitedError, defined in
             SDK.Shared.fs). -->
        <Compile Include="Shared\Types\LocaleTypes.fs" />
        <Compile Include="Shared\SDK.Shared.fs" />
        <Compile Include="Shared\IRateLimiter.fs" />
        <Compile Include="Shared\RateLimitDescriptor.fs" />
        <!-- Phase 30a — signed module artefact format (ArtifactManifest,
             SignedArtifact, ArtifactValidation, PublisherKeyId). Compiled
             before AuditTypes.fs so audit payload types can reference the
             publisher-key-id shape via string projections without circular
             dependencies. -->
        <Compile Include="Shared\Types\ArtifactTypes.fs" />
        <Compile Include="Shared\AuditTypes.fs" />
        <Compile Include="Shared\Interfaces\ISubjectResolver.fs" />
        <Compile Include="Shared\Interfaces\IAnonymousSessionMigrator.fs" />
        <Compile Include="Shared\IShareTokenRateLimiter.fs" />
        <Compile Include="Shared\Types\TeamInviteTypes.fs" />
        <Compile Include="Shared\IPendingInviteStore.fs" />
        <Compile Include="Shared\ITeamInviteApi.fs" />
        <!-- 0.5.7 — Generic directory-lookup substrate + Fable.Remoting
             contract. Companion impls (e.g. ToolUp.AuthProviders.EntraDirectory)
             plug into IUserDirectory; the SDK's TeamManagerUI typeahead
             calls IUserDirectoryApi. Returns Ok [] when no companion
             is registered. -->
        <Compile Include="Shared\Types\UserDirectoryTypes.fs" />
        <Compile Include="Shared\WebhookTypes.fs" />
        <Compile Include="Shared\WebhookApi.fs" />
        <Compile Include="Shared\DataObjectTypes.fs" />
        <Compile Include="Shared\DatasetTypes.fs" />
        <Compile Include="Shared\ResultTypes.fs" />
        <Compile Include="Shared\LineageTypes.fs" />
        <Compile Include="Shared\JobTypes.fs" />
        <Compile Include="Shared\JobApi.fs" />
        <!-- Phase 10h — OAuth token refresh substrate types (descriptor + result DU). -->
        <Compile Include="Shared\Types\OAuthRefreshTypes.fs" />
        <!-- Phase 26 — typed deploy-manifest schema (format-neutral; the
             operator's CLI serialises to TOML/YAML/JSON). Pure data; no
             async surface; six-rule audit applies to the four substrate
             interfaces (Server-tier), not this file. -->
        <Compile Include="Shared\Types\DeployManifestTypes.fs" />
        <!-- Phase 26 — supporting types for the four deploy-plane substrate
             interfaces (BuildRequest/BuildSummary, ProvisioningRequest,
             DeployState, ContainerSpec, LogEntry, etc.). Fable-compatible
             (Async-free, no streams); the interfaces themselves are
             server-only because IContainerScheduler.StreamLogs returns
             IAsyncEnumerable. -->
        <Compile Include="Shared\Types\DeployPlaneTypes.fs" />
        <!-- Phase 54 — tenant-lifecycle substrate shared types
             (TenantLifecyclePhase / LifecycleHookResult / LifecycleSummary
             / TenantLifecycleEvent). Async-free + Fable-compatible; the
             ITenantLifecycle interface + aggregator are server-tier. -->
        <Compile Include="Shared\Types\TenantLifecycleTypes.fs" />
        <!-- Phase 543 — derived principal-enumeration shared types
             (PrincipalSummary). After RoleTypes (carries TeamRole);
             before PlatformTenantApi (ListPrincipals returns it).
             Async-free + Fable-compatible. -->
        <Compile Include="Shared\Types\PrincipalRegistryTypes.fs" />
        <!-- Phase 54 — IPlatformTenantApi Fable.Remoting contract. After
             TenantLifecycleTypes (returns LifecycleSummary) + DeployPlaneTypes
             (ProvisionTenant carries ProvisioningRequest). -->
        <Compile Include="Shared\PlatformTenantApi.fs" />
        <Compile Include="Shared\DataIngestionTypes.fs" />
        <Compile Include="Shared\DataIngestionApi.fs" />
        <Compile Include="Shared\MaintenanceApi.fs" />
        <Compile Include="Shared\PlatformAdminApi.fs" />
        <Compile Include="Shared\UsageTypes.fs" />
        <Compile Include="Shared\UsageQueryApi.fs" />
        <!-- Phase 171 — Home / Overview landing API (contract + view
             types + optional IActiveAiProbe DI seam). -->
        <Compile Include="Shared\HomeOverviewApi.fs" />
        <Compile Include="Shared\MetricsTypes.fs" />
        <Compile Include="Shared\Types\ProviderProfileTypes.fs" />
        <Compile Include="Shared\Interfaces\IProviderProfile.fs" />
        <!-- Phase 240 — IPaymentProvider direct-billing substrate. -->
        <Compile Include="Shared\Payments\PaymentTypes.fs" />
        <Compile Include="Shared\Types\I18nTypes.fs" />
        <Compile Include="Shared\I18nDefaults.fs" />
        <Compile Include="Shared\Interfaces\ILocaleResolver.fs" />
        <!-- Phase 179 — translation-coverage gate + pseudo-localisation.
             Pure / BCL-only / Fable-safe so both tiers compile them.
             I18nCoverage.fs after I18nDefaults.fs (audits sdkTranslations +
             messageKeyFor) and IConfigValidator.fs (validator factory);
             PseudoLocale.fs needs only LocaleCode. -->
        <Compile Include="Shared\PseudoLocale.fs" />
        <Compile Include="Shared\I18nCoverage.fs" />
        <Compile Include="Shared\Api.fs" />
        <!-- 0.4.4 — MsgPack binary format folded in from
             ToolUp.Remoting.MsgPack. Used by Platform.Server's remoting
             dispatcher (Server/Remoting/Proxy.fs) and Platform.Client's
             remoting client (Client/Remoting/Remoting.fs); lives in Core
             so both tiers compile against the same source rather than
             duplicating the converters. Compile order matches the
             original ToolUp.Remoting.MsgPack package order. -->
        <Compile Include="Shared\Remoting\MsgPack\TypeShape.fs" />
        <Compile Include="Shared\Remoting\MsgPack\TypeShapeUtils.fs" />
        <Compile Include="Shared\Remoting\MsgPack\Format.fs" />
        <Compile Include="Shared\Remoting\MsgPack\Write.fs" />
        <Compile Include="Shared\Remoting\MsgPack\Read.fs" />
    </ItemGroup>
    <!-- Phase 250 — the connector contract value types (AIProviderMessage,
         AIProviderError, AIContentPart, …) relocated to the Fable-safe
         ToolUp.AI.Wire tier under the unchanged ToolUp.Platform.AI namespace.
         IAIProvider.fs (the interface, which references the server-tier
         RetryPolicy) stays in Core and resolves those types via this
         reference; the de-guarded structured-output fallback routes through
         ToolUp.AI.Wire.JsonHost.parse. ToolUp.AI.Wire is FSharp.Core +
         Fable.Core only, so it preserves Core's "minimum viable consumer
         floor" with no server/client dependency, and ships its source under
         fable/ alongside Core's. -->
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.AI.Wire\ToolUp.AI.Wire.fsproj" />
    </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
