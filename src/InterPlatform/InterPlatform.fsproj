<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.InterPlatform</PackageId>
    <Description>Opt-in inter-platform peer substrate for ToolUp.Platform — typed cross-deployment RPC over JSON-RPC 2.0 with identity propagation, version handshake, job-substrate fusion, and audit. Off by default; zero cost when not enabled.</Description>
    <PackageTags>fsharp;sdk;peer;federation;json-rpc;cross-deployment;rpc</PackageTags>
  </PropertyGroup>
  <!-- Phase 18 inter-platform peer substrate (foundation). Server-only
       companion: no Fable client surface. The "Shared/" types are
       shared between two peer deployments (server-to-server), not
       between a server and a Fable client. -->
  <ItemGroup>
    <Compile Include="Shared\PeerTypes.fs" />
    <Compile Include="Shared\PeerJobHandle.fs" />
    <Compile Include="Shared\JsonRpcEnvelope.fs" />
    <Compile Include="Shared\PeerAuditTransparency.fs" />
    <Compile Include="Shared\PeerCapabilityProfile.fs" />
    <Compile Include="Server\PeerCapabilityNegotiation.fs" />
    <Compile Include="Server\IPlatformPeer.fs" />
    <Compile Include="Server\IPeerClient.fs" />
    <Compile Include="Server\IPeerAuthProvider.fs" />
    <Compile Include="Server\IPeerHandshake.fs" />
    <Compile Include="Server\IPeerRegistry.fs" />
    <!-- Phase 338 — peer-token replay defence + call scoping. Carries the
         `IPeerReplayGuard` seam + its two in-tree implementations, the
         `PeerTokenPolicy` the provider reads, and the `IPeerCallScopedAuth`
         seam. Compiles AFTER `IPeerAuthProvider.fs` (it returns that file's
         `PeerPrincipal`) and BEFORE the provider that applies it. Nothing
         composes a policy by default — `PeerTokenPolicy.unscoped` is the
         pre-338 behaviour (GP 11 / GP 13). -->
    <Compile Include="Server\PeerTokenPolicy.fs" />
    <Compile Include="Server\JwtPeerAuthProvider.fs" />
    <!-- Phase 343 — the asymmetric (ES256 / RS256) peer-auth companion.
         Compiles AFTER JwtPeerAuthProvider.fs because it reuses that
         file's internal `PeerJwt` claim set, signing-input builder and
         post-signature validation tail verbatim — the two providers
         differ only in which secret they read, which `alg` they accept,
         and how the signature is checked, and sharing the rest is what
         stops them drifting. Nothing composes it: `PeerCompose` still
         registers the HS256 default (GP 11), and a deployment that never
         constructs this type pays nothing (GP 13). -->
    <Compile Include="Server\AsymmetricPeerAuthProvider.fs" />
    <Compile Include="Server\DefaultPlatformPeer.fs" />
    <Compile Include="Server\BlobPeerRegistry.fs" />
    <Compile Include="Server\InMemoryPeerHandshake.fs" />
    <Compile Include="Server\PeerReflection.fs" />
    <Compile Include="Server\PeerJobHandler.fs" />
    <Compile Include="Server\PeerProfileProvider.fs" />
    <Compile Include="Server\PeerSchema.fs" />
    <Compile Include="Server\TypeScriptClientGen.fs" />
    <Compile Include="Server\PythonClientGen.fs" />
    <Compile Include="Server\HttpPeerClient.fs" />
    <!-- Phase 314 — PeerCascade compiles BEFORE the typed proxy: the
         proxy's cascade-continuation entry point (`JsonRpcPeerClient.forward`)
         seeds each call from `PeerCascade.deriveNext`, so the bookkeeping
         stays single-sourced rather than re-derived proxy-side. Cascade
         depends only on `Shared/PeerTypes.fs`. -->
    <Compile Include="Server\PeerCascade.fs" />
    <!-- Phase 331 — the receiver-side dual of the cascade bookkeeping:
         the policy record + the pure derivation the JSON-RPC host runs
         over the self-asserted wire context. Depends only on
         `Shared/PeerTypes.fs`; compiles beside `PeerCascade.fs` (its
         sender-side twin) and before both `DefaultPlatformPeer.fs`'s
         consumers and the host that calls it. -->
    <Compile Include="Server\PeerCascadeAuthority.fs" />
    <Compile Include="Server\JsonRpcPeerClient.fs" />
    <Compile Include="Server\JsonRpcPeerHost.fs" />
    <Compile Include="Server\PeerAuditContractHost.fs" />
    <!-- Phase 18c — federation orchestration (fan-out + cascade) over the
         peer foundation. Phase 18b — clean-room privacy-gate broker.
         Neutral substrate; aggregation + domain privacy policy stay out.
         (`PeerCascade.fs` moved above the typed proxy by Phase 314.) -->
    <Compile Include="Server\PeerFanout.fs" />
    <!-- Phase 481 — the calibrated differential-privacy noise mechanism:
         the `NoiseSpec` vocabulary, the CSPRNG bit-source seam, the exact
         discrete Laplace / discrete Gaussian samplers, and the
         `NoisedReleasePolicy` a gate applies. Compiles BEFORE
         CleanRoomBroker.fs because that file's `GateDecision` carries a
         `NoisedRelease` case over these types; it depends on nothing from
         InterPlatform itself (BCL only), so this is the earliest it could
         sit. Nothing composes it unless a deployment calls
         `withNoisedRelease` (GP 13). -->
    <Compile Include="Server\NoiseMechanism.fs" />
    <Compile Include="Server\CleanRoomBroker.fs" />
    <!-- Phase 190 — the cumulative half of the clean-room story: the
         epsilon-budget ledger seam, its three in-tree implementations
         (no-op / in-memory / conditional-blob) and the composed meter.
         Compiles AFTER CleanRoomBroker.fs (it expresses a refusal as
         that file's `GateDecision`) and BEFORE CleanRoomGate.fs, which
         is the only in-tree caller — the gate is where a reservation is
         taken and settled, because that is the one seam every gated
         answer crosses. Deliberately NOT folded into CleanRoomBroker.fs:
         that file's contract is a pure, stateless, synchronous decision,
         and a durable async ledger inside it would contradict its own
         header and drag IBlobStorage into it. Nothing composes a meter
         by default (GP 13). -->
    <Compile Include="Server\PrivacyBudgetLedger.fs" />
    <!-- Phase 311 — the structural half of the clean-room gate: the
         dispatch wrapper that runs the broker on every answer of a gated
         contract, plus the witness type proving a registration went
         through it. Compiles AFTER CleanRoomBroker.fs (it applies that
         file's `Enforce` + `PrivacyGate.observed`) and before
         PeerCompose.fs, its only in-tree caller. Nothing is wrapped
         unless a composition calls `withCleanRoomTemplate` (GP 13). -->
    <Compile Include="Server\CleanRoomGate.fs" />
    <!-- Phase 483 — multi-round protocol orchestrator. Compiles AFTER
         PeerFanout.fs (a round's scatter IS an IPeerFanout call) and
         before PeerCompose.fs; it is not composed by PeerServerApp.run,
         so nothing downstream depends on it (GP 13). -->
    <Compile Include="Server\RoundOrchestrator.fs" />
    <!-- Phase 18f — commutative cipher (OPRF) + two-party private set
         intersection. `CommutativeCipher.fs` carries the seam, the shared
         codec/scalar helpers, and the reference backend; the curve backend
         and the protocol both build on it, so it compiles first.
         `PrivateSetIntersection.fs` depends on the seam and on
         `Shared/PeerTypes.fs` (`PeerError`) only — not on either backend,
         which is what keeps the protocol backend-agnostic. Nothing here is
         composed by `PeerServerApp.run`; the opt-in hook is
         `PeerServerApp.withCommutativeCipher` (GP 13). -->
    <Compile Include="Server\CommutativeCipher.fs" />
    <Compile Include="Server\EcCommutativeCipher.fs" />
    <Compile Include="Server\PrivateSetIntersection.fs" />
    <!-- Phase 343 — the handshake's outbound capability-PROFILE fetch,
         lifted out of PeerCompose.fs so its non-2xx handling is testable
         against a stub HttpMessageHandler instead of only reachable
         through a live compose. Depends on PeerCapabilityNegotiation.fs
         (the legacy degrade), IPeerAuthProvider.fs and IPeerHandshake.fs;
         compiles immediately before its only caller. -->
    <Compile Include="Server\PeerRemoteProfile.fs" />
    <!-- Phase 480 — bilateral clean-room template approval: the content-
         hashed template version, the signed lifecycle record, the
         blob-backed registry + its signer seam, the pure bilateral
         evaluation, the approval-queue projection, and the reserved
         handshake contract. Compiles AFTER CleanRoomGate.fs (it supplies
         that file's `CleanRoomApprovalCheck`), AFTER
         AsymmetricPeerAuthProvider.fs (it signs with the same
         `PeerAsymmetricKeys` custody) and AFTER PeerReflection.fs (the
         handshake host unmarshals with the same shim the typed proxy
         marshals with), and before PeerCompose.fs, its only in-tree
         caller. Nothing is composed unless a deployment calls
         `withTemplateApprovals` (GP 13). -->
    <Compile Include="Server\TemplateApprovalRegistry.fs" />
    <!-- Phase 591 — the federation-graph preflight rule family: the
         pinned-counterparty store, the three declared rules
         (peer-contract-unsatisfied / peer-trust-mismatch /
         peer-surface-stale), the Phase 294 manifest projection, and the
         structural-class IConfigValidator that runs them. Compiles
         BEFORE PeerCompose.fs — the compose record carries the pin store
         and `run` registers the validator — and reads only
         `Shared/PeerTypes.fs` (ConsumedContract / CapabilityList) plus
         the platform's own defect + rule-descriptor types, never
         PeerSurface itself. Taking a pin FROM a published PeerSurface
         export is the later `FederationPin.fs`. Dormant with zero pinned
         surfaces (GP 13). -->
    <Compile Include="Server\FederationPreflight.fs" />
    <Compile Include="Server\PeerCompose.fs" />
    <!-- Phase 590 — the deployment's cross-instance face as data,
         derived from the composed PeerServerApp (compiles after it). -->
    <Compile Include="Server\PeerSurface.fs" />
    <!-- Phase 595 — aggregate peer surface + gateway composition: one
         collective PeerSurface over a set of member surfaces plus an
         explicit exposure selection, and the gateway shape that serves it
         by delegating to the owning member. Compiles after PeerSurface.fs
         (it derives a PeerSurface) and after PeerCompose.fs (the gateway
         registers onto a PeerServerApp). Nothing composes it — the opt-in
         hook is PeerGateway.withAggregate (GP 13). -->
    <Compile Include="Server\AggregatePeerSurface.fs" />
    <!-- Phase 591 — the one road from a counterparty's published
         PeerSurface export to a PinnedPeerSurface: hash-stamp
         verification, format-version refusal, and the reflection-sourced
         trust-facet projection. Compiles AFTER PeerSurface.fs (it reads
         that file's export envelope + posture) and after
         AggregatePeerSurface.fs, so a gateway-fronted group's derived
         surface pins through the identical path a single instance's
         does. -->
    <Compile Include="Server\FederationPin.fs" />
    <!-- Phase 490 — the governed cohort-activation seam: the activation
         vocabulary + its canonical, content-addressed authorisation
         encoding (`IActivationDestination.fs`), then the enforced
         pipeline (`CohortActivation.fs`).

         Appended at the END of the group rather than inserted beside the
         clean-room files, because nothing downstream depends on either:
         the pipeline is not composed by `PeerServerApp.run` (GP 13, the
         posture `RoundOrchestrator` takes), so its position only has to
         satisfy its own dependencies. Those are all far above —
         `CleanRoomBroker.fs` + `CleanRoomGate.fs` (it dispatches THROUGH
         the gate rather than beside it), `PrivacyBudgetLedger.fs` and
         `NoiseMechanism.fs` (the optional invariants it passes along),
         `PrivateSetIntersection.fs` (the Phase 479 `CardinalityOnly`
         preflight and the `Members` run), and
         `TemplateApprovalRegistry.fs`, whose content-hashed bilateral
         approval IS the activation's invariant 0 over a DERIVED
         template. -->
    <Compile Include="Server\IActivationDestination.fs" />
    <Compile Include="Server\CohortActivation.fs" />
    <!-- Phase 491 — the governed outbound signal feed: Phase 490's
         continuous sibling. Appended at the END, after
         `CohortActivation.fs`, because it reuses that pair's
         authorisation vocabulary, canonical encoding and release types
         verbatim (`ActivationAuthorisation`, `ActivationCanonical`,
         `ActivationShape`, `ActivationRelease`, `ActivationRefusal`) and
         adds only what CONTINUITY changes — a mandatory bound, a
         persisted emission cursor, and a per-emission re-evaluation of
         invariant 0 so a revocation stops a RUNNING feed rather than
         merely the next fresh one. Its other dependencies are all far
         above: `CleanRoomGate.fs` (it dispatches THROUGH the gate, once
         per emission), `PrivacyBudgetLedger.fs` (the cumulative ε the
         feed spends continuously) and `NoiseMechanism.fs` (the
         per-emission calibration, mandatory here where Phase 490 leaves
         it optional). Nothing downstream depends on it: the feed is not
         composed by `PeerServerApp.run` and starts no timer of its own
         (GP 13). -->
    <Compile Include="Server\OutboundSignalFeed.fs" />
    <!-- Phase 478 — the gated-output pipeline: an `Isolated`
         external-compute result held ungated, released only through the
         clean-room gate. Last, and appended rather than placed: its
         dependencies are all above it (`CleanRoomGate.fs`, which it
         dispatches THROUGH exactly once per release, plus
         `CleanRoomBroker.fs` / `PrivacyBudgetLedger.fs` /
         `NoiseMechanism.fs` for the optional invariants it forwards) and
         nothing downstream depends on it — it is not composed by
         `PeerServerApp.run` and a deployment that never calls `hold`
         constructs none of it (GP 13). -->
    <Compile Include="Server\GatedComputeOutput.fs" />
    <!-- Phase 638 — the federated model-execution profile: the peer
         contracts that put the model-execution submitter wire objects
         over peer RPC, the admission check every dispatch runs, and the
         governed-diagnostics contract whose only construction route
         demands the clean-room gate. Last, and appended rather than
         placed: every dependency is above it (`CleanRoomGate.fs`, which
         it wraps the diagnostics registration with, `CleanRoomBroker.fs`
         for the answer shape, `PeerJobHandler.fs` for the job-fusion
         pattern the long fit rides, and `IPlatformPeer.fs` for the
         registration shape) and nothing downstream depends on it — it is
         not composed by `PeerServerApp.run`, so a deployment that never
         calls `host` or `governedDiagnostics` constructs none of it
         (GP 13). -->
    <Compile Include="Server\ModelExecutionPeerContract.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 18f — group arithmetic for the commutative cipher: scalar
         multiplication of an arbitrary curve point, and modular inverse on
         a big integer. The BCL exposes neither (ECDiffieHellman offers no
         raw point multiplication; System.Numerics.BigInteger has no
         ModInverse), and hand-rolling curve arithmetic is not a trade this
         SDK makes. Declared directly here per the companion-authoring rule
         that a companion owns its vendor PackageReferences — it already
         arrived transitively from ToolUp.Platform.Server (Ed25519 artefact
         signing), which is why this adds no new dependency to the graph.
         MIT-licensed (GP 2). Nothing vendor-typed reaches the public
         surface: keys and group elements are byte[]. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
  <!-- ToolUp.Remoting.Json.SystemTextJson (FableConverters) + Giraffe +
       ASP.NET Core flow transitively from ToolUp.Platform.Server.
       FSharp.Core is implicit via the .NET SDK. -->
</Project>
