<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.InterPlatform</PackageId>
    <Description>Opt-in inter-platform peer substrate for ToolUp.Platform — typed cross-deployment RPC over JSON-RPC 2.0 with identity propagation, version handshake, job-substrate fusion, and audit. Off by default; zero cost when not enabled.</Description>
    <PackageTags>fsharp;sdk;peer;federation;json-rpc;cross-deployment;rpc</PackageTags>
  </PropertyGroup>
  <!-- Phase 18 inter-platform peer substrate (foundation). Server-only
       companion: no Fable client surface. The "Shared/" types are
       shared between two peer deployments (server-to-server), not
       between a server and a Fable client. -->
  <ItemGroup>
    <Compile Include="Shared\PeerTypes.fs" />
    <Compile Include="Shared\PeerJobHandle.fs" />
    <Compile Include="Shared\JsonRpcEnvelope.fs" />
    <Compile Include="Shared\PeerAuditTransparency.fs" />
    <Compile Include="Shared\PeerCapabilityProfile.fs" />
    <Compile Include="Server\PeerCapabilityNegotiation.fs" />
    <Compile Include="Server\IPlatformPeer.fs" />
    <Compile Include="Server\IPeerClient.fs" />
    <Compile Include="Server\IPeerAuthProvider.fs" />
    <Compile Include="Server\IPeerHandshake.fs" />
    <Compile Include="Server\IPeerRegistry.fs" />
    <!-- Phase 338 — peer-token replay defence + call scoping. Carries the
         `IPeerReplayGuard` seam + its two in-tree implementations, the
         `PeerTokenPolicy` the provider reads, and the `IPeerCallScopedAuth`
         seam. Compiles AFTER `IPeerAuthProvider.fs` (it returns that file's
         `PeerPrincipal`) and BEFORE the provider that applies it. Nothing
         composes a policy by default — `PeerTokenPolicy.unscoped` is the
         pre-338 behaviour (GP 11 / GP 13). -->
    <Compile Include="Server\PeerTokenPolicy.fs" />
    <Compile Include="Server\JwtPeerAuthProvider.fs" />
    <!-- Phase 343 — the asymmetric (ES256 / RS256) peer-auth companion.
         Compiles AFTER JwtPeerAuthProvider.fs because it reuses that
         file's internal `PeerJwt` claim set, signing-input builder and
         post-signature validation tail verbatim — the two providers
         differ only in which secret they read, which `alg` they accept,
         and how the signature is checked, and sharing the rest is what
         stops them drifting. Nothing composes it: `PeerCompose` still
         registers the HS256 default (GP 11), and a deployment that never
         constructs this type pays nothing (GP 13). -->
    <Compile Include="Server\AsymmetricPeerAuthProvider.fs" />
    <Compile Include="Server\DefaultPlatformPeer.fs" />
    <Compile Include="Server\BlobPeerRegistry.fs" />
    <Compile Include="Server\InMemoryPeerHandshake.fs" />
    <Compile Include="Server\PeerReflection.fs" />
    <Compile Include="Server\PeerJobHandler.fs" />
    <Compile Include="Server\PeerProfileProvider.fs" />
    <Compile Include="Server\PeerSchema.fs" />
    <Compile Include="Server\TypeScriptClientGen.fs" />
    <Compile Include="Server\PythonClientGen.fs" />
    <Compile Include="Server\HttpPeerClient.fs" />
    <!-- Phase 314 — PeerCascade compiles BEFORE the typed proxy: the
         proxy's cascade-continuation entry point (`JsonRpcPeerClient.forward`)
         seeds each call from `PeerCascade.deriveNext`, so the bookkeeping
         stays single-sourced rather than re-derived proxy-side. Cascade
         depends only on `Shared/PeerTypes.fs`. -->
    <Compile Include="Server\PeerCascade.fs" />
    <!-- Phase 331 — the receiver-side dual of the cascade bookkeeping:
         the policy record + the pure derivation the JSON-RPC host runs
         over the self-asserted wire context. Depends only on
         `Shared/PeerTypes.fs`; compiles beside `PeerCascade.fs` (its
         sender-side twin) and before both `DefaultPlatformPeer.fs`'s
         consumers and the host that calls it. -->
    <Compile Include="Server\PeerCascadeAuthority.fs" />
    <Compile Include="Server\JsonRpcPeerClient.fs" />
    <Compile Include="Server\JsonRpcPeerHost.fs" />
    <Compile Include="Server\PeerAuditContractHost.fs" />
    <!-- Phase 18c — federation orchestration (fan-out + cascade) over the
         peer foundation. Phase 18b — clean-room privacy-gate broker.
         Neutral substrate; aggregation + domain privacy policy stay out.
         (`PeerCascade.fs` moved above the typed proxy by Phase 314.) -->
    <Compile Include="Server\PeerFanout.fs" />
    <Compile Include="Server\CleanRoomBroker.fs" />
    <!-- Phase 483 — multi-round protocol orchestrator. Compiles AFTER
         PeerFanout.fs (a round's scatter IS an IPeerFanout call) and
         before PeerCompose.fs; it is not composed by PeerServerApp.run,
         so nothing downstream depends on it (GP 13). -->
    <Compile Include="Server\RoundOrchestrator.fs" />
    <!-- Phase 18f — commutative cipher (OPRF) + two-party private set
         intersection. `CommutativeCipher.fs` carries the seam, the shared
         codec/scalar helpers, and the reference backend; the curve backend
         and the protocol both build on it, so it compiles first.
         `PrivateSetIntersection.fs` depends on the seam and on
         `Shared/PeerTypes.fs` (`PeerError`) only — not on either backend,
         which is what keeps the protocol backend-agnostic. Nothing here is
         composed by `PeerServerApp.run`; the opt-in hook is
         `PeerServerApp.withCommutativeCipher` (GP 13). -->
    <Compile Include="Server\CommutativeCipher.fs" />
    <Compile Include="Server\EcCommutativeCipher.fs" />
    <Compile Include="Server\PrivateSetIntersection.fs" />
    <!-- Phase 343 — the handshake's outbound capability-PROFILE fetch,
         lifted out of PeerCompose.fs so its non-2xx handling is testable
         against a stub HttpMessageHandler instead of only reachable
         through a live compose. Depends on PeerCapabilityNegotiation.fs
         (the legacy degrade), IPeerAuthProvider.fs and IPeerHandshake.fs;
         compiles immediately before its only caller. -->
    <Compile Include="Server\PeerRemoteProfile.fs" />
    <Compile Include="Server\PeerCompose.fs" />
    <!-- Phase 590 — the deployment's cross-instance face as data,
         derived from the composed PeerServerApp (compiles after it). -->
    <Compile Include="Server\PeerSurface.fs" />
    <!-- Phase 595 — aggregate peer surface + gateway composition: one
         collective PeerSurface over a set of member surfaces plus an
         explicit exposure selection, and the gateway shape that serves it
         by delegating to the owning member. Compiles after PeerSurface.fs
         (it derives a PeerSurface) and after PeerCompose.fs (the gateway
         registers onto a PeerServerApp). Nothing composes it — the opt-in
         hook is PeerGateway.withAggregate (GP 13). -->
    <Compile Include="Server\AggregatePeerSurface.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 18f — group arithmetic for the commutative cipher: scalar
         multiplication of an arbitrary curve point, and modular inverse on
         a big integer. The BCL exposes neither (ECDiffieHellman offers no
         raw point multiplication; System.Numerics.BigInteger has no
         ModInverse), and hand-rolling curve arithmetic is not a trade this
         SDK makes. Declared directly here per the companion-authoring rule
         that a companion owns its vendor PackageReferences — it already
         arrived transitively from ToolUp.Platform.Server (Ed25519 artefact
         signing), which is why this adds no new dependency to the graph.
         MIT-licensed (GP 2). Nothing vendor-typed reaches the public
         surface: keys and group elements are byte[]. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
  <!-- ToolUp.Remoting.Json.SystemTextJson (FableConverters) + Giraffe +
       ASP.NET Core flow transitively from ToolUp.Platform.Server.
       FSharp.Core is implicit via the .NET SDK. -->
</Project>
