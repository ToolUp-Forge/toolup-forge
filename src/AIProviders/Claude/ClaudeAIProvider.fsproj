<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AIProviders.Claude</PackageId>
    <AssemblyName>ToolUp.AIProviders.Claude</AssemblyName>
    <Description>Claude (Anthropic) IAIProvider implementation for ToolUp.AI. BYOK-capable; reads API keys from ISecretStore.</Description>
    <PackageTags>fsharp;sdk;ai;llm;claude;anthropic;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ClaudeAIProvider.Wire.fs" />
    <Compile Include="ClaudeAIProvider.fs" />
    <Compile Include="ClaudeAIProviderHealth.fs" />
    <!-- Phase 43.B — provider-profile one-click OAuth connect. After the
         provider (it names ClaudeAIProvider.ProviderId). -->
    <Compile Include="OAuth\ClaudeOAuth.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 254 — the portable wire tier: JsonValue / JsonHost for the
         host-portable mapping, the ClaudeStreaming state machine, and the
         IHttpTransport seam. ClaudeAIProvider.Wire.fs depends only on this
         (no System.Text.Json), so it source-compiles into the Fable smoke. -->
    <ProjectReference Include="..\..\ToolUp.AI.Wire\ToolUp.AI.Wire.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <!-- Phase 254 — the .NET HttpClientTransport companion to the portable
         IHttpTransport seam lives in ToolUp.AI.Server. AI.Server takes no
         provider reference, so this is acyclic; the provider already depends
         on the server tier (Platform.Server), so the footprint is unchanged
         in kind. -->
    <ProjectReference Include="..\..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
