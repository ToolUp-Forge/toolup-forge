<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AIProviders.OpenAI</PackageId>
    <AssemblyName>ToolUp.AIProviders.OpenAI</AssemblyName>
    <Description>OpenAI IAIProvider implementation for ToolUp.AI. BYOK-capable; reads API keys from ISecretStore.</Description>
    <PackageTags>fsharp;sdk;ai;llm;openai;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OpenAIProvider.Wire.fs" />
    <Compile Include="OpenAIProvider.fs" />
    <Compile Include="OpenAIProviderHealth.fs" />
    <!-- Phase 43.B — provider-profile one-click OAuth connect. After the
         provider (it names OpenAIProvider.ProviderId). -->
    <Compile Include="OAuth\OpenAIOAuth.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <!-- Phase 252 — the .NET `HttpClientTransport` (Phase 251) injected into
         the provider's egress lives in ToolUp.AI.Server. No cycle:
         ToolUp.AI.Server references only Platform.Core / Platform.Server /
         AI.Core, none of which reference this companion. -->
    <ProjectReference Include="..\..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
