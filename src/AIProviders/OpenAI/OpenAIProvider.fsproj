<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AIProviders.OpenAI</PackageId>
    <AssemblyName>ToolUp.AIProviders.OpenAI</AssemblyName>
    <Description>OpenAI IAIProvider implementation for ToolUp.AI. BYOK-capable; reads API keys from ISecretStore.</Description>
    <PackageTags>fsharp;sdk;ai;llm;openai;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OpenAIProvider.Wire.fs" />
    <Compile Include="OpenAIProvider.fs" />
    <Compile Include="OpenAIProviderHealth.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
