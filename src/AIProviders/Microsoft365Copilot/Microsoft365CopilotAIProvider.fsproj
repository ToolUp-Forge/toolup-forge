<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AIProviders.Microsoft365Copilot</PackageId>
    <AssemblyName>ToolUp.AIProviders.Microsoft365Copilot</AssemblyName>
    <Description>Microsoft 365 Copilot IAIProvider implementation for ToolUp.AI, over the Work IQ Chat API. Answers are grounded in the signed-in user's Microsoft 365 data under the organisation's access controls. Delegated Microsoft Entra ID auth only (Azure.Identity TokenCredential or a caller-supplied user access token).</Description>
    <PackageTags>fsharp;sdk;ai;microsoft-365;copilot;work-iq;entra;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Microsoft365CopilotWire.fs" />
    <Compile Include="Microsoft365CopilotAIProvider.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
  </ItemGroup>
</Project>
