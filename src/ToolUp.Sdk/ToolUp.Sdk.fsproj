<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>ToolUp.Sdk</PackageId>
        <Description>ToolUp SDK meta-manifest — coordinated-bump escape hatch. A consumer Directory.Packages.props imports the package's build/ToolUp.Sdk.props and sets a single ToolUpSdkVersion property; every core package then resolves at that version, and every companion family at the version it shipped beside it. A family's own property (ToolUpAuditSinksVersion, …) moves that family alone. See the package's build/ToolUp.Sdk.props for the full set.</Description>
        <PackageTags>fsharp;sdk;meta-package</PackageTags>
        <!-- The meta-manifest. Empty fsproj: the pack output's value is
             the build/ToolUp.Sdk.props file, which declares <PackageVersion>
             for every shipped ToolUp.* package keyed off its version
             group's property (version-groups.json). Apps add one Import
             and one <ToolUpSdkVersion> property to their
             Directory.Packages.props and get the core at that version and
             each companion family at the version released beside it. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- Content-only package, no DLL: skip symbol generation. -->
        <IncludeSymbols>false</IncludeSymbols>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <None Include="build\ToolUp.Sdk.props" Pack="true" PackagePath="build\" />
    </ItemGroup>
</Project>
