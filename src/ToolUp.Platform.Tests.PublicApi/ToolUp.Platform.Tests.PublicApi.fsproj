<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <!-- The PublicApi pack: the public-API approval gate, over the built assemblies of every packable project.
         The test sources stay under src/ToolUp.Platform.Tests/ and this project
         compiles them from there, because other packs source-link them and
         their citations and __SOURCE_DIRECTORY__ paths must not move. Which
         file is in which pack, and why: docs/migrations/1194-platform-pack-partition.md.
         Its project references are every packable project, one per baseline in
         api-baselines/. They are built, not referenced: the gate renders each
         assembly from that project's own bin/, so building this pack builds
         exactly the surface it renders. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\SurfaceDiff.fs" Link="Contracts\SurfaceDiff.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\PublicApiApproval.fs" Link="Contracts\PublicApiApproval.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\PublicApiApprovalTests.fs" Link="InProcess\PublicApiApprovalTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
