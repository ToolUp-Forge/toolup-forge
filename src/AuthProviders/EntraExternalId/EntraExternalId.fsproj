<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AuthProviders.EntraExternalId</PackageId>
    <AssemblyName>ToolUp.AuthProviders.EntraExternalId</AssemblyName>
    <Description>Microsoft Entra External ID server-side IAuthProvider for ToolUp.Platform: opinionated wrapper around ToolUp.AuthProviders.Oidc with tenant-aware issuer construction, oid/tid claim mapping, and sign-up/sign-in user-flow policy support.</Description>
    <PackageTags>fsharp;sdk;auth;oidc;entra;ciam;server;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EntraExternalIdConfig.fs" />
    <Compile Include="EntraExternalIdAuthProvider.fs" />
    <Compile Include="EntraExternalIdAuthValidator.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- AspNetCore framework reference for HttpContext visibility. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    <ProjectReference Include="..\Oidc\OidcAuthProvider.fsproj" />
  </ItemGroup>
  <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
