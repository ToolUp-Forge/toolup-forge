<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.AuthProviders.EntraDirectory</PackageId>
    <AssemblyName>ToolUp.AuthProviders.EntraDirectory</AssemblyName>
    <Description>Microsoft Graph IUserDirectory companion for ToolUp.Platform — user-search typeahead via Entra (Azure AD) directory.</Description>
    <PackageTags>fsharp;sdk;auth;entra;azure-ad;directory;graph;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EntraDirectory.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
</Project>
