<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.AI Client — Fable + Elmish + Feliz AI surface: side-panel MVU, SSE client, AI assistant UI, AISettings UI, AIClientConfig wrapper. Depends on ToolUp.Platform.Client + ToolUp.AI.Core.</Description>
        <PackageTags>fsharp;fable;feliz;elmish;sdk;client;ai</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Client\ToolUp.Platform.Client.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Core\ToolUp.AI.Core.fsproj" />
        <!-- Phase 1130 — the fact presentation builders a block part is
             rebuilt with (Fable-clean, compiled by both compilers). The
             series read itself is a registration (BlockRender), so this
             tier takes no reference to the fact client. -->
        <ProjectReference Include="..\ToolUp.Facts.Presentation\ToolUp.Facts.Presentation.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 1130 — the published Apache-2.0 Fuaran-UI browser renderer a
             block part is drawn through, at the Fuaran-UI repository pin in
             Directory.Packages.props; restored from nuget.org. -->
        <PackageReference Include="Fuaran.UI.Renderer" />
    </ItemGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
         under fable/. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs;**\*.svg" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.AI\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Client\AIClientTypes.fs" />
        <Compile Include="Client\ClientToolRuntime.fs" />
        <Compile Include="Client\FastPathBridge.fs" />
        <Compile Include="Client\PromptAccessoryBridge.fs" />
        <!-- Phase 36.D — the cross-module read-consent bridge + modal.
             Routed out of band from SSEClient (like ClientToolRuntime) and
             mounted by ConversationPanel, so it must precede both. -->
        <Compile Include="Client\ConsentDialog.fs" />
        <!-- Phase 503 — the tool-approval bridge + modal. Routed out of
             band from SSEClient (like ConsentDialog and ClientToolRuntime)
             and mounted by ConversationPanel, so it must precede both. -->
        <Compile Include="Client\ToolApprovalDialog.fs" />
        <Compile Include="Client\SSEClient.fs" />
        <Compile Include="Client\SidePanelExtensions.fs" />
        <!-- Phase 1130 — a block part, re-read through the registered series
             resolver and drawn through the Fuaran-UI renderer, with its
             furniture. Mounted by ConversationPanel, so it precedes it. -->
        <Compile Include="Client\BlockRender.fs" />
        <Compile Include="Client\ConversationPanel.fs" />
        <Compile Include="Client\Icons.fs" />
        <Compile Include="Client\AIAssistantUI.fs" />
        <Compile Include="Client\AISettingsUI.fs" />
        <Compile Include="Client\PlatformAIKeysAdminUI.fs" />
        <Compile Include="Client\NarrativePromptAdminUI.fs" />
        <Compile Include="Client\AIClientConfig.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 910 — the Fable-tier pack mounts the composer's internal
             view and update (`AIClientConfig.composerView` /
             `composerUpdate`) to measure its render scope without booting
             a server. Test-only visibility; no shipped public surface
             (the ToolUp.Platform.Client precedent). -->
        <InternalsVisibleTo Include="ToolUp.AI.Client.Tests" />
    </ItemGroup>
    <!-- Fable.Core / ToolUp.Remoting.Client / Fable.SimpleJson /
         Fable.SimpleHttp / Feliz flow transitively from
         ToolUp.Platform.Client. The elmish runtime (formerly the three
         ToolUp.Elmish.* packages) was folded into ToolUp.Platform.Client
         in 0.4.3 and arrives the same way. FSharp.Core is implicit via
         the .NET SDK. -->
</Project>
