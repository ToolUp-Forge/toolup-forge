<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.RAG Server — chunking, default in-memory vector store + BM25 index, retrieval pipeline, ingestion + reembedding services, RAGPromptBuilder, RAGCompose. Depends on ToolUp.Platform.Server + ToolUp.AI.Server (RAGCompose wraps AIServerApp).</Description>
        <PackageTags>fsharp;sdk;server;rag</PackageTags>
        <!-- Phase 11.B follow-up cross-tier cutover (2026-05-08): ToolUp.RAG
             Server carries the server-side RAG surface (chunking, vector
             stores, retrieval pipeline, ingestion + reembedding services,
             prompt builder, health handler, RAGCompose). Depends on
             ToolUp.RAG.Core for shared types and ToolUp.AI.Server (RAGCompose
             wraps AIServerApp). -->
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Core\ToolUp.AI.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.RAG.Core\ToolUp.RAG.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.RAG\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Server\Chunking.fs" />
        <Compile Include="Server\NoOpDocUnderstanding.fs" />
        <Compile Include="Server\InMemoryEmbeddingCache.fs" />
        <Compile Include="Server\CachingEmbeddingProvider.fs" />
        <Compile Include="Server\InMemoryVectorStore.fs" />
        <Compile Include="Server\InMemoryBM25Index.fs" />
        <Compile Include="Server\RetrievalTracers.fs" />
        <Compile Include="Server\RagTelemetry.fs" />
        <Compile Include="Server\RetrievalPipeline.fs" />
        <Compile Include="Server\IngestionService.fs" />
        <!-- Phase 14t — scheduled per-chunk ingestion-retry job handler.
             After IngestionService (reuses its Outcome helpers). -->
        <Compile Include="Server\IngestionRetryJobHandler.fs" />
        <!-- Phase 14w — scheduled tombstone auto-vacuum job handler.
             After IngestionService (reuses its Outcome.emitAudit helper). -->
        <Compile Include="Server\RAGVacuumJobHandler.fs" />
        <Compile Include="Server\ReembeddingService.fs" />
        <Compile Include="Server\RAGPromptBuilder.fs" />
        <Compile Include="Server\CitationNormaliser.fs" />
        <Compile Include="Server\CitationNormaliserImpl.fs" />
        <Compile Include="Server\RAGCitationDevEndpoint.fs" />
        <Compile Include="Server\RagHealthHandler.fs" />
        <Compile Include="Server\RagConfigValidator.fs" />
        <!-- Phase 173 — Data Manager ingestion-status observer (drives the
             platform-tier IIngestionStatusStore from chunk-completion events). -->
        <Compile Include="Server\DataManagerIngestionObserver.fs" />
        <!-- Phase 54d — RAG vector-store offboard purge hook. Before
             RAGCompose, which registers it under EnabledTenantLifecycle. -->
        <Compile Include="Server\RagVectorStoreLifecycle.fs" />
        <Compile Include="Server\RAGCompose.fs" />
    </ItemGroup>
    <!-- PackageReferences flow transitively from ToolUp.Platform.Server +
         ToolUp.AI.Server. FSharp.Core is implicit via the .NET SDK. -->
</Project>
