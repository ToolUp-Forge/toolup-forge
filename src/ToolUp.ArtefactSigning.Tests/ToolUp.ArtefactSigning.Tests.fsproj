<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Support\InMemoryStores.fs" />
        <Compile Include="Support\KeyManagedStandIn.fs" />
        <Compile Include="Contracts\IArtefactSignerContract.fs" />
        <Compile Include="Contracts\ISigningProviderConformance.fs" />
        <Compile Include="Support\PerturbedApplicationSigner.fs" />
        <Compile Include="InProcess\DefaultArtefactSignerTests.fs" />
        <Compile Include="InProcess\JwsBuilderTests.fs" />
        <Compile Include="InProcess\CloudKmsArtefactSignerTests.fs" />
        <Compile Include="InProcess\SignedExportBundleTests.fs" />
        <Compile Include="InProcess\ModuleBindingVerifierTests.fs" />
        <Compile Include="InProcess\ModuleBindingTrustResolverTests.fs" />
        <Compile Include="InProcess\BindingRevocationContractTests.fs" />
        <Compile Include="InProcess\ModuleSbomManifestTests.fs" />
        <!-- Phase 589 — certified-surface stamp: the module's ModuleSurface
             projected canonically, signed, and re-derived at compose. After the
             SBOM tests, whose minting shape it mirrors. -->
        <Compile Include="InProcess\ModuleCertificationTests.fs" />
        <Compile Include="InProcess\ApplicationSigningTests.fs" />
        <Compile Include="InProcess\SigningProviderConformanceTests.fs" />
        <Compile Include="InProcess\DeployRecordSealingTests.fs" />
        <Compile Include="InProcess\ApplicationKeyedSigningTests.fs" />
        <!-- Phase 722 — the unregistered-[<Tests>]-list guard, source-linked from
             ToolUp.Platform.Tests so there is one implementation. -->
        <Compile Include="..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.ArtefactSigning\ArtefactSigning.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
</Project>
