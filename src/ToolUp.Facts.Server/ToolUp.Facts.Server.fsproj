<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Facts Server — IFactStore (append-only, bitemporal, content-addressed fact base with derived supersession + AsOf reconstruction) + BlobFactStore default. Depends on ToolUp.Platform.Server + ToolUp.Facts.Core. Phase 520.</Description>
        <PackageTags>fsharp;sdk;server;facts;grounding;provenance</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.Facts.Core\ToolUp.Facts.Core.fsproj" />
        <!-- Phase 565 — grounding certificates ride the Phase 40 artefact-
             signing substrate (IArtefactSigner / IArtefactVerifier). The
             edge runs Facts.Server -> ArtefactSigning -> Platform.Server;
             ArtefactSigning has no Facts.* reference, so it is acyclic. -->
        <ProjectReference Include="..\ToolUp.ArtefactSigning\ArtefactSigning.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\ToolUp.Facts\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Server\IFactStore.fs" />
        <!-- Phase 702 — the metric surface: the derived, columnar
             current-heads read model the population query executes
             against above a size threshold. Compiled ahead of the store
             that maintains it; it depends only on the Core fact model and
             `IBlobStorage`, never on `IFactStore`, so a store that
             indexes differently is unaffected by its presence. -->
        <Compile Include="Server\FactSurface.fs" />
        <Compile Include="Server\BlobFactStore.fs" />
        <Compile Include="Server\FactStoreEvidenceSource.fs" />
        <Compile Include="Server\DisclosureTaint.fs" />
        <Compile Include="Server\FactDisclosureGate.fs" />
        <!-- Phase 623.B — the pure invalidation derivation moved AHEAD of
             the resolver: the read path now derives freshness through
             `FactInvalidation.deriveFreshness` (upstream-aware) and its
             `OnQuery` arm recomputes inline via `IFactRecomputer`, both
             declared here. Nothing in `FactInvalidation.fs` depends on the
             files it moved past, so the reorder is compile-order only. -->
        <Compile Include="Server\FactInvalidation.fs" />
        <Compile Include="Server\FactStoreFactResolver.fs" />
        <Compile Include="Server\FactQueryTool.fs" />
        <Compile Include="Server\AnswerPlanner.fs" />
        <Compile Include="Server\GroundingCertificate.fs" />
        <!-- Grounding certificate exported as a DSSE-wrapped in-toto
             Statement — the standard-interop projection over the
             certificate the file above issues. Pure functions, no
             composition change: a deployment that never exports one pays
             nothing (GP 13). -->
        <Compile Include="Server\CertificateEnvelope.fs" />
        <!-- Phase 683 — the consuming half of the imported-fact provenance
             case: verify a peer's certificate offline against key material
             held for THAT peer, re-derive the content-addressed id, refuse
             on mismatch, and assert under a stance no wider than the one
             the peer sealed. Compiled after the envelope it verifies
             through; nothing is composed unless a deployment asks
             (`FactsCompose.withFactImport`). -->
        <Compile Include="Server\FactImport.fs" />
        <Compile Include="Server\RecomputeJobHandler.fs" />
        <Compile Include="Server\ReactiveDataChange.fs" />
        <Compile Include="Server\CoherenceCheck.fs" />
        <Compile Include="Server\FactsCompose.fs" />
    </ItemGroup>
    <!-- PackageReferences flow transitively from ToolUp.Platform.Server.
         FSharp.Core is implicit via the .NET SDK. -->
</Project>
