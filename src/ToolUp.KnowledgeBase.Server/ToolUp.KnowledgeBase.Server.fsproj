<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.KnowledgeBase Server — document upload + multi-format extraction (PDF / PPTX / DOCX / XLSX / CSV), ingestion observer, narrative-commit, notes / AI-context API. Depends on ToolUp.AI.Server + ToolUp.RAG.Server.</Description>
        <PackageTags>fsharp;sdk;server;knowledge-base</PackageTags>
        <!-- Phase 11.B follow-up cross-tier cutover (2026-05-08): KB Server
             carries the document upload, multi-format extraction, ingestion
             observer, narrative-commit, notes/AI-context API. Depends on
             KB.Core for shared types and ToolUp.RAG.Server (ingestion
             integration) + ToolUp.AI.Server (AIContext flows into prompts). -->
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Core\ToolUp.AI.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.RAG.Core\ToolUp.RAG.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.RAG.Server\ToolUp.RAG.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.KnowledgeBase.Core\ToolUp.KnowledgeBase.Core.fsproj" />
        <!-- Phase 124 — opt-in structured DOCX extraction builds on the
             ToolUp.OpenXml structural model. -->
        <ProjectReference Include="..\ToolUp.OpenXml\ToolUp.OpenXml.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 124 — the KB default-path regression fixtures live in
             the OpenXml companion's test pack; the extractor module is
             `internal`, so the pack needs visibility (same shape as
             Platform.Server → Platform.Tests). -->
        <InternalsVisibleTo Include="ToolUp.OpenXml.Tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.KnowledgeBase\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Server\JsonHelpers.fs" />
        <Compile Include="Server\DocxExtraction.fs" />
        <Compile Include="Server\Extractors.fs" />
        <Compile Include="Server\ExtractionErrors.fs" />
        <Compile Include="Server\IndexStorage.fs" />
        <Compile Include="Server\Recovery.fs" />
        <Compile Include="Server\IngestionObserver.fs" />
        <Compile Include="Server\Notes.fs" />
        <Compile Include="Server\AIContext.fs" />
        <Compile Include="Server\Inventory.fs" />
        <Compile Include="Server\OriginalSourceResolver.fs" />
        <!-- Phase 512 — per-scope age-based retention sweep. Before
             UploadPolicy.fs, which composes its job handler. -->
        <Compile Include="Server\RetentionSweep.fs" />
        <Compile Include="Server\UploadPolicy.fs" />
        <Compile Include="Server\Api\Deps.fs" />
        <Compile Include="Server\Api\Documents.fs" />
        <Compile Include="Server\Api\Narrative.fs" />
        <Compile Include="Server\Api\Notes.fs" />
        <Compile Include="Server\Api\AIContext.fs" />
        <Compile Include="Server\PlatformAdmin.fs" />
        <Compile Include="Server\Server.fs" />
        <Compile Include="Server\KnowledgeBaseLifecycle.fs" />
        <Compile Include="Server\AICompose.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Giraffe / ToolUp.Remoting.Giraffe / ToolUp.Remoting.Json flow
             transitively from ToolUp.Platform.Server + ToolUp.AI.Server.
             FSharp.Core is implicit via the .NET SDK.
             PdfPig + DocumentFormat.OpenXml are unique to KB. -->
        <PackageReference Include="PdfPig" />
        <PackageReference Include="DocumentFormat.OpenXml" />
    </ItemGroup>
</Project>
