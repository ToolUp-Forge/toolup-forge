<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <!-- The Audit pack: the lists whose test files reach the Audit part and no later one.
         The test sources stay under src/ToolUp.Platform.Tests/ and this project
         compiles them from there, because other packs source-link them and
         their citations and __SOURCE_DIRECTORY__ paths must not move. Which
         file is in which pack, and why: docs/migrations/1194-platform-pack-partition.md. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IEventStoreDecoratorContract.fs" Link="Contracts\IEventStoreDecoratorContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IAuditSinkContract.fs" Link="Contracts\IAuditSinkContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IArtifactSignerContract.fs" Link="Contracts\IArtifactSignerContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IArtifactVerifierContract.fs" Link="Contracts\IArtifactVerifierContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IPendingInviteStoreContract.fs" Link="Contracts\IPendingInviteStoreContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\InMemoryBlobStorage.fs" Link="Contracts\InMemoryBlobStorage.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IRateLimiterContract.fs" Link="Contracts\IRateLimiterContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IConsentStateStoreContract.fs" Link="Contracts\IConsentStateStoreContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IEgressGateContract.fs" Link="Contracts\IEgressGateContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\IEvidencePackGeneratorContract.fs" Link="Contracts\IEvidencePackGeneratorContract.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\Support\CacheReset.fs" Link="Support\CacheReset.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\SignedExportTests.fs" Link="InProcess\SignedExportTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\MinimumViableShapeTests.fs" Link="InProcess\MinimumViableShapeTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\InMemoryAuditSinkTests.fs" Link="InProcess\InMemoryAuditSinkTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\Ed25519ArtifactSubstrateTests.fs" Link="InProcess\Ed25519ArtifactSubstrateTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\AuditReplicatorTests.fs" Link="InProcess\AuditReplicatorTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\InMemoryPendingInviteStoreTests.fs" Link="InProcess\InMemoryPendingInviteStoreTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\BlobPendingInviteStoreTests.fs" Link="InProcess\BlobPendingInviteStoreTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\AuditLogModeValidatorTests.fs" Link="InProcess\AuditLogModeValidatorTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\EventStoreChainValidatorTests.fs" Link="InProcess\EventStoreChainValidatorTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\AuditLogHealthCheckTests.fs" Link="InProcess\AuditLogHealthCheckTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\AuditWriteFailureMetricTests.fs" Link="InProcess\AuditWriteFailureMetricTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\AuditFailurePolicyTests.fs" Link="InProcess\AuditFailurePolicyTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\PermissionAuditChainTests.fs" Link="InProcess\PermissionAuditChainTests.fs" />
        <Compile Include="..\ToolUp.Platform.Tests\InProcess\AuditEmitTests.fs" Link="InProcess\AuditEmitTests.fs" />
