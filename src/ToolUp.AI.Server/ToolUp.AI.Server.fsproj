<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.AI Server — agent loop, SSE streaming, tool registry, system-prompt composition (platform + team + module layers), AICompose. Depends on ToolUp.Platform.Server + ToolUp.AI.Core.</Description>
        <PackageTags>fsharp;sdk;server;ai;llm</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Core\ToolUp.AI.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Wire\ToolUp.AI.Wire.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- The parent companion README, packed into each tier's nupkg. -->
        <None Include="..\ToolUp.AI\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <!-- The connector kernel: one provider call, a connector as data, and
             the one IAIProvider over it. Depends on Core, AI.Wire and the
             server tier's HTTP transport only. -->
        <Compile Include="Server\AIAuditEvents.fs" />
        <Compile Include="Server\Providers\ProviderCall.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- AISurfaceDerivationMode + signed capability
             cookie + pure surface resolver. No deps on other AI.Server
             files; must precede SystemPromptBuilder (AIAssistantServerConfig
             carries the mode). -->
        <Compile Include="Server\AISurfaceCapability.fs" />
        <!-- The assistant's language profile: the Fuaran-UI subset a
             deployment registers, its cached prompt fragment and the grammar
             a model-composed block is read against. The schema is a value
             the presentation tier supplies, so this tier references no
             Fuaran-UI assembly. Must precede SystemPromptBuilder, which
             serves the fragment. -->
        <Compile Include="Server\LanguageProfile.fs" />
        <Compile Include="Server\SystemPromptBuilder.fs" />
        <Compile Include="Server\ToolContext.fs" />
        <Compile Include="Server\ToolHelpers.fs" />
        <Compile Include="Server\AIToolRegistry.fs" />
        <!-- The effect envelope a running tool body is held to:
             the ambient declaration, the host-capability and outbound seams
             under it, and the verified-profile refusal of an undeclared tool.
             Depends on AIToolRegistry (the policy) and the platform capability
             gate; MUST precede AIAgentEngine, which stamps it around Execute. -->
        <Compile Include="Server\ToolEffectEnvelope.fs" />
        <Compile Include="Server\NarrativeTools.fs" />
        <!-- The suspended-dispatch mechanism, once: the
             pending-prompt registry, the abandon-on-timeout race, and the
             one budget every suspended round trip in this tier waits on.
             MUST precede AIConsentDispatch (whose registry is a facade
             over it) and ToolApprovalDispatch. Depends on nothing but the
             BCL. -->
        <Compile Include="Server\SuspendedPrompt.fs" />
        <!-- The per-team conversation visibility policy. MUST
             precede ConversationBlobs (whose append gate reads it),
             AIAssistantHandler, which filters every conversation read and
             write through it, and AICompose, which mounts its API. -->
        <Compile Include="Server\TeamConversationPolicyStore.fs" />
        <!-- The conversation record: the four sibling blobs, their read
             rule, the one exchange writer and the ownership gate, over the
             canonical wire types. MUST precede every writer of a sibling:
             AIConsentDispatch (the consent record), AIAssistantHandler and
             FastPathBeaconHandler. `internal`, so it adds no public surface. -->
        <Compile Include="Server\ConversationBlobs.fs" />
        <!-- Per-conversation cross-module read consent: the
             suspended-dispatch registry, the persisted per-conversation
             record, and the gate the four reach tools call. Depends only
             on AI.Core + the platform blob substrate; MUST precede
             PlatformAITools (which calls the gate) and AIAgentEngine
             (which reads the one shared suspended-dispatch timeout from
             here and stamps the items the gate reads). -->
        <Compile Include="Server\AIConsentDispatch.fs" />
        <!-- The cross-module read audit decorator. Reads the
             conversation-id item AIConsentDispatch declares, so it follows
             that file; MUST precede PlatformAITools, which registers its six
             tools through it, and AIAssistantHandler, which stamps the
             active-module item declared here. -->
        <Compile Include="Server\AICrossModuleAudit.fs" />
        <!-- The human-in-the-loop approval gate: the policy
             consult, the held-invocation registry and the approval audit
             trail. Depends on AIToolRegistry (the access-context
             reconstruction) and AIConsentDispatch (the per-turn items
             stamps and the argument-preview redaction it shares); MUST
             precede AIAgentEngine, which calls the gate. -->
        <Compile Include="Server\ToolApprovalDispatch.fs" />
        <!-- Built-in cross-module AI read tools (`_platform.ai.*`).
             Depends only on AIToolRegistry + the platform substrate; registered
             by AICompose alongside NarrativeTools.builtInTools. -->
        <Compile Include="Server\PlatformAITools.fs" />
        <Compile Include="Server\SSEHandler.fs" />
        <Compile Include="Server\ClientToolDispatch.fs" />
        <!-- The `/api/ai/consent` POST handler. Mirrors
             ClientToolDispatch's result endpoint and sits beside it;
             depends on AIToolRegistry (the permission re-check) and
             AIConsentDispatch (the registry + the persisted record). -->
        <Compile Include="Server\AIConsentHandler.fs" />
        <!-- The `/api/ai/tool-approval` POST handler. Mirrors
             AIConsentHandler and sits beside it; depends on
             ToolApprovalDispatch (the registry + the audit writer). -->
        <Compile Include="Server\ToolApprovalHandler.fs" />
        <Compile Include="Server\AICancellationRegistry.fs" />
        <!-- An IAIFieldRegistry a composition root fills from declared
             surfaces. Depends only on the AI.Core field-registry seam. -->
        <Compile Include="Server\DeclaredAIFieldRegistry.fs" />
        <!-- Tier-3 fast-path triage. Depends on ToolContext
             (the ModuleAction emit) + the AI.Core field-registry seam;
             must precede AILatencyMetrics (which registers its metric
             series) and AIAgentEngine (which calls it). -->
        <Compile Include="Server\FastPathTriageResolver.fs" />
        <Compile Include="Server\AILatencyMetrics.fs" />
        <!-- Numeric-fidelity answer gate: canonicalisation +
             IAnswerVerifier seam + post-response stage. Depends only on
             AITypes (Core) + the metric registry / retrieval types (Platform)
             + the metrics seam; placed before the handler that wires it. -->
        <Compile Include="Server\AnswerVerifier.fs" />
        <Compile Include="Server\AIDenialRateMonitor.fs" />
        <Compile Include="Server\ICitationNormaliser.fs" />
        <Compile Include="Server\AIAgentEngine.fs" />
        <!-- The grounded narrative run: the agent loop over
             only the tools passed in, its output through the fact tier's
             grounding gate, published only when every number is a Fact. -->
        <Compile Include="Server\GroundedNarrativeRun.fs" />
        <!-- The offence history and the wording proposals. After
             GroundedNarrativeRun, whose trail rows and wording store it
             reads; before NarrativePromptHandler, which approves. -->
        <Compile Include="Server\NarrativeOffenceHistory.fs" />
        <!-- The narrative wording admin API and the regenerate job.
             After GroundedNarrativeRun, whose wording store, rules and audit
             row it reads. -->
        <Compile Include="Server\NarrativePromptHandler.fs" />
        <!-- The supervised agent-loop worker. Depends on the
             platform ILogger/Logger only; MUST precede AIAssistantHandler,
             which enqueues onto it, and AICompose, which registers it. -->
        <Compile Include="Server\AIChatWorker.fs" />
        <Compile Include="Server\AIAssistantHandler.fs" />
        <Compile Include="Server\ConversationReplay.fs" />
        <Compile Include="Server\AIProviderSurface.fs" />
        <Compile Include="Server\DefaultAIProviderFactory.fs" />
        <Compile Include="Server\BlobPlatformAIKeyStore.fs" />
        <Compile Include="Server\PlatformAIKeysHandler.fs" />
        <!-- The AI tier's IProviderEntryProbe over
             IAIProviderFactory.TryResolveByLabel. After the factory it
             builds on; before AISettingsHandler (verification on
             add/rotate) and AICompose (DI registration). -->
        <Compile Include="Server\AIProviderEntryProbe.fs" />
        <Compile Include="Server\AISettingsHandler.fs" />
        <Compile Include="Server\FastPathBeaconHandler.fs" />
        <Compile Include="Server\ConversationExportAuditHandler.fs" />
        <Compile Include="Server\UIDecodeErrorHandler.fs" />
        <!-- The rolling-window arithmetic the four AI-tier
             `/dev/*` rollups share (window constant + percentiles). Must
             precede all four; `internal`, so it adds no public surface. -->
        <Compile Include="Server\AIDiagnosticsWindow.fs" />
        <Compile Include="Server\FastPathTelemetryHandler.fs" />
        <Compile Include="Server\AILatencyHandler.fs" />
        <Compile Include="Server\AIAllowlistDiagnosticsHandler.fs" />
        <!-- `/dev/ai-cross-module`, the read side of the
             cross-module audit trail. Mounted by AICompose under the same
             EnableDevEndpoints gate as its three siblings above. -->
        <Compile Include="Server\AICrossModuleObservability.fs" />
        <!-- The per-user token-budget check (policy read, window
             sum over the latency stream, read-through cache, refusal
             record, /dev/inspect panel). Before AIProviderUsageMiddleware,
             which stacks the decorator that consumes it into the same
             provider-factory chain as the quota gate. -->
        <Compile Include="Server\AIBudgetEnforcer.fs" />
        <Compile Include="Server\AIProviderUsageMiddleware.fs" />
        <Compile Include="Server\AICancellationDispatchInstanceValidator.fs" />
        <!-- The anonymous-surface AI cost refusal. Depends on
             ServerConfig + the IAIProviderFactory interface only; before
             AICompose, which registers it. -->
        <Compile Include="Server\AnonymousAIModeValidator.fs" />
        <Compile Include="Server\AIProviderEnvValidator.fs" />
        <Compile Include="Server\AIModelEnvValidator.fs" />
        <Compile Include="Server\AIProviderProbeValidator.fs" />
        <Compile Include="Server\LegacyAIConfigProviderProfile.fs" />
        <!-- The IActiveAiProbe seam for the platform Home overview. -->
        <Compile Include="Server\ActiveAiProbe.fs" />
        <Compile Include="Server\AICompose.fs" />
    </ItemGroup>
    <!-- PackageReferences flow transitively from ToolUp.Platform.Server
         (Giraffe / ToolUp.Remoting.Giraffe / ToolUp.Remoting.Json all
         originate there). FSharp.Core is implicit via the .NET SDK. -->
</Project>
