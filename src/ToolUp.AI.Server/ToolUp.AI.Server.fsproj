<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.AI Server — agent loop, SSE streaming, tool registry, system-prompt composition (platform + team + module layers), AICompose. Depends on ToolUp.Platform.Server + ToolUp.AI.Core.</Description>
        <PackageTags>fsharp;sdk;server;ai;llm</PackageTags>
        <!-- Phase 11.B follow-up cross-tier cutover (2026-05-08): ToolUp.AI
             Server carries the server-side AI surface (agent loop, SSE,
             tool registry, system prompt builder, AICompose). Depends on
             ToolUp.AI.Core for shared types and ToolUp.Platform.Server for
             the runtime substrate. Phase 11.C.4 (2026-05-10): Server/
             source relocated into this fsproj's own directory tree. -->
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Core\ToolUp.AI.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.AI\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 251 — the .NET HttpClient transport implementing the
             portable ToolUp.AI.Wire IHttpTransport seam. No deps on other
             AI.Server files; placed first. -->
        <Compile Include="Server\HttpClientTransport.fs" />
        <!-- Phase 6g.F — AISurfaceDerivationMode + signed capability
             cookie + pure surface resolver. No deps on other AI.Server
             files; must precede SystemPromptBuilder (AIAssistantServerConfig
             carries the mode). -->
        <Compile Include="Server\AISurfaceCapability.fs" />
        <Compile Include="Server\SystemPromptBuilder.fs" />
        <Compile Include="Server\ToolContext.fs" />
        <Compile Include="Server\ToolHelpers.fs" />
        <Compile Include="Server\AIToolRegistry.fs" />
        <Compile Include="Server\NarrativeTools.fs" />
        <!-- Phase 503 — the suspended-dispatch mechanism, once: the
             pending-prompt registry, the abandon-on-timeout race, and the
             one budget every suspended round trip in this tier waits on.
             MUST precede AIConsentDispatch (whose registry is a facade
             over it) and ToolApprovalDispatch. Depends on nothing but the
             BCL. -->
        <Compile Include="Server\SuspendedPrompt.fs" />
        <!-- Phase 36.D — per-conversation cross-module read consent: the
             suspended-dispatch registry, the persisted per-conversation
             record, and the gate the four reach tools call. Depends only
             on AI.Core + the platform blob substrate; MUST precede
             PlatformAITools (which calls the gate) and AIAgentEngine
             (which reads the one shared suspended-dispatch timeout from
             here and stamps the items the gate reads). -->
        <Compile Include="Server\AIConsentDispatch.fs" />
        <!-- Phase 503 — the human-in-the-loop approval gate: the policy
             consult, the held-invocation registry and the approval audit
             trail. Depends on AIToolRegistry (the access-context
             reconstruction) and AIConsentDispatch (the per-turn items
             stamps and the argument-preview redaction it shares); MUST
             precede AIAgentEngine, which calls the gate. -->
        <Compile Include="Server\ToolApprovalDispatch.fs" />
        <!-- Phase 36.B — built-in cross-module AI read tools (`_platform.ai.*`).
             Depends only on AIToolRegistry + the platform substrate; registered
             by AICompose alongside NarrativeTools.builtInTools. -->
        <Compile Include="Server\PlatformAITools.fs" />
        <Compile Include="Server\SSEHandler.fs" />
        <Compile Include="Server\ClientToolDispatch.fs" />
        <!-- Phase 36.D — the `/api/ai/consent` POST handler. Mirrors
             ClientToolDispatch's result endpoint and sits beside it;
             depends on AIToolRegistry (the permission re-check) and
             AIConsentDispatch (the registry + the persisted record). -->
        <Compile Include="Server\AIConsentHandler.fs" />
        <!-- Phase 503 — the `/api/ai/tool-approval` POST handler. Mirrors
             AIConsentHandler and sits beside it; depends on
             ToolApprovalDispatch (the registry + the audit writer). -->
        <Compile Include="Server\ToolApprovalHandler.fs" />
        <Compile Include="Server\AICancellationRegistry.fs" />
        <!-- Phase 6j.B — Tier-3 fast-path triage. Depends on ToolContext
             (the ModuleAction emit) + the AI.Core field-registry seam;
             must precede AILatencyMetrics (which registers its metric
             series) and AIAgentEngine (which calls it). -->
        <Compile Include="Server\FastPathTriageResolver.fs" />
        <Compile Include="Server\AILatencyMetrics.fs" />
        <!-- Phase 523 — numeric-fidelity answer gate: canonicalisation +
             IAnswerVerifier seam + post-response stage. Depends only on
             AITypes (Core) + the metric registry / retrieval types (Platform)
             + the metrics seam; placed before the handler that wires it. -->
        <Compile Include="Server\AnswerVerifier.fs" />
        <Compile Include="Server\AIDenialRateMonitor.fs" />
        <Compile Include="Server\AIAgentEngine.fs" />
        <Compile Include="Server\ICitationNormaliser.fs" />
        <Compile Include="Server\AIAssistantHandler.fs" />
        <Compile Include="Server\ConversationReplay.fs" />
        <Compile Include="Server\AIProviderSurface.fs" />
        <Compile Include="Server\DefaultAIProviderFactory.fs" />
        <Compile Include="Server\BlobPlatformAIKeyStore.fs" />
        <Compile Include="Server\PlatformAIKeysHandler.fs" />
        <!-- Phase 43.C — the AI tier's IProviderEntryProbe over
             IAIProviderFactory.TryResolveByLabel. After the factory it
             builds on; before AISettingsHandler (verification on
             add/rotate) and AICompose (DI registration). -->
        <Compile Include="Server\AIProviderEntryProbe.fs" />
        <Compile Include="Server\AISettingsHandler.fs" />
        <Compile Include="Server\FastPathBeaconHandler.fs" />
        <Compile Include="Server\ConversationExportAuditHandler.fs" />
        <Compile Include="Server\UIDecodeErrorHandler.fs" />
        <Compile Include="Server\FastPathTelemetryHandler.fs" />
        <Compile Include="Server\AILatencyHandler.fs" />
        <Compile Include="Server\AIAllowlistDiagnosticsHandler.fs" />
        <Compile Include="Server\AIProviderUsageMiddleware.fs" />
        <Compile Include="Server\AICancellationDispatchInstanceValidator.fs" />
        <Compile Include="Server\AIProviderEnvValidator.fs" />
        <Compile Include="Server\AIModelEnvValidator.fs" />
        <Compile Include="Server\AIProviderProbeValidator.fs" />
        <Compile Include="Server\LegacyAIConfigProviderProfile.fs" />
        <!-- Phase 171 — IActiveAiProbe seam for the platform Home overview. -->
        <Compile Include="Server\ActiveAiProbe.fs" />
        <Compile Include="Server\AICompose.fs" />
    </ItemGroup>
    <!-- PackageReferences flow transitively from ToolUp.Platform.Server
         (Giraffe / ToolUp.Remoting.Giraffe / ToolUp.Remoting.Json all
         originate there). FSharp.Core is implicit via the .NET SDK. -->
</Project>
