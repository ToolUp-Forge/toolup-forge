<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Algorithms Core — analytical-primitive catalog types: AlgorithmInfo / AlgorithmKind / AlgorithmParameterSpec, the four curated operation contracts (regression, descriptive statistics, distribution fit, time-series smoothing), shared request validation, and the IAlgorithmCatalogApi ToolUp.Remoting contract. Zero vendor dependency.</Description>
        <PackageTags>fsharp;sdk;types;algorithms;statistics</PackageTags>
        <!-- Phase 11.E.2 (2026-07-28): the OSS analytical-primitive catalog.
             Tier-suffixed package ids (ToolUp.Algorithms.Core / .Server /
             .Client) — see this companion's README for how they relate to
             the separately-distributed ToolUp.Algorithms package. -->
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    </ItemGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
         under fable/. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.Algorithms\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Shared\AlgorithmTypes.fs" />
        <Compile Include="Shared\AlgorithmOperations.fs" />
        <Compile Include="Shared\AlgorithmParameters.fs" />
        <Compile Include="Shared\AlgorithmCatalogApi.fs" />
    </ItemGroup>
    <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
