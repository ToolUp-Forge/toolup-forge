<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Facts.Presentation Server — the render_chart and render_table AI tools: the model writes a presentation request, the server reads the series it names under the disclosure gate at the tool-result door, draws it with the presentation builders and answers with a text summary the model reads and the block the assistant message carries. And evaluate_pipeline in the same answering form: the summary the model reads and a pipeline block part carrying the request and never a row, with the re-run endpoint a reader's panel draws the block from under the reader's own gate. Composed opt-in with PresentationCompose.withRenderTools and PresentationCompose.withPipelineTool; a deployment that composes neither carries no Fuaran-UI dependency. And the page request resolvers a stored page renders through, a presentation request and a pipeline request answered under the reader's gate and cached per session, composed with PresentationCompose.withPageRequests under a composed fact store.</Description>
        <PackageTags>fsharp;sdk;server;facts;grounding;ai;tools;charts;fuaran-ui</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <!-- ToolUp.Facts.Presentation — the request, its codec and the
             builders (Phase 1129). ToolUp.Facts.Server — the fact browse's
             series read and its dependencies. ToolUp.AI.Server — the
             record form a tool answers and the AI composition record the
             tools are composed onto (Phase 1131). Fuaran.UI arrives through
             ToolUp.Facts.Presentation. -->
        <ProjectReference Include="..\ToolUp.Facts.Presentation\ToolUp.Facts.Presentation.fsproj" />
        <ProjectReference Include="..\ToolUp.Facts.Server\ToolUp.Facts.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Server\RenderTools.fs" />
        <Compile Include="Server\PipelineAnsweringTool.fs" />
        <Compile Include="Server\PageRequestResolver.fs" />
        <Compile Include="Server\PresentationCompose.fs" />
    </ItemGroup>
</Project>
