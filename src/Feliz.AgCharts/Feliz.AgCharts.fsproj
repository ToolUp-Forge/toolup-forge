<?xml version="1.0" encoding="utf-8"?>
<!--
    Feliz.AgCharts — standalone Feliz bindings for AG Charts Community.

    Phase 344 lifted `AgChart.fs` out of ToolUp.Platform.Client, where it
    had lived as `module ToolUp.Platform.AgChart`. Same argument as the
    grid binding beside it: the file opens only Fable.Core /
    Fable.Core.JsInterop / Feliz (plus Browser.Dom, for reading the
    deployment's CSS custom properties when a palette is themed), so it is
    a domain-agnostic wrapper rather than SDK substrate.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Phase 754 — public nuget.org id under the `ToolUp.*` prefix; see
         the fuller note in Feliz.AgGrid.fsproj. `Feliz.AgCharts` was
         itself unclaimed, but a mixed family (one taken id worked
         around, two not) would have been the worse outcome: an
         `.Enterprise` id extending a base id someone else owns misleads
         a reader about who maintains what. The CLR surface is unmoved —
         `module Feliz.AgCharts` and every `open` of it are unchanged. -->
    <PackageId>ToolUp.Feliz.AgCharts</PackageId>
    <AssemblyName>Feliz.AgCharts</AssemblyName>
    <RootNamespace>Feliz.AgCharts</RootNamespace>
    <Description>Feliz bindings for AG Charts Community — typed series, axes, legends, tooltips, markers and the chart theme builder, plus the deferred module-registration guard the Enterprise companion pre-empts. Fable-first: the source packs under fable/ so a Fable consumer compiles it directly.</Description>
    <PackageTags>fsharp;fable;feliz;react;ag-charts;charts;bindings</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AgChart.fs" />
    <Content Include="package.json" />
  </ItemGroup>
  <!-- Client-tier closure: pack source for Fable consumers under fable/.
       See the companion note in Feliz.AgGrid.fsproj. -->
  <ItemGroup>
    <Content Include="**\*.fsproj;**\*.fs" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Browser.Dom" />
    <PackageReference Include="Feliz" />
  </ItemGroup>
</Project>
