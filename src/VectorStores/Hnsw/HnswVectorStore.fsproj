<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.VectorStores.Hnsw</PackageId>
    <AssemblyName>ToolUp.VectorStores.Hnsw</AssemblyName>
    <Description>HNSW approximate-nearest-neighbour IVectorStore for ToolUp.RAG: an in-process graph per scope, kept current incrementally as chunks are written. Measured scale is in the ToolUp.RAG technical guide.</Description>
    <PackageTags>fsharp;sdk;rag;vector-store;hnsw;provider</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HnswVectorStore.fs" />
    <Compile Include="HnswVectorStoreHealth.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 1007: the test pack reads the graph's internal state
         (`HnswVectorStore.GraphStats`) to pin incremental writes and the
         rebuild threshold. -->
    <InternalsVisibleTo Include="ToolUp.Platform.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ToolUp.Remoting.Json (System.Text.Json-based) flows transitively
         from ToolUp.Platform.Server. FSharp.Core is implicit via the
         .NET SDK. HNSW is unique. -->
    <PackageReference Include="HNSW" />
    <!-- MessagePack is transitive via HNSW, which resolves it to 3.1.0 — a
         version carrying published untrusted-payload DoS advisories (3 high,
         6 moderate). Transitive pinning is not enabled repo-wide, so the
         floor is lifted with an explicit reference to the CPM-pinned
         version (3.1.12 since GHSA-qhrr-8q5h-9q3h, fixed in 3.1.9). Not used
         directly by this companion's own source. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
</Project>
