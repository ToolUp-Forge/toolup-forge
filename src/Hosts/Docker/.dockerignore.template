# ─── ToolUp.Platform — .dockerignore template (Phase 16b) ────────────
#
# Excludes paths that should never reach the Docker build context.
# Smaller context → faster `COPY .` → faster builds and smaller layer
# cache invalidation surface.

# .NET build artefacts — re-created inside the build stage.
**/bin/
**/obj/

# Node toolchain artefacts — the client tier installs deps fresh
# inside the build stage if it is included at all.
**/node_modules/

# Fable transpilation output — regenerated by the Fable target inside
# the build stage. Never copy the host's stale output.
**/output/
**/*.fs.js

# VCS noise — never copy local git state into the image.
.git/
.gitignore
.gitattributes

# Local-filesystem stateful blobs — `data/` typically holds dev-only
# in-process EntityStore / IBlobStorage state. Never bake into images.
data/
**/data/

# Editor + IDE state.
.vs/
.vscode/
.idea/
**/*.user

# Local development containers and orchestration overrides — the
# image itself does not need these to build.
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# OS noise.
**/.DS_Store
**/Thumbs.db

# Test results and coverage reports.
**/TestResults/
**/coverage/

# Secrets / dotenvs — anything ending in .env that is not the template
# `*.env.example` documentation file. The build stage receives secrets
# through build args or runtime env vars, never baked-in files.
*.env
!*.env.example
