# ─── ToolUp.Platform — compose.yml template (Phase 16b) ───────────────
#
# Local development orchestration. Brings up the ToolUp deployment as
# a single service alongside whatever companion infrastructure the
# deployment is configured for. Replace `{{...}}` tokens with your
# deployment's values (or let `dotnet new platformsdk-docker` fill
# them in for you).
#
# `compose.yml` is for local-dev convenience; production deployments
# target one of the cloud orchestrators that consume the Dockerfile
# directly — Azure App Service Linux container mode / GCP Cloud Run /
# AWS ECS / Kubernetes. The chapter-14 Docker hosting guide covers
# the per-cloud entry points; this file does not.

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: {{image-name}}:dev
    container_name: {{image-name}}-app
    restart: unless-stopped
    ports:
      - "{{host-port}}:5000"
    environment:
      # ServerConfig knobs read by ServerConfigOverrides.fromEnv.
      # `AllInOne` matches the `AllInOne` default; flip to `WebOnly` /
      # `WorkerOnly` / `DispatcherOnly` to validate the Phase 16a
      # process-model split locally.
      TOOLUP_PROCESS_PROFILE: AllInOne
      # `TOOLUP_TRUST_FORWARDED_HEADERS` is not set — Phase 16d made
      # the trust the SDK default. Set it explicitly only if you are
      # overriding the default for a reverse-proxy-less deployment.
      ASPNETCORE_ENVIRONMENT: Development
    depends_on:
      # Uncomment companion dependencies the deployment composes in.
      # The `dotnet new platformsdk-docker` template fills these
      # automatically based on the symbols you supply at emit time.
      # redis:
      #   condition: service_healthy
      []
    healthcheck:
      test:
        - CMD
        - /usr/local/bin/healthcheck.sh
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3

  # ── Redis — INotificationChannel companion (commented by default) ──
  # Uncomment when ServerConfig.NotificationChannel is `RedisChannel`
  # (TOOLUP_NOTIFICATION_CHANNEL=redis), to share scope-isolated
  # pub/sub state across multi-silo deployments.
  #
  # redis:
  #   image: redis:7-alpine
  #   restart: unless-stopped
  #   command: ["redis-server", "--appendonly", "yes"]
  #   volumes:
  #     - redis-data:/data
  #   healthcheck:
  #     test: ["CMD", "redis-cli", "ping"]
  #     interval: 10s
  #     timeout: 5s
  #     retries: 3

  # ── Multi-cloud parity emulator matrix (Phase 193) ─────────────────
  #
  # Boots each cloud's local emulator so the SAME IBlobStorage /
  # ISecretStore / IAuditSink contract packs can run against all three,
  # proving cross-cloud parity without deploying to a second cloud.
  #
  # EVERY SERVICE BELOW IS BEHIND THE `parity` PROFILE, so a plain
  # `docker compose up` ignores them entirely — this block is zero-cost to
  # ordinary local dev and to any deployment using this template (GP 13).
  # Bring the matrix up explicitly:
  #
  #     docker compose --profile parity up -d
  #
  # then export the harness variables and run the pack:
  #
  #     $env:TOOLUP_PARITY_AZURITE = "UseDevelopmentStorage=true"
  #     $env:TOOLUP_PARITY_LOCALSTACK = "http://localhost:4566"
  #     $env:TOOLUP_PARITY_FAKEGCS = "http://localhost:4443"
  #     dotnet run --project src/ToolUp.Cloud.Parity.Tests/ToolUp.Cloud.Parity.Tests.fsproj
  #
  # TOOL-AVAILABILITY SKIP. The harness gates every leg on its variable
  # above and reports a `pending` case naming the reason when it is unset,
  # so an absent emulator (or an absent Docker daemon, or an image that
  # cannot be pulled) skips cleanly instead of failing. Set a variable ONLY
  # when that emulator is actually up: an armed leg pointed at nothing is
  # correctly red, not skipped.
  #
  # CI note: pre-pull these images in the job rather than relying on
  # pull-on-demand — the same lesson as the IContainerScheduler leg, where
  # the Docker HTTP API does not pull the way `docker run` does.

  azurite:
    profiles: ["parity"]
    image: mcr.microsoft.com/azure-storage/azurite:latest
    restart: unless-stopped
    command: ["azurite-blob", "--blobHost", "0.0.0.0", "--skipApiVersionCheck"]
    ports:
      - "10000:10000"
    healthcheck:
      # Azurite ships no shell utilities beyond node, so probe the blob
      # endpoint with node itself. A 400 from the unauthenticated root is
      # still proof the listener is up — any HTTP response means ready.
      test:
        - CMD-SHELL
        - >-
          node -e "require('http').get('http://127.0.0.1:10000/devstoreaccount1',
          r => process.exit(0)).on('error', () => process.exit(1))"
      interval: 5s
      timeout: 5s
      retries: 12

  localstack:
    profiles: ["parity"]
    image: localstack/localstack:latest
    restart: unless-stopped
    ports:
      - "4566:4566"
    environment:
      # Only the two services the parity matrix exercises — a narrower
      # start-up is faster and makes a missing service an explicit change.
      SERVICES: s3,secretsmanager
      DEBUG: "0"
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:4566/_localstack/health"]
      interval: 5s
      timeout: 5s
      retries: 12

  # One-shot bucket creation. LOAD-BEARING, not convenience: the
  # AwsS3Storage companion deliberately does NOT create its bucket
  # (provisioning and ACLs are the deployment's business), so without this
  # every S3 leg assertion fails on NoSuchBucket. Must match
  # TOOLUP_PARITY_LOCALSTACK_BUCKET (default `toolup-parity`).
  localstack-init:
    profiles: ["parity"]
    image: amazon/aws-cli:latest
    environment:
      AWS_ACCESS_KEY_ID: test
      AWS_SECRET_ACCESS_KEY: test
      AWS_DEFAULT_REGION: us-east-1
    entrypoint: ["/bin/sh", "-c"]
    command:
      # Single `$` on purpose — compose interpolates from the HOST
      # environment at `up` time, so overriding
      # TOOLUP_PARITY_LOCALSTACK_BUCKET for the harness also moves the
      # bucket this creates. A `$$` here would defer to the container's own
      # (empty) environment and silently always use the default.
      - >-
        aws --endpoint-url=http://localstack:4566 s3api create-bucket
        --bucket ${TOOLUP_PARITY_LOCALSTACK_BUCKET:-toolup-parity}
    depends_on:
      localstack:
        condition: service_healthy
    restart: "no"

  # fake-gcs-server. The GCS leg is ARMED as of 2026-08-26 —
  # GoogleCloudStorageConfig gained an `EndpointUrl` seam, so pointing
  # TOOLUP_PARITY_FAKEGCS at this service runs the IBlobStorage and
  # IAuditSink parity packs against it (see
  # src/ToolUp.Cloud.Parity.Tests/EmulatorLegs.fs). The companion does NOT
  # create the bucket; `fake-gcs-init` below pre-creates it, mirroring
  # `localstack-init`. `-scheme http` keeps it TLS-free for local use.
  fake-gcs:
    profiles: ["parity"]
    image: fsouza/fake-gcs-server:latest
    restart: unless-stopped
    ports:
      - "4443:4443"
    command: ["-scheme", "http", "-port", "4443", "-backend", "memory"]

  # Pre-creates the parity bucket, mirroring `localstack-init` — the GCS
  # companion does not create buckets. Single `$` on purpose, for the same
  # reason as `localstack-init`: compose interpolates from the HOST
  # environment at `up` time, so overriding TOOLUP_PARITY_FAKEGCS_BUCKET for
  # the harness also moves the bucket this creates.
  fake-gcs-init:
    profiles: ["parity"]
    image: curlimages/curl:latest
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        curl -sf -X POST http://fake-gcs:4443/storage/v1/b?project=toolup-parity
        -H 'Content-Type: application/json'
        -d '{"name":"${TOOLUP_PARITY_FAKEGCS_BUCKET:-toolup-parity}"}'
    depends_on:
      - fake-gcs
    restart: on-failure

