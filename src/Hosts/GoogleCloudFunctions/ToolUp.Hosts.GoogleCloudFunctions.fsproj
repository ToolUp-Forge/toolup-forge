<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.Hosts.GoogleCloudFunctions</PackageId>
    <AssemblyName>ToolUp.Hosts.GoogleCloudFunctions</AssemblyName>
    <Description>Google Cloud Functions host adapter for ToolUp.Platform. Bridges Functions Framework HTTP invocations through IServerHost.Invoke so a compose-built deployment runs on Google Cloud Functions (2nd gen / Cloud Run functions) without changes to its handler code.</Description>
    <PackageTags>fsharp;sdk;serverless;gcp;google-cloud-functions;cloud-run-functions;host-adapter</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GoogleCloudFunctionHost.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Google.Cloud.Functions.Framework" />
  </ItemGroup>
</Project>
