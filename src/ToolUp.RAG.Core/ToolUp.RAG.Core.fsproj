<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.RAG Core — shared ingestion types (IngestionQueue, IIngestionStatusObserver). The minimum surface a RAG consumer needs to plug into the pipeline.</Description>
        <PackageTags>fsharp;sdk;types;rag</PackageTags>
        <!-- Phase 11.B follow-up cross-tier cutover (2026-05-08): ToolUp.RAG
             companion split into Core/Server. Core carries shared types only
             (IngestionTypes — IngestionQueue, ChunkSource). The "minimum
             viable companion-of-RAG" floor for downstream packages
             (KnowledgeBase). -->
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.RAG\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="IngestionTypes.fs" />
        <!-- Phase 501 — the sparse-index analyzer seam (ISparseAnalyzer +
             AnalysedText + the shipped identity analyzer). Lives in Core, not
             Server, so a language companion under src/SparseIndices/ depends
             on the shared-types floor rather than on the server tier. -->
        <Compile Include="SparseAnalysis.fs" />
    </ItemGroup>
    <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
