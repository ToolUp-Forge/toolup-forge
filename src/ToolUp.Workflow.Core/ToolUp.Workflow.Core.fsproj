<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ToolUp.Workflow.Core</PackageId>
    <Description>BPMN-shaped workflow graph model — parallel split/join, exclusive choice, compensating (saga) tasks, externally-triggered transitions. The graph/saga complement to ToolUp.Forms' linear workflow. Pure F#.</Description>
    <PackageTags>fsharp;workflow;bpmn;saga;state-machine</PackageTags>
    <Version>0.1.0-alpha</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
