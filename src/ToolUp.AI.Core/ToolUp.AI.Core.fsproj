<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.AI Core — shared AI types: IAIProvider extension point, AIToolDefinition, AIAssistantMode, AISettings DTOs, AILatencyTypes. The "minimum viable consumer-of-AI" floor for downstream packages (RAG, KnowledgeBase).</Description>
        <PackageTags>fsharp;sdk;types;ai</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    </ItemGroup>
    <!-- Phase 11.C.2 client-tier closure: pack source for Fable consumers
         under fable/. -->
    <ItemGroup>
        <Content Include="**\*.fsproj;**\*.fs;**\*.svg" Exclude="**\*.fs.js;**\bin\**;**\obj\**" PackagePath="fable\" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.AI\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Shared\AITypes.fs" />
        <!-- Phase 36.D — cross-module read-consent wire shapes
             (AllowDecision / AIConsentMode / the persisted per-conversation
             state / the POST payload). After AITypes, which carries the
             `AIConsentRequired` SSE case; before everything else, which
             does not depend on it. -->
        <Compile Include="Shared\AIConsentTypes.fs" />
        <!-- Phase 503 — human-in-the-loop tool-approval seam + wire shapes
             (IToolApprovalPolicy / ApprovalPrompt / ToolApprovalDecision /
             the POST payload). After AITypes, which carries the
             `ToolApprovalRequired` SSE case; independent of AIConsentTypes,
             and placed beside it because they are the two suspended-prompt
             contracts. -->
        <Compile Include="Shared\AIToolApprovalTypes.fs" />
        <!-- Phase 6j.B — the declared-field seam the Tier-3 triage
             resolver reads. Pure records + one async interface; no
             dependency on other AI.Core files. -->
        <Compile Include="Shared\AIFieldRegistry.fs" />
        <Compile Include="Shared\IAIProviderFactory.fs" />
        <Compile Include="Shared\IPlatformAIKeyStore.fs" />
        <Compile Include="Shared\AISettingsTypes.fs" />
        <Compile Include="Shared\PlatformAIKeysApi.fs" />
        <Compile Include="Shared\AILatencyTypes.fs" />
        <!-- Phase 9s - the per-user AI token budget, expressed on the Phase
             689 platform budget seam. After AILatencyTypes, whose
             `AILatencyRecord` is the stream the window is summed from;
             depends on nothing else in this tier. -->
        <Compile Include="Shared\AIBudgetTypes.fs" />
        <!-- Phase 791 — ModelInput: closed value for everything a provider sees.
             After all other types since it composes AITypes, AILatencyTypes, and
             the Facts disclosure types from Platform.Core. The smart constructor
             enforces affirmative disclosure verdicts at construction time. -->
        <Compile Include="Shared\ModelInput.fs" />
    </ItemGroup>
    <!-- FSharp.Core is implicit via the .NET SDK. -->
</Project>
