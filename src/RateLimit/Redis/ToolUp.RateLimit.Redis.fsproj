<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.RateLimit.Redis</PackageId>
    <AssemblyName>ToolUp.RateLimit.Redis</AssemblyName>
    <Description>Redis IRateLimitStore companion for ToolUp.Platform. INCR + EXPIRE atomic increment-and-check; Lua-scripted true sliding-window. The Kestrel-multi-instance default for high-RPS rate-limit budgets.</Description>
    <PackageTags>fsharp;sdk;rate-limit;redis;distributed</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RedisRateLimitStore.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
</Project>
