<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.EntityStores.Postgres</PackageId>
    <AssemblyName>ToolUp.EntityStores.Postgres</AssemblyName>
    <Description>PostgreSQL / JSONB-backed IEntityStore for ToolUp.Platform — typed entity persistence with real database indexes and SQL predicate pushdown over Npgsql. Binds the shared IEntityStoreContract. Server-only companion.</Description>
    <PackageTags>fsharp;sdk;entity-store;postgresql;jsonb;npgsql;persistence</PackageTags>
  </PropertyGroup>
  <!-- Phase 531 — IEntityStore companion. GP 1 — the Npgsql dependency is
       isolated to this companion; it never reaches ToolUp.Platform.*. GP 2 —
       PostgreSQL + Npgsql (MIT) are free (no paid default). Server-only:
       IEntityStore / EntityRegistry / EntityQueryExecutor live in
       ToolUp.Platform.Server, so this references Server (not just Core). -->
  <ItemGroup>
    <Compile Include="PostgresEntityStore.fs" />
    <Compile Include="PostgresEntityStoreValidator.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
