<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ToolUp.Webhooks.Core</PackageId>
    <Description>Vendor-neutral inbound-webhook verification: scheme-driven HMAC-SHA256 signature verify (Stripe / GitHub / generic), freshness window, dedup + handler contracts. Pure F# — no ASP.NET Core, no vendor SDK.</Description>
    <PackageTags>fsharp;webhooks;hmac;signature;inbound</PackageTags>
    <Version>0.1.0-alpha</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WebhookError.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="WebhookVerifier.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
