<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <!-- Phase 1197 - the inbound-webhook companion (ToolUp.Webhooks.Core / .Server): signature verification, replay window and the inbound job hand-off. The family implements no SDK contract pack of its own.

         A companion family's tests live beside the family and build against
         its closure, not the Platform pack's. The contract packs the family
         conforms to are SOURCE-LINKED from ToolUp.Platform.Tests (Link=…), so
         there is one copy of each law and nothing to drift; the linked
         support files are the closure the moved cases compile against. -->
    <ItemGroup>
        <Compile Include="WebhookSubstrateTests.fs" />
        <Compile Include="..\..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.Webhooks.Core\ToolUp.Webhooks.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Webhooks.Server\ToolUp.Webhooks.Server.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
</Project>
