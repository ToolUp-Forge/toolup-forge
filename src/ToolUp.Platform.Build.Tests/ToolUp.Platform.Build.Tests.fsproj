<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="SbomTests.fs" />
        <Compile Include="PackagedModuleConformanceTests.fs" />
        <!-- Phase 213 — Lighthouse / Core-Web-Vitals budget gate. -->
        <Compile Include="CoreWebVitalsBudgetTests.fs" />
        <!-- Phase 192 — cold-start / hot-path perf-budget gate. -->
        <Compile Include="PerfBudgetTests.fs" />
        <!-- Phase 754 — the template gate's stranger's-package guard,
             probed in both directions. -->
        <Compile Include="TemplateGateTests.fs" />
        <!-- Phase 326 — the ToolUp.Sdk meta-manifest drift guard. The
             reconciler is source-linked from the repo root rather than
             copied, so this test and the `GenerateSdkManifest` FAKE
             target that repairs its findings run one implementation. -->
        <Compile Include="..\..\SdkManifest.fs" Link="SdkManifest.fs" />
        <Compile Include="SdkManifestTests.fs" />
        <!-- Phase 184 — the fresh-machine published-package smoke gate's
             offline-decidable rules. Source-linked from the repo root for
             the same reason SdkManifest.fs above is: the FAKE target and
             these go-red proofs run one implementation. The gate itself
             only runs on a release tag, so without this pack its rules
             would first be exercised on the release they protect. -->
        <Compile Include="..\..\PublishedSmoke.fs" Link="PublishedSmoke.fs" />
        <Compile Include="PublishedSmokeTests.fs" />
        <!-- Phase 260 — the release bump derived from the api-baselines
             diff. Source-linked from the repo root for the same reason
             SdkManifest.fs and PublishedSmoke.fs above are: the
             VerifySemVerBump target and these go-red proofs run one
             implementation. The target runs once, at a release; this
             pack decides the rule on every commit, so the release is not
             the first exercise of it.

             SurfaceDiff.fs is the public-API approval gate's own
             comparer, source-linked ahead of it so the bump classifies
             the SAME set difference the gate reports — a second
             tokeniser would disagree with it about whether a member
             moved. -->
        <Compile Include="..\ToolUp.Platform.Tests\Contracts\SurfaceDiff.fs" Link="Contracts\SurfaceDiff.fs" />
        <Compile Include="..\..\SemVerBump.fs" Link="SemVerBump.fs" />
        <Compile Include="SemVerBumpTests.fs" />
        <!-- Phase 259 — the conformance-pack coverage gate. Pure file
             scanning over the checkout (api-baselines, the Contracts
             directory, the `.fs` tree), so it belongs beside the other
             build-time gates rather than in the runtime Platform pack. -->
        <Compile Include="ConformanceCoverage.fs" />
        <Compile Include="ConformanceCoverageTests.fs" />
        <!-- Phase 722 — the unregistered-[<Tests>]-list guard, source-linked from
             ToolUp.Platform.Tests so there is one implementation. -->
        <Compile Include="..\ToolUp.Platform.Tests\Support\TestRegistrationGuard.fs" Link="Support\TestRegistrationGuard.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Build\ToolUp.Platform.Build.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Expecto" />
    </ItemGroup>
    <!-- Phase 213 — Core-Web-Vitals gate fixtures: Lighthouse report JSON
         reduced to the fields the gate reads, plus the budgets and
         server-counter snapshots they are checked against. -->
    <ItemGroup>
        <None Include="fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- The SHIPPED default budget, linked in so a typo in it fails
             this pack rather than the first CI gate run. Linked rather
             than copied: there is one budget file and the sample owns
             it. -->
        <None Include="..\..\samples\PublicSite\cwv-budget.json"
              Link="fixtures\cwv\shipped-budget.json"
              CopyToOutputDirectory="PreserveNewest" />
        <!-- Phase 192 — the SHIPPED perf budget, linked in for the same
             reason as the one above: a typo in it fails this pack rather
             than the first CI gate run, and the tests decide against the
             same bytes CI does. -->
        <None Include="..\..\perf-budgets.json"
              Link="fixtures\perf\shipped-budget.json"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
