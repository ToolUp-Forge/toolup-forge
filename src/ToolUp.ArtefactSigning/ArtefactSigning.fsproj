<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ToolUp.ArtefactSigning</PackageId>
    <AssemblyName>ToolUp.ArtefactSigning</AssemblyName>
    <Description>Cryptographic artefact-signing substrate for ToolUp.Platform — per-deployment ECDSA P-256 / Ed25519 detached-JWS signing of arbitrary artefacts (audit packs, exported reports), with a public verification-key endpoint. Server-only companion.</Description>
    <PackageTags>fsharp;sdk;signing;jws;ecdsa;ed25519;compliance;non-repudiation</PackageTags>
  </PropertyGroup>
  <!-- Phase 40 artefact-signing substrate. Server-only companion: no
       Fable client surface. The detached-JWS signature + public-key
       endpoint are server-to-verifier concerns. -->
  <ItemGroup>
    <Compile Include="Shared\SigningTypes.fs" />
    <!-- Application signing seam: attestation level, purpose framing, and
         key lifecycle as recorded data. Purely additive over the byte-level
         signing types above; nothing here is reachable unless a deployment
         composes an application signer. -->
    <Compile Include="Shared\ApplicationSigningTypes.fs" />
    <Compile Include="Server\IArtefactSigner.fs" />
    <Compile Include="Server\IArtefactVerifier.fs" />
    <Compile Include="Server\ISigningKeyLedger.fs" />
    <Compile Include="Server\JwsBuilder.fs" />
    <Compile Include="Server\SigningInternals.fs" />
    <Compile Include="Server\DefaultArtefactSigner.fs" />
    <Compile Include="Server\DefaultArtefactVerifier.fs" />
    <Compile Include="Server\SecretStoreSigningKeyLedger.fs" />
    <Compile Include="Server\IApplicationSigner.fs" />
    <Compile Include="Server\ApplicationSigning.fs" />
    <!-- Phase 165 — default IModuleBindingVerifier (declared in
         ToolUp.Platform.Core). Lives here so it can reuse the internal
         Jws verify primitives + BouncyCastle without widening any public
         surface, and so the crypto stays off the Fable client tier. -->
    <Compile Include="Server\DeployRecordSealing.fs" />
    <Compile Include="Server\DefaultModuleBindingVerifier.fs" />
    <!-- Phase 170 — trust-anchor config → verifier + fail-closed preflight
         validator (resolves symmetric secrets via ISecretStore). After the
         default verifier it builds on. -->
    <Compile Include="Server\ModuleBindingTrustResolver.fs" />
    <Compile Include="Server\SigningKeyHandler.fs" />
    <Compile Include="Server\Helpers.fs" />
    <!-- Phase 162 — signed compliance export bundle: adapts IArtefactSigner
         onto the neutral IExportEnvelopeSigner seam in ToolUp.Platform.Server
         (the dependency runs ArtefactSigning -> Platform.Server, so the glue
         lives here, not in Platform.Server). -->
    <Compile Include="Server\SignedExportBundle.fs" />
    <!-- Phase 646 — acceptance signature over a promoted model artifact:
         the same adaptation, onto the neutral IPromotedArtifactSigner seam,
         and here for the same dependency-direction reason. -->
    <Compile Include="Server\PromotedArtifactBundle.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <!-- Ed25519 sign/verify (BCL has no native Ed25519); ECDSA P-256
         uses System.Security.Cryptography. Same crypto provider the
         Phase 30a artefact substrate uses. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
  <!-- Giraffe + ASP.NET Core + System.Text.Json flow transitively via
       ToolUp.Platform.Server. -->
</Project>
