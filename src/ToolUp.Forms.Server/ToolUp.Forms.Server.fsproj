<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>ToolUp.Forms Server — schema-driven form persistence (IFormStore + BlobFormStore), state-machine workflow engine, validator, public-form API + share-link tokens, FormsCompose. Depends on ToolUp.Platform.Server + ToolUp.Forms.Core.</Description>
        <PackageTags>fsharp;sdk;server;forms</PackageTags>
        <!-- Phase 11.B follow-up cross-tier cutover (2026-05-08): Forms
             Server carries the form-store, workflow-engine, validator,
             aggregation helpers, IFormSubmissionAnalyser extension point,
             form/public-form API handlers, PublishableFormConfigValidator,
             FormsCompose. -->
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\ToolUp.Forms.Core\ToolUp.Forms.Core.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Phase 11.C.2 closure: parent companion README packed into each tier's nupkg. -->
        <None Include="..\ToolUp.Forms\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="Server\IFormStore.fs" />
        <Compile Include="Server\IWorkflowEngine.fs" />
        <Compile Include="Server\EntityRegistrations.fs" />
        <Compile Include="Server\FormStore.fs" />
        <Compile Include="Server\InMemoryActionLedger.fs" />
        <Compile Include="Server\ActionLedgerMetrics.fs" />
        <Compile Include="Server\WorkflowEngine.fs" />
        <Compile Include="Server\FormValidator.fs" />
        <Compile Include="Server\ValidationAttributeBridge.fs" />
        <Compile Include="Server\Aggregations.fs" />
        <Compile Include="Server\IFormSubmissionAnalyser.fs" />
        <Compile Include="Server\AnalyserCache.fs" />
        <Compile Include="Server\FormApiHandler.fs" />
        <Compile Include="Server\InMemoryShareTokenRateLimiter.fs" />
        <Compile Include="Server\PublicFormApiHandler.fs" />
        <Compile Include="Server\PublishableFormConfigValidator.fs" />
        <Compile Include="Server\FormsCompose.fs" />
    </ItemGroup>
    <!-- PackageReferences flow transitively from ToolUp.Platform.Server.
         FSharp.Core is implicit via the .NET SDK. -->
</Project>
