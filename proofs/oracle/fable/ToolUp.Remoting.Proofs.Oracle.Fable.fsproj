<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <!-- Phase 850 — the proved Elmish models, extracted, for the FABLE host:
         the browser's own runtime runs them directly.

         Four files, and the point is which four. `FStarCustard.fs` beside
         this project is the Fable host's stand-in for Custard's support
         library — since Phase 957 DERIVED by `proofs/check.ps1` from the
         generated one (its `Prims` block, verbatim) and byte-held, where
         Phase 955's stand-in was hand-written and empty and Phase 850's
         `Prims.fs` was a hand-written shim over machine integers. The other
         three are the SAME committed extractions the .NET oracle compiles —
         `../custard/ElmishRing.fs`, `../custard/ElmishLoop.fs` and
         `../custard/ElmishRingArray.fs`, in Custard's order — so the models the
         Fable pack runs are, byte for byte, the models the prover produced
         and the .NET differential runs, over the same `bigint` the .NET host
         computes with. The two hosts no longer differ in representation.

         `ToolUp.AI.Client.Tests` references this project and Fable
         transpiles all four files with the rest of the client tier;
         `check.ps1` also builds it on .NET, which is the cheap half of
         "compiles on both hosts".

         It lives under `proofs/oracle/` on purpose: the `Directory.Build.props`
         one level up stops the repository-wide MSBuild walk and states the
         FS0025 promotion (Phase 624) itself (Phase 1037), so this host
         compiles the extractions under the same incomplete-match rule as
         the .NET one. It is a second HOST for the generated oracle, which
         is what that props file says the directory is for.

         Not in the solution, like the .NET oracle: reached by ProjectReference. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);64</NoWarn>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Fable-touching projects keep nullness off, per the forge CLAUDE.md. -->
        <Nullable>disable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <!-- DERIVED from ../custard/FStarCustard.fs by check.ps1 — do not edit.
             Must precede the extractions, which open it. -->
        <Compile Include="FStarCustard.fs" />
        <!-- GENERATED — the committed extractions, shared with the .NET
             oracle. Do not edit. -->
        <Compile Include="../custard/ElmishRing.fs" />
        <Compile Include="../custard/ElmishLoop.fs" />
        <Compile Include="../custard/ElmishRingArray.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Explicit, as every Fable-compiled project in the tree: the
             SDK-bundled implicit FSharp.Core is too old for Fable's cracker. -->
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>
