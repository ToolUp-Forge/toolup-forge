<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <!-- Phase 787 — the F* model of the remoting decoder algebra, extracted
         to F# and compiled so the differential host can RUN it beside
         production over the Phase 784 corpus.

         `RemotingDecode.fs` is GENERATED: `proofs/check.ps1` re-extracts it
         from `proofs/RemotingDecode.fst`, lays it out through
         `proofs/normalise-extraction.fsx`, and byte-compares the result
         against the committed copy, so editing it by hand is a change the
         proof leg refuses rather than one it absorbs. It is committed
         nonetheless, and deliberately: the F* toolchain is a 198 MB
         download, and requiring it to BUILD the repo would put a prover on
         the critical path of every contributor and every CI job that has
         nothing to do with proofs. The committed extraction is the seam —
         `VerifyAll` compiles it like any other source, and the proofs job
         is what holds it honest.

         No layout flag. Until Phase 850 this project carried the
         strict-indentation opt-out in `OtherFlags` (and FS0058 in `NoWarn`)
         because the F# backend emits pre-F#-8 layout; Fable reads no such flag from an
         fsproj, F# 10 refuses the verbose-syntax directive that would have
         been the other route (FS1205), and Fantomas cannot parse the raw
         output. The normaliser is the answer to all three at once: the
         committed extractions are indentation-clean F# that this project,
         the Fable host beside it (`fable/`) and any future host compile
         with nothing relaxed. What remains forced by the extractor:

           * `FS0064` (a type instantiated less generally than its
             annotation) off, in this scope only — the extractor annotates
             every parameter and some of those annotations are narrower than
             the inferred type.

         The incomplete-match warnings the extractor's field projectors
         produce are NOT suppressed here — naming FS0025 in `NoWarn` is
         exactly what the Phase 624 gate forbids. They stay warnings
         because `Directory.Build.props` beside this file stops the
         repository-wide walk, which is the documented mechanism; read that
         file for why, and for what a reader gives up by it. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);64</NoWarn>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <!-- The whole runtime the extraction needs. Must precede it. -->
        <Compile Include="Prims.fs" />
        <!-- GENERATED from ../RemotingDecode.fst — do not edit. -->
        <Compile Include="RemotingDecode.fs" />
        <!-- Phase 790 — GENERATED from ../DisclosureFold.fst — do not edit.
             Independent of RemotingDecode.fs (it owns its own opt/pair), so
             order between the two extractions is immaterial; later proof
             phases APPEND their extraction below. -->
        <Compile Include="DisclosureFold.fs" />
        <!-- Phase 793 — the tool gate model, extracted. Same discipline: the
             byte-diff in check.ps1 holds it identical to the prover output. -->
        <Compile Include="ToolGate.fs" />
        <!-- Phase 792 — GENERATED from ../ModelInput.fst — do not edit.
             Independent of both extractions above (it owns its own opt and
             adds its own outcome), so order among the three is immaterial;
             later proof phases APPEND their extraction below. -->
        <Compile Include="ModelInput.fs" />
        <!-- Phase 795 — GENERATED from ../TaintFlow.fst — do not edit.
             Independent of both extractions above (it owns its own opt/pair),
             so order between the three is immaterial. -->
        <Compile Include="TaintFlow.fs" />
        <!-- Phase 788 — GENERATED from ../ElmishRing.fst and ../ElmishSub.fst
             — do not edit. Independent of every extraction above (each owns
             its own opt/pair). The runtime they model also ships to the
             browser: since Phase 850 the Fable pack compiles ElmishRing.fs
             DIRECTLY (through `fable/ToolUp.Remoting.Proofs.Oracle.Fable.fsproj`,
             over a machine-integer Prims) and runs it live beside the
             transpiled runtime, as well as replaying the corpus under
             tests/elmish-proof-corpus/ that the .NET host writes. -->
        <Compile Include="ElmishRing.fs" />
        <Compile Include="ElmishSub.fs" />
        <!-- Phase 789 — GENERATED from ../ElmishLoop.fst — do not edit. The
             FIRST extraction that depends on another: it opens ElmishRing
             for the ring, its opt/pair and append, so it must follow
             ElmishRing.fs. Later proof phases APPEND their extraction below. -->
        <Compile Include="ElmishLoop.fs" />
    </ItemGroup>
</Project>
