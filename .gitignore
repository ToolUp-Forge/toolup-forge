secrets.json

# Vite dotenv files (sample apps).
**/.env.local
**/.env.*.local

# Sample-app runtime data (event store / entity store directories spun
# up by the SDK on first run). Source content under `samples/*/content/`
# is tracked; runtime state under `samples/*/data/` is not.
samples/*/data/
# Same class at the repo root — running a sample/test server with the
# repo root as cwd spins up `data/_platform/{dataprotection,preflight}`.
/data/

# Claude Code worktrees + per-machine settings.
.claude/worktrees/
.claude/settings.local.json

# Neutrality-guard token source (OSS boundary): the private
# banned-vocabulary list the ToolUp.Platform.Tests grep-guard loads at
# run time. Never tracked — publishing it would leak exactly what the
# guard exists to keep out of this repo.
/neutrality-tokens.local.txt

# Phase 620 — extracted documentation snippets. `VerifyDocSnippets`
# regenerates `docs-snippets/generated/` from the fenced `fsharp` blocks
# in `docs/**` on every run, so the sources are build output, not
# content. The project itself, its README and `known-drift.txt` ARE
# tracked; only the extraction is not.
docs-snippets/generated/

# CI checks out the external model-execution conformance corpus here (a
# separate repository, pinned by revision — see the `verify-all` job in
# .github/workflows/checks.yml). Never content of this repo.
.model-execution-corpus/

# A checkout of the federation-seam specification home, which this repository
# certifies against but does not own. See docs/interplatform/FEDERATION_WIRE.md.
/fuaran-federation-spec/
