<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);data\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Server.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ToolUp.Platform.Core" />
    <PackageReference Include="ToolUp.Platform.Server" />
    <ProjectReference Include="..\Modules\Chat\Chat.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 0.4.4 — ToolUp.Remoting.{Giraffe,Json} flow transitively from
         ToolUp.Platform.Server after the fold. -->
    <PackageReference Include="Giraffe" />
  </ItemGroup>
</Project>
