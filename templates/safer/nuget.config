<?xml version="1.0" encoding="utf-8"?>
<!--
  ToolUp.* packages are consumed from a local NuGet feed during
  development. After the toolup-forge GitHub Packages feed goes live,
  replace the `local` source with the cloud URL. The relative
  `../local-nuget-feed` path assumes this app lives as a sibling of the
  `local-nuget-feed` directory.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="../local-nuget-feed" />
  </packageSources>
</configuration>
