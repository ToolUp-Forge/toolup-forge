<?xml version="1.0" encoding="utf-8"?>
<!--
  Released ToolUp.* packages resolve from nuget.org (no auth needed).
  The `local` source serves unreleased in-development packs; the
  relative `../local-nuget-feed` path assumes this app lives as a
  sibling of the `local-nuget-feed` directory — remove that source if
  you only consume released versions.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="../local-nuget-feed" />
  </packageSources>
</configuration>
