<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SharedTypes.fs" />
    <Compile Include="Server.fs" />
    <None Include="ClientModel.fs" />
    <None Include="ClientView.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ToolUp.Platform.Core" />
    <!-- Unlike a plain module (which needs Core only), this template's
         Server.fs implements `IDataSource` — a server-tier connector
         interface declared in ToolUp.Platform.Server. The shared record
         types it traffics in (DataSourceConfig / TableSchema /
         IngestionError) live in Core. -->
    <PackageReference Include="ToolUp.Platform.Server" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
