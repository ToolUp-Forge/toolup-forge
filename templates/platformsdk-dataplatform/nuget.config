<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this application.
  - `nuget.org` serves the released ToolUp.* packages and every third-party
    package. Anonymous restore, no auth.
  - `local` is a folder feed for unreleased ToolUp.* packs. Its path was
    chosen at scaffold time and is the only machine-shaped path in the
    repository; delete this source if you only consume released versions.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="LOCAL_FEED_PATH" />
  </packageSources>
</configuration>
