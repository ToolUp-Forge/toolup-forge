<Project>
  <!--
    Present at the repository root, so MSBuild stops walking up here: an
    instantiated copy inherits nothing from whatever directory it sits under.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      FS0025 (incomplete pattern match) is an ERROR even though warnings
      in general are not. The compiler reports only ONE of the cases a
      match misses, so as a warning it lets a match fall several cases
      behind a union with the build still green. As an error the fix loop
      continues until the match is exhaustive. Do not reach for `| _ ->`
      to get green: a wildcard silences the check for good. Enumerate the
      missing cases; where one is genuinely unreachable, match it
      explicitly and fail loudly in its body.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
  </PropertyGroup>
</Project>
