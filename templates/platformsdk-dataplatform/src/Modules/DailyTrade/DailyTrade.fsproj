<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SharedTypes.fs" />
    <Compile Include="Server.fs" />
    <None Include="ClientModel.fs" />
    <None Include="ClientView.fs" />
    <None Include="DailyTrade.Client.props" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ToolUp.Platform.Core" />
    <!-- IDataSource, IGroundedNarrativeRun and the request's resolved scope. -->
    <PackageReference Include="ToolUp.Platform.Server" />
    <!-- FactValue / TemporalExtent and the IFactTableWriter the module writes through. -->
    <PackageReference Include="ToolUp.Facts.Core" />
    <PackageReference Include="ToolUp.Facts.Server" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
