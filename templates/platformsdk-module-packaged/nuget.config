<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this module repo.

  - `nuget.org` — the released ToolUp.* packages plus third-party
    (Feliz, Fable.*, Expecto, FAKE). Anonymous restore, no auth.
  - `local` — a folder feed for unreleased packs, and the folder this
    repo's own `Pack` target writes to. The path was chosen at scaffold
    time; it is the ONLY machine-shaped path in the generated repo.
    Delete this source if you only ever consume released versions.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="LOCAL_FEED_PATH" />
  </packageSources>
</configuration>
