<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Build.fs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Carries the packaged-module shadow-project conformance
             check and its `VerifyPackagedModule` FAKE target. -->
        <PackageReference Include="ToolUp.Platform.Build" />
        <PackageReference Include="Fake.Core.Target" />
        <PackageReference Include="Fake.IO.FileSystem" />
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>
