<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- The vendored conformance pack compiles the client-tier
             registration path, same as the module assembly does. -->
        <DefineConstants>FABLE_COMPILER</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <!--
            Contracts/ModuleContract.fs is VENDORED from the SDK. The
            pack ships in the SDK's own test project, which is not
            packable, so copying it is the documented adoption route —
            the same one every SDK contract pack uses. Re-copy it when
            you take an SDK upgrade; it depends only on Expecto and the
            ToolUp packages this module already references.
        -->
        <Compile Include="Contracts\ModuleContract.fs" />
        <Compile Include="ModuleConformanceTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\MyModule\MyModule.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Expecto" />
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>
