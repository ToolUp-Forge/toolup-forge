# Generated by `toolup k8s emit` — do not hand-edit; re-run the command.
# Role: {{role}} (TOOLUP_PROCESS_PROFILE={{profile}}). Image spec mirrors
# templates/platformsdk-docker/Dockerfile.template — container port 5000,
# non-root uid/gid 10001.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{name}}"
  labels:
    app.kubernetes.io/name: "{{slug}}"
    app.kubernetes.io/instance: "{{slug}}"
    app.kubernetes.io/component: "{{role}}"
    app.kubernetes.io/managed-by: toolup
spec:
  replicas: {{replicas}}
  selector:
    matchLabels:
      app.kubernetes.io/name: "{{slug}}"
      app.kubernetes.io/component: "{{role}}"
  template:
    metadata:
      labels:
        app.kubernetes.io/name: "{{slug}}"
        app.kubernetes.io/instance: "{{slug}}"
        app.kubernetes.io/component: "{{role}}"
        app.kubernetes.io/managed-by: toolup
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
      containers:
        - name: app
          image: "{{image}}"
          ports:
            - name: http
              containerPort: {{container-port}}
          env:
            - name: TOOLUP_PROCESS_PROFILE
              value: "{{profile}}"
            - name: ASPNETCORE_URLS
              value: "http://+:{{container-port}}"
{{secret-env}}
          livenessProbe:
            httpGet:
              path: "{{liveness-path}}"
              port: {{probe-port}}
            initialDelaySeconds: {{initial-delay}}
            periodSeconds: {{period}}
            timeoutSeconds: {{liveness-timeout}}
          readinessProbe:
            httpGet:
              path: "{{readiness-path}}"
              port: {{probe-port}}
            initialDelaySeconds: {{initial-delay}}
            periodSeconds: {{period}}
            timeoutSeconds: {{readiness-timeout}}
