# Generated by `toolup k8s emit --format helm` — do not hand-edit; re-run
# the command. Only the knobs an install genuinely re-decides live here:
# the image coordinates, the per-role replica counts, and the name of the
# Secret the operator populates. Everything else in the chart is a deploy
# manifest fact and is emitted literally.
image:
  repository: "{{image-repository}}"
  tag: "{{image-tag}}"
secrets:
  # The emitter never writes secret material: the deploy manifest carries
  # only the intent (a name and a source). Create this Secret out of band
  # with one key per `secrets[].name` entry in the manifest.
  name: "{{secret-name}}"
replicas:
{{replica-block}}
