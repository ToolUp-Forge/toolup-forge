<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);data\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Server.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ToolUp.Platform.Core" />
    <PackageReference Include="ToolUp.Platform.Server" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Giraffe" />
    <PackageReference Include="Fable.Remoting.Giraffe" />
    <PackageReference Include="Fable.Remoting.Json" />
  </ItemGroup>
</Project>
