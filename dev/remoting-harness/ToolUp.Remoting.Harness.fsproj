<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Private dev harness for the ToolUp.Remoting Phase 69 / 69a / 69b /
    69c–69k work. NOT in ToolUp.Forge.sln. NOT packed. See README.md for
    the rationale.

    Opts out of forge's central package management
    (`toolup-forge/Directory.Packages.props`) so the harness's dev-only
    deps (TestHost, Expecto, etc.) don't pollute the SDK's CPM ledger.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>ToolUp.Remoting.Harness</RootNamespace>
  </PropertyGroup>

  <!--
    Compile order: Shared (the API record) -> Server (boot + handlers) ->
    Tests (Expecto suite) -> Program (entry point). F# evaluation is
    top-down within an fsproj; later files see earlier ones.
  -->
  <ItemGroup>
    <Compile Include="Shared.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!--
    Hosting + Giraffe runtime surface. ASP.NET Core lives in the shared
    framework; AddTestHost ships a transport stub for in-memory server
    consumption.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    ProjectReferences to the Fable.Remoting fork sibling — the
    stj-json-converter-port branch's verified work. At Phase 69 ship,
    the sibling renames to `toolup-remoting/` and these paths sweep
    to `..\..\..\toolup-remoting\ToolUp.Remoting.<X>\...`.

    Note: Fable.Remoting fsprojs target net8.0; this harness targets
    net10.0. A net10.0 app consuming net8.0 libraries is a supported
    .NET cross-version pairing.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Fable.Remoting\Fable.Remoting.Server\Fable.Remoting.Server.fsproj" />
    <ProjectReference Include="..\..\..\Fable.Remoting\Fable.Remoting.Json\Fable.Remoting.Json.fsproj" />
    <ProjectReference Include="..\..\..\Fable.Remoting\Fable.Remoting.Giraffe\Fable.Remoting.Giraffe.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="Giraffe" Version="8.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Expecto" Version="10.2.3" />
  </ItemGroup>

</Project>
