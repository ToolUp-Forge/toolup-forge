<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Private dev harness for the ToolUp.Remoting Phase 69 / 69a / 69b /
    69c–69k work. NOT in ToolUp.Forge.sln. NOT packed. See README.md for
    the rationale.

    Opts out of forge's central package management
    (`toolup-forge/Directory.Packages.props`) so the harness's dev-only
    deps (TestHost, Expecto, etc.) don't pollute the SDK's CPM ledger.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>ToolUp.Remoting.Harness</RootNamespace>
  </PropertyGroup>

  <!--
    Compile order: Shared (the API record) -> Server (boot + handlers) ->
    Tests (Expecto suite) -> Program (entry point). F# evaluation is
    top-down within an fsproj; later files see earlier ones.
  -->
  <ItemGroup>
    <Compile Include="Shared.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!--
    Hosting + Giraffe runtime surface. ASP.NET Core lives in the shared
    framework; AddTestHost ships a transport stub for in-memory server
    consumption.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    0.4.4 — ToolUp.Remoting.{Server,Json,Giraffe} were folded into
    ToolUp.Platform.{Core,Server}. The harness PackageReferences are
    replaced with ProjectReferences to the folded source so the
    Expecto suite stays a live regression check on the wire shape:
    any future edit to Server/Remoting/ in Platform.Server breaks
    the harness in the same `dotnet build` pass.

    Pre-fold lineage (kept as a comment for the next archaeologist):
    Phase 69 ship onward, this harness consumed via PackageReferences
    to ToolUp.Remoting.* 0.1.x from ../../../local-nuget-feed/.
    Before Phase 69, it consumed via ProjectReferences to the
    Fable.Remoting fork sibling. With 0.4.4 the source lives inside
    this repo, so ProjectReferences are the natural shape again.

    Namespaces ToolUp.Remoting.Server / .Json / .Giraffe are preserved
    across the folded files, so the harness's `open ToolUp.Remoting.Server`
    / `.Json` / `.Giraffe` sites compile unchanged.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    <ProjectReference Include="..\..\src\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="Giraffe" Version="8.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Expecto" Version="10.2.3" />
  </ItemGroup>

</Project>
