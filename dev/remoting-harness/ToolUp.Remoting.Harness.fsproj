<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Private dev harness for the ToolUp.Remoting Phase 69 / 69a / 69b /
    69c–69k work. NOT in ToolUp.Forge.sln. NOT packed. See README.md for
    the rationale.

    Opts out of forge's central package management
    (`toolup-forge/Directory.Packages.props`) so the harness's dev-only
    deps (TestHost, Expecto, etc.) don't pollute the SDK's CPM ledger.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>ToolUp.Remoting.Harness</RootNamespace>
  </PropertyGroup>

  <!--
    Compile order: Shared (the API record) -> Server (boot + handlers) ->
    Tests (Expecto suite) -> Program (entry point). F# evaluation is
    top-down within an fsproj; later files see earlier ones.
  -->
  <ItemGroup>
    <Compile Include="Shared.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!--
    Hosting + Giraffe runtime surface. ASP.NET Core lives in the shared
    framework; AddTestHost ships a transport stub for in-memory server
    consumption.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    PackageReferences to ToolUp.Remoting v0.1.0 (Phase 69 ship). Resolved
    from `../local-nuget-feed/` via the forge nuget.config (`local` source).
    Before Phase 69 ship the harness consumed via ProjectReferences to the
    Fable.Remoting fork sibling; post-Phase-69 the harness is the canonical
    production-shape consumer of the ToolUp.Remoting package family.
  -->
  <ItemGroup>
    <PackageReference Include="ToolUp.Remoting.Server" Version="0.1.3" />
    <PackageReference Include="ToolUp.Remoting.Json" Version="0.1.3" />
    <PackageReference Include="ToolUp.Remoting.Giraffe" Version="0.1.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="Giraffe" Version="8.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Expecto" Version="10.2.3" />
  </ItemGroup>

</Project>
