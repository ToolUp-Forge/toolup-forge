<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 663 - corpus-driven calibration of the Tier-3 fast-path triage
       tier. Consumes the resolver's pure decision path; modifies nothing in
       it. See README.md for the case-file and result-file schemas. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>ToolUp.TriageCalibration</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Calibration.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolUp.AI.Server\ToolUp.AI.Server.fsproj" />
    <ProjectReference Include="..\..\src\AIProviders\Claude\ClaudeAIProvider.fsproj" />
    <ProjectReference Include="..\..\src\AIProviders\OpenAI\OpenAIProvider.fsproj" />
    <ProjectReference Include="..\..\src\AIProviders\Gemini\Gemini.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
