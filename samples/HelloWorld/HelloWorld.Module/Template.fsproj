<?xml version="1.0" encoding="utf-8"?>
<!--
    Template module — the absolute minimum a new module needs.

    Copy this folder, rename `Template` to your module name, update
    `SharedTypes.fs` / `Server.fs` / `ClientModel.fs` / `ClientView.fs`
    with your domain logic, then add the project to:

      - `ToolUpApplication.sln` (so the platform builds it)
      - The reference server's fsproj (`<ProjectReference>`)
      - The reference client's fsproj (`<Import Project="<your>.Client.props" />`)
      - The reference Server.fs's `allModules` list (with `ServerModule.create + with*`)
      - The reference Client.fs's `modules` list (`Template.View.register ()`)

    The structure mirrors the four-file convention: SharedTypes (cross-cut),
    Server (compiled into the server project), ClientModel + ClientView
    (injected into the client project via `Template.Client.props`).
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Modules are App-tier domain code, not SDK companions; not NuGet-packaged. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="SharedTypes.fs" />
        <Compile Include="Server.fs" />
<None Include="ClientModel.fs" />
        <None Include="Icons.fs" />
        <None Include="ClientView.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
    </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
