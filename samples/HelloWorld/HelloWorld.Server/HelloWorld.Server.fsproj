<?xml version="1.0" encoding="utf-8"?>
<!--
    HelloWorld composition root. Authenticated single-user deployment
    using the canonical `Surfaces.individual` shape via
    `ServerConfigOverrides.referenceApp`. Compare with
    samples/MinimalApp/src/MinimalApp.Server/Server.fs — same fromEnv
    shape but `referenceApp`'s default `Some Surfaces.individual` pins
    this app to the Individual deployment unless the operator
    overrides via `TOOLUP_PLATFORM_SURFACES`.

    The sibling `HelloWorld.Module` project demonstrates the
    minimum four-file module shape; this Server registers it via
    `ServerModule.create` so the consumer-side wiring pattern is
    visible end-to-end in one place.
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Server.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\src\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\..\..\src\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\HelloWorld.Module\HelloWorld.Module.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>
