<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 115 worked sample - multi-host public rendering. One
    process serves three markdown-file-backed websites (the default
    site plus two satellites registered via `withSite`), matched on
    the request's Host header. SSR-only: no Fable client, no AI, no
    modules. Sample uses ports 13950-13959 (samples band - see
    ../CLAUDE.md).
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Layouts\SharedLayout.fs" />
        <Compile Include="Layouts\SiteBLayout.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\..\src\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
        <ProjectReference Include="..\..\src\ToolUp.PublicRendering\ToolUp.PublicRendering.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Giraffe.ViewEngine" />
    </ItemGroup>
    <!-- Copy the three content trees next to the binary so the
         `ContentRoot` paths resolve via AppContext.BaseDirectory. -->
    <ItemGroup>
        <None Include="content\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
