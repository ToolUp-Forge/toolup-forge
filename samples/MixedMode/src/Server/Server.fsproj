<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 66 Stream F.5 — MixedMode worked example, server side.
    Composes against the canonical Surfaces = [anonymous; team;
    claimBearer] shape and demonstrates per-module
    DefaultSurfaceRequirement declarations.

    Out of the main .sln by design — samples ship per-sample slns
    (mirroring PrerenderApp / MinimalApp). Build via:
        dotnet build samples/MixedMode/MixedMode.sln
-->
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Server.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\src\ToolUp.Platform.Core\ToolUp.Platform.Core.fsproj" />
        <ProjectReference Include="..\..\..\..\src\ToolUp.Platform.Server\ToolUp.Platform.Server.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>
</Project>
